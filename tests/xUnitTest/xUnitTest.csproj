<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <!-- Concurrent compilations in one test process: one heap per core, without dynamic heap-count adaptation, and a
         64 MB gen0 budget per heap instead of the 200 MB default, under which the heap balloons and every test slows. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="67108864" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Markdig" Version="1.3.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kimi\Kimi.csproj" />
    <Compile Include="..\Workloads\AssociatedInferenceWorkloads.cs" Link="Workloads\AssociatedInferenceWorkloads.cs" />
    <Compile Include="..\Workloads\VerificationWorkloads.cs" Link="Workloads\VerificationWorkloads.cs" />
    <Compile Include="..\Workloads\OriginProofWorkloads.cs" Link="Workloads\OriginProofWorkloads.cs" />
    <Compile Include="..\Workloads\HoverWorkloads.cs" Link="Workloads\HoverWorkloads.cs" />
    <Compile Include="..\Workloads\ConstructorInferenceWorkloads.cs" Link="Workloads\ConstructorInferenceWorkloads.cs" />
    <Compile Include="..\Workloads\AdaptationWorkloads.cs" Link="Workloads\AdaptationWorkloads.cs" />
    <Compile Include="..\Workloads\ArithmeticWorkloads.cs" Link="Workloads\ArithmeticWorkloads.cs" />
    <EmbeddedResource Include="TestData\DocumentationMarkdown\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="..\..\src\stylecop.json" Link="stylecop.json" />
  </ItemGroup>

</Project>
