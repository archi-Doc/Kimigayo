func select(flag: bool, n: i32) -> i32
    let a = if n > 1 => 1 else if flag => 2 else => 3
    if flag
        return a
    let b = label outer: if flag
        if n > 0 => yield to outer 4
        yield 5
    else => 6
    return a + b
func iterate(n: i32) -> i32
    var total: i32 = 0
    label rows: loop
        var i: i32 = 0
        while i < n
            i = i + 1
            if i == 2 => continue to rows
            if i == 5 => exit to rows
        total = total + 1
    let found = loop => exit total
    return found
func statements(flag: bool, text: string) -> i32
    let d = label work: do
        if flag => exit to work 1
        exit to work 2
    require flag else
        let y = d
        return y
    unsafe
        var buffer: [2 of i32] = noinit
        buffer[0] = d
    _ = text@move
    return d
func spin() -> i32
    loop
        let x = 1
    return 0
func short(flag: bool) -> bool => flag and (return false)
func deadTail(c: bool)
    var x: i32
    if c
        x = 1
        return
    else
        x = 2
        return
    Console.writeLine("dead")
