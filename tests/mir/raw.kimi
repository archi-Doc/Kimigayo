struct Point
    public var x: i32
    public var y: i32
    public init(x: i32, y: i32)
        self.x = x
        self.y = y
func addresses(point: uniq/Point) -> i32
    let p = point@follow@raw
    unsafe
        (*p).x = 1
        let second = p[1].y
        let field = (*p).y@raw
        return *field + second
