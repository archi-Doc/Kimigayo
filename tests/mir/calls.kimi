struct Counter
    var count: i32
    public init() => self.count = 0
    public func bump(self: uniq/Self, by: i32) => self.count = self.count + by
    public func read(self) -> i32 => self.count
    public computed doubled: i32
        get() -> i32 => self.count * 2
        set(value: i32) -> () => self.count = value / 2

func methods(counter: uniq/Counter, owned: Counter) -> i32
    counter.bump(2)
    counter.doubled = 8
    var local = owned@move
    local.bump(1)
    return counter.read() + local.doubled
func same<T>(a: T, b: T) -> bool
    T is Equatable
    return a == b
func apply<F>(action: ref/F) -> i32
    F is Callable<ref, () -> i32>
    return action()
func first(values: ref/[3 of i32]) -> ref/i32 during values => values[0]@ref
func read(values: ref/[3 of i32]) -> i32 => first(values)
func stop() -> Never => $abort("stopped")
struct Pair
    Self is UniqIndexable<isize>
    associate Element is i32
    var first: i32 = 1
    public init() => ()
    public func index(self, key: ref/isize) -> ref/i32 during self => self.first@ref
    public func indexUniq(self: uniq/Self, key: ref/isize) -> uniq/i32 during self => self.first@uniq
func indexed(pair: uniq/Pair) -> i32
    pair[0]
    pair[0] += 1
    return pair[0]
func take(target: uniq/i32, by: i32) => ()
func see(target: ref/i32, by: i32) -> i32 => by
func chosen(flag: bool, n: i32) -> i32
    var a: i32 = 1
    var b: i32 = 2
    take(if flag => a@uniq else => b@uniq, n)
    take((match flag
        true => a@uniq
        false => b@uniq
    ), n)
    _ = Kimi.Intrinsics.replace(if flag => a@uniq else => b@uniq, with: n)
    return a + b
func exited(flag: bool, n: i32) -> i32
    var a: i32 = 1
    var b: i32 = 2
    take((label s: do
        if flag => exit to s a@uniq
        exit to s b@uniq
    ), n)
    take(do => if flag => a@uniq else => b@uniq, n)
    take((label l: if flag
        yield to l a@uniq
    else => b@uniq
    ), n)
    return a + b
func half(value: uniq/i32) -> Option<uniq/i32 during value> => .Some(value@move)
func tried(n: i32) -> Option<i32>
    var a: i32 = 1
    take(try half(a@uniq), n)
    return .Some(a)
func received(flag: bool) -> i32
    var c = Counter.init()
    var d = Counter.init()
    (if flag => c@uniq else => d@uniq).bump(1)
    return c.read() + d.read()
func called(flag: bool) -> i32
    var n: i32 = 1
    var f = func [var n] () -> i32 => n
    return (if flag => f@uniq else => f@uniq)()
func shared(flag: bool, n: i32) -> i32
    let a: i32 = 1
    let b: i32 = 2
    return see(if flag => a@ref else => b@ref, n)
