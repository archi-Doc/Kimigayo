struct Grid<length N>
    public var cells: [N of i32] = [N of 7]
    public init() => ()
func fill(a: i32) -> i32
    var value
    value = a
    value += 1
    let x = missing
    return x
func kind() -> i32
    let c = '\q'
    return 0
func discarded(a: i32)
    if a > 0
        yield 1
    else
        yield 2
func targetless(a: i32)
    loop
        yield helper(a)
func helper(a: i32) -> i32 => a
