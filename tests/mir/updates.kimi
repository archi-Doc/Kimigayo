struct Meter
    public var level: i32 = 0
    public init() => ()
func counters(meter: uniq/Meter, values: uniq/[3 of i32], i: isize) -> i32
    var count = 0
    let before = count++
    let after = ++count
    meter.level += before
    values[i] -= after
    values[1] = count
    return meter.level--
func divergentReplacement()
    var a: [1 of string] = ["old"]
    a[0] = label work: do
        defer => loop => ()
        exit to work "new"
func divergentReplacementIndex()
    var a: [1 of string] = ["old"]
    a[(label work: do
        defer => loop => ()
        exit to work 0
    )] = "new"
func noncompletingWrite()
    loop
        var text = "old"
        text = (exit)
func updateIndex() -> isize => 0
func updateRight() -> i32 => 2
func orderedUpdate() -> i32
    var a: [1 of i32] = [40]
    a[updateIndex()] += updateRight()
    return a[0]
func wholeLocal()
    var x: i32 = 1
    var y: i32 = 2
    _ = Kimi.Intrinsics.replace(x@uniq, with: 2)
    _ = Kimi.Intrinsics.exchange(x@uniq, with: 2)
    _ = Kimi.Intrinsics.swap(x@uniq, y@uniq)
func wholeBorrowed(x: uniq/i32, y: uniq/i32)
    _ = Kimi.Intrinsics.replace(x, with: 2)
    _ = Kimi.Intrinsics.exchange(x, with: 2)
    _ = Kimi.Intrinsics.swap(x, y)
