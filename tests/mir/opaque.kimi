// A selection through an identity premise whose subject is the Type parameter of its receiver's Place is unsupported (PLAN G168b,
// DECISIONS BU-72; the builder's remaining located Unsupported_Kd). Before PLAN G396 (3)'s B3 it was a call omitting a default over
// Bx^65<i32> (now built); before R7-T1 c4 a tuple operator over such a leaf.
struct Pair
    public var a: i32 = 1
    public init() => ()
func same<T>(s: ref/T) -> i32
    T is (Pair, i32)
    return s.0.a
func fail() -> i32 => missing
func take(a: string, b: string) -> i32 => 1
func kept(n: i32, s: string) -> i32
    _ = n[take(s@move, s@move)]
    return take(s@move, s@move)@follow
func definition()
    _ = func (n: i32)
        let t = "x"
        _ = take(t@move, t@move)
        return n
