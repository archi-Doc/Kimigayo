// A call omitting a default its substitution cannot instantiate (zero<T> over Bx^65<i32>, past Binding's storage bound) is
// unsupported (PD30's (e) row, the builder's B3; DECISIONS R4-M127); before R7-T1 c4 it was a tuple operator over such a leaf.
struct Bx<T>
    public var v: T
func zero<T>() -> i32 => 0
func pick<T>(a: i32, k: i32 = zero<T>()) -> i32 => a + k
func same(a: i32) -> i32 => pick<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<Bx<i32>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>(a)
func fail() -> i32 => missing
func take(a: string, b: string) -> i32 => 1
func kept(n: i32, s: string) -> i32
    _ = n[take(s@move, s@move)]
    return take(s@move, s@move)@follow
func definition()
    _ = func (n: i32)
        let t = "x"
        _ = take(t@move, t@move)
        return n
