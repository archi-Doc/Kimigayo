func log(n: i32) => ()
func make() -> string => "x"
func stop() -> Never
    loop => ()
func cleanup(flag: bool, n: i32, owned: string) -> i32
    let s = make()
    defer => log(1)
    if flag => return 1
    defer
        log(2)
        if flag => exit
        log(3)
    var i: i32 = 0
    while i < n
        let t = make()
        defer => log(4)
        if i == 2 => continue
        if i == 3 => exit
        i = i + 1
    return 0
func divergingDefer(flag: bool) -> i32
    defer => stop()
    if flag => return 1
    return 2
func conditionTemporaries(text: string) -> i32
    if make() == text => return 1
    return 2
