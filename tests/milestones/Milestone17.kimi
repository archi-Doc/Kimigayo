// Milestone 17: partial Move repair, whole-value updates, and result cleanup.
struct Resource
    public let id: i32
    public init(id: i32) => self.id = id
    deinit
        match self.id
            1 => Console.writeLine("Resource 1 destroyed.")
            2 => Console.writeLine("Resource 2 destroyed.")
            3 => Console.writeLine("Resource 3 destroyed.")
            4 => Console.writeLine("Resource 4 destroyed.")
            5 => Console.writeLine("Resource 5 destroyed.")
            _ => $abort("Unexpected resource identity")

func prepare() -> [2 of Resource]
    var items: [2 of Resource] = [Resource.init(1), Resource.init(2)]
    let extracted = items[0]@move // Move the complete Resource, not one of its fields.
    require extracted.id == 1 else => $abort("Partial Move failed")
    items[0] = Resource.init(3) // Restore whole-array completeness.
    do
        let old = Kimi.Intrinsics.exchange(items[1]@uniq, with: Resource.init(4))
        require old.id == 2 and items[1].id == 4 else => $abort("Exchange failed")
        defer => Console.writeLine("Exchange scope finished.")
        // old is destroyed after this scope's defer; exchange did not destroy it.
    Kimi.Intrinsics.swap(items[0]@uniq, items[1]@uniq)
    require items[0].id == 4 and items[1].id == 3 else => $abort("Swap failed")
    Kimi.Intrinsics.replace(items[1]@uniq, with: Resource.init(5))
    require items[1].id == 5 else => $abort("Replacement failed")
    defer => Console.writeLine("Prepared result.")
    return items@move // Secure the array before defer and extracted's destruction.

public func main()
    do
        let result = prepare()
        require result[0].id == 4 and result[1].id == 5 else => $abort("Result transfer failed")
        Console.writeLine("Result received.")
        // Array cleanup destroys element 1 before element 0.
    Console.writeLine("Cleanup finished.")
