// Milestone 26: generic compound captures, external dependencies and owning erasure.
struct Packet
    public let text: string
    public let number: i32
    public init(text: string, number: i32)
        self.text = text@move
        self.number = number
    deinit => Console.writeLine("Packet destroyed.")

func shared<F>(action: ref/F) -> i32
    F is Callable<ref, () -> i32>
    return action()

func inspectTwice<T, F>(value: T, visitor: ref/F) -> i32
    F is Callable<ref, (ref/T) -> i32>
    // T is neither Copy nor Owned by assumption. Move it and retain visitor's borrow.
    let read = func [value@move, visitor] () -> i32 => visitor(value@ref)
    return shared(read@ref) + shared(read@ref)

func advance<F>(action: uniq/F) -> i32
    F is Callable<uniq, () -> i32>
    return action()

func consume<T, F>(action: F) -> T
    F is Callable<owner, () -> T>
    return action@move()

func increment(value: i32) -> i32 => value + 1

public func main()
    let bias: i32 = 4
    let visitor = func [bias@ref] (value: ref/Packet) -> i32 => value.number + bias
    let total = inspectTwice(Packet.init("Captured packet.", 6), visitor@ref)
    require total == 20 and bias == 4 else => $abort("Generic capture failed")
    Console.writeLine("Generic capture total is 20.")

    let pair: (i32, i32) = (2, 3)
    var next = func [var pair] () -> i32
        pair.0 = pair.0 + pair.1
        return pair.0
    require advance(next@uniq) == 5 and advance(next@uniq) == 8 else => $abort("Compound mutation failed")
    require pair.0 == 2 else => $abort("Capture was not a snapshot")
    Console.writeLine("Compound capture advanced to 8.")

    do
        let packet = Packet.init("Consumed packet.", 9)
        let take = func [packet@move] () -> Packet => packet@move
        let received: Packet = consume(take@move)
        require received.number == 9 else => $abort("Consuming call failed")
        Console.writeLine(received.text)
    do
        let packet = Packet.init("Erased packet.", 11)
        let concrete = func [packet@move] () -> i32 => packet.number
        // The shared body and Owned environment permit erasure of a Non-Copy closure.
        let erased: () -> i32 = concrete@move
        let moved = erased@move
        require moved() == 11 and moved() == 11 else => $abort("Erased call failed")
        let item = increment
        let common: (i32) -> i32 = item
        require item(1) == 2 and common(11) == 12 else => $abort("Function item failed")
        Console.writeLine("Erased calls finished.")
    Console.writeLine("General closures finished.")
