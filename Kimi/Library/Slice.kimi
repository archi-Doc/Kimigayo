public struct Slice<T> {source}
    public func iterate(self: Self) -> SliceIterator<T>{source}
        return SliceIterator<T>.init(self)
public struct SliceIterator<T> {source}
    Self is Iterator
    associate Iterator.Element is ref{source}/T
    let values: Slice<T>{source}
    var position: isize = 0
    public init(values?: Slice<T>{source})
        self.values = values
    public func next(self: uniq/Self) -> Option<ref{source}/T>
        require self.position < self.values.length else => return .None
        let index = self.position
        self.position = self.position + 1
        return .Some(self.values[index]@ref/T)
