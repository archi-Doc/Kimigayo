public struct Slice<T> {source}
    public func iterate(self: Self) -> SliceIterator<T> during source
        return SliceIterator<T>.init(self)
    // SPEC 4.6.6: a try-prefixed selection converts only its own bounds failure to None; results retain source, and
    // tryGet has a fixed reference result whatever T's Copy capability.
    public func tryGet(self: Self, index: isize) -> Option<ref/T during source>
        require index >= 0 and index < self.length else => return .None
        return .Some(self[index]@ref/T)
    public func tryGet(self: Self, index: Index) -> Option<ref/T during source>
        match index.tryResolve(self.length)
            .Some(let position)
                require position < self.length else => return .None
                return .Some(self[position]@ref/T)
            .None => return .None
    public func trySlice(self: Self, range: Range) -> Option<Slice<T> during source>
        match range.tryResolve(self.length)
            .Some(let resolved) => return .Some(self[resolved])
            .None => return .None
    public func trySlice(self: Self, range: ResolvedRange) -> Option<Slice<T> during source>
        require range.end <= self.length else => return .None
        return .Some(self[range])
    public func splitAt(self: Self, index: isize) -> (Slice<T> during source, Slice<T> during source)
        return (self[..index], self[index..])
    public func splitAt(self: Self, index: Index) -> (Slice<T> during source, Slice<T> during source)
        return self.splitAt(index.resolve(self.length))
    public func trySplitAt(self: Self, index: isize) -> Option<(Slice<T> during source, Slice<T> during source)>
        require index >= 0 and index <= self.length else => return .None
        return .Some((self[..index], self[index..]))
    public func trySplitAt(self: Self, index: Index) -> Option<(Slice<T> during source, Slice<T> during source)>
        match index.tryResolve(self.length)
            .Some(let position) => return self.trySplitAt(position)
            .None => return .None
public struct SliceIterator<T> {source}
    Self is Iterator
    associate Iterator.Item is ref/T during source
    let values: Slice<T> during source
    var position: isize = 0
    public init(values: Slice<T> during source)
        self.values = values
    public func next(self: uniq/Self) -> Option<ref/T during source>
        require self.position < self.values.length else => return .None
        let index = self.position
        self.position = self.position + 1
        return .Some(self.values[index]@ref/T)
