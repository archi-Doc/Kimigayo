// Private ordered-storage algorithms. The compiler supplies allocation and typed
// acquisition/destruction; this source owns slot links and free-slot reuse.
group DictionaryStorage
    unsafe func shrinkToFit(handle: unsafe/isize, stride: isize, allocate: (isize) -> unsafe/u8, release: (unsafe/u8) -> (), transfer: (unsafe/u8, unsafe/u8, isize) -> ())
        unsafe
            let length = handle[3]
            if handle[2] <= length
                return
            if length == 0
                release(*(handle@unsafe/unsafe/u8))
                initialize(handle)
                return
            // Existing capacity guarantees that length * stride is representable.
            let memory = allocate(length * stride)
            if memory == null
                return
            let old = compact(handle, memory, stride, transfer@move)
            release(old)

    // The caller allocates memory before calling; failure leaves the old handle
    // intact. Transfer does not acquire or destroy entries or call user code.
    unsafe func compact(handle: unsafe/isize, memory: unsafe/u8, stride: isize, transfer: (unsafe/u8, unsafe/u8, isize) -> ()) -> unsafe/u8
        unsafe
            let buffer = *(handle@unsafe/unsafe/u8)
            let length = handle[3]
            var link = handle[4]
            var position: isize = 0
            while link != 0
                let slot = buffer + (link - 1) * stride
                let next = (slot@unsafe/isize)[1]
                let destination = memory + position * stride
                transfer(destination, slot, stride)
                let links = destination@unsafe/isize
                links[0] = position
                position += 1
                if position == length
                    links[1] = 0
                else
                    links[1] = position + 1
                link = next
            *(handle@unsafe/unsafe/u8) = memory
            handle[1] = length
            handle[2] = length
            if length == 0
                handle[4] = 0
            else
                handle[4] = 1
            handle[5] = length
            handle[6] = 0
            return buffer

    unsafe func clear(handle: unsafe/isize, stride: isize, keyOffset: isize, valueOffset: isize, destroyEntry: (unsafe/u8, unsafe/u8) -> ())
        unsafe
            let buffer = *(handle@unsafe/unsafe/u8)
            var link = handle[5]
            while link != 0
                let slot = buffer + (link - 1) * stride
                let previous = *(slot@unsafe/isize)
                destroyEntry(slot + keyOffset, slot + valueOffset)
                link = previous
            clearLinks(handle)

    unsafe func find(handle: unsafe/isize, stride: isize, keyOffset: isize, key: unsafe/u8, equals: (unsafe/u8, unsafe/u8) -> bool) -> isize
        unsafe
            let buffer = *(handle@unsafe/unsafe/u8)
            var link = handle[4]
            while link != 0
                let slot = buffer + (link - 1) * stride
                if equals(slot + keyOffset, key)
                    return link
                link = (slot@unsafe/isize)[1]
            return 0

    // Handle words: buffer, used, capacity, length, head, tail, free.
    // Links are slot index + 1; zero denotes no slot. The caller has already
    // secured capacity for needed entries before appendSlot changes any links.
    unsafe func appendSlot(handle: unsafe/isize, stride: isize, needed: isize) -> unsafe/u8
        unsafe
            let buffer = *(handle@unsafe/unsafe/u8)
            let free = handle[6]
            var index: isize = 0
            if free == 0
                index = handle[1]
                handle[1] = index + 1
            else
                index = free - 1
                let recycled = (buffer + index * stride)@unsafe/isize
                handle[6] = recycled[1]
            let link = index + 1
            let slot = buffer + index * stride
            let links = slot@unsafe/isize
            let tail = handle[5]
            links[0] = tail
            links[1] = 0
            if tail == 0
                handle[4] = link
            else
                let previous = (buffer + (tail - 1) * stride)@unsafe/isize
                previous[1] = link
            handle[5] = link
            handle[3] = needed
            return slot

    unsafe func clearLinks(handle: unsafe/isize)
        unsafe
            handle[1] = 0
            handle[3] = 0
            handle[4] = 0
            handle[5] = 0
            handle[6] = 0

    unsafe func initialize(handle: unsafe/isize)
        unsafe
            *(handle@unsafe/unsafe/u8) = null
            handle[2] = 0
            clearLinks(handle)

    unsafe func unlink(handle: unsafe/isize, stride: isize, link: isize)
        unsafe
            let buffer = *(handle@unsafe/unsafe/u8)
            let slot = (buffer + (link - 1) * stride)@unsafe/isize
            let previous = slot[0]
            let next = slot[1]
            if previous == 0
                handle[4] = next
            else
                let left = (buffer + (previous - 1) * stride)@unsafe/isize
                left[1] = next
            if next == 0
                handle[5] = previous
            else
                let right = (buffer + (next - 1) * stride)@unsafe/isize
                right[0] = previous
            slot[1] = handle[6]
            handle[6] = link
            handle[3] = handle[3] - 1
