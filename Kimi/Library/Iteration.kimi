/// The standard adapters (SPEC 22.1.2.3): an owned or exclusively borrowed LendingIterator becomes an ordinary
/// enumerable value that forwards each item with its actual dependencies, without allocation or advance collection.
public group Iteration
    /// Transfers `iterator` into an adapter that owns it; a Non-Copy Place is written `@move`.
    public func owned<I>(iterator: I) -> Owned<I>
        I is LendingIterator
        return Owned<I>.init(iterator@move)

    /// Adapts an exclusively borrowed iterator; the adapter retains the borrow and advances the iterator in place.
    public func borrowed<I>(iterator: uniq/I during source) -> Borrowed<I> during source
        I is LendingIterator
        return Borrowed<I>.init(iterator)

    /// Owns a LendingIterator and forwards its items; it is an Iterator exactly when `I` is.
    public struct Owned<I>
        I is LendingIterator
        Self is LendingIterator
        associate LendingIterator.LentItem(step) is I.(LendingIterator).LentItem(step)
        Self is IntoIterable
        associate IntoIterable.IteratorType is Self
        Self is UniqIterable
        associate UniqIterable.IteratorType(source) is Borrowed<Self> during source
        var iterator: I

        Self is Iterator when I is Iterator
            associate Iterator.Item is I.(Iterator).Item

        internal init(iterator: I) => self.iterator = iterator@move

        /// Returns the next item of the owned iterator, or None; exhaustion follows `I`.
        public func next(self: uniq/Self during step) -> Option<I.(LendingIterator).LentItem(step)>
            return self.iterator.next()

        /// Enumerates the adapter itself.
        public func intoIterator(self: Self) -> Self => self@move

        /// Enumerates through an exclusive borrow, leaving the remaining items in place.
        public func iterateUniq(self: uniq/Self during source) -> Borrowed<Self> during source
            return borrowed(self)

    /// Exclusively borrows a LendingIterator and forwards its items; it is an Iterator exactly when `I` is.
    public struct Borrowed<I> {source}
        I is LendingIterator
        Self is LendingIterator
        associate LendingIterator.LentItem(step) is I.(LendingIterator).LentItem(step)
        Self is IntoIterable
        associate IntoIterable.IteratorType is Self
        Self is UniqIterable
        associate UniqIterable.IteratorType(inner) is Borrowed<Self> during inner
        var iterator: uniq/I during source

        Self is Iterator when I is Iterator
            associate Iterator.Item is I.(Iterator).Item

        internal init(iterator: uniq/I during source) => self.iterator = iterator@move

        /// Returns the next item of the borrowed iterator, or None; each item's `step` is this call's Reborrow.
        public func next(self: uniq/Self during step) -> Option<I.(LendingIterator).LentItem(step)>
            return self.iterator.next()

        /// Enumerates the adapter itself.
        public func intoIterator(self: Self) -> Self => self@move

        /// Enumerates through a further exclusive borrow.
        public func iterateUniq(self: uniq/Self during inner) -> Borrowed<Self> during inner
            return borrowed(self)
