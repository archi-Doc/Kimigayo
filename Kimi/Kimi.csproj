<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>Kimigayo</PackageId>
    <Authors>archi-Doc</Authors>
    <Product>Kimigayo</Product>
    <Description>Work in Process</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/archi-Doc/Kimigayo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/archi-Doc/Kimigayo</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="KimigayoVersion" Value="$(Version)" />
    <None Remove="Misc\Language\strings-en.tinyhand" />
    <None Remove="Misc\Language\strings-ja.tinyhand" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Generated\*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Diagnostics\DiagnosticCode.tinyhand" />
    <EmbeddedResource Include="Compiler\Emission\WindowsRuntime.ll.in" />
    <EmbeddedResource Include="..\backend\windows-x64\profile.json" LogicalName="Kimi.WindowsBackendProfile.json" />
    <EmbeddedResource Include="..\backend\windows-x64\kernel32.def" LogicalName="Kimi.Kernel32.def" />
    <EmbeddedResource Include="Misc\Language\strings-en.tinyhand" />
    <EmbeddedResource Include="Misc\Language\strings-ja.tinyhand" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Arc.Collections" Version="2.0.0" />
    <PackageReference Include="Arc.Threading" Version="0.54.0" />
    <PackageReference Include="Arc.Unit" Version="0.48.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="SimpleCommandLine" Version="0.47.0" />
    <PackageReference Include="SimplePrompt" Version="0.28.0" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Tinyhand" Version="0.147.0" />
    <PackageReference Include="ValueLink" Version="0.121.0" />
  </ItemGroup>

</Project>
