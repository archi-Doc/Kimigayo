  InvalidNumericLiteral="Invalid numeric literal"
  MissingBlockCommentEnd="Reached end-of-file. Missing '*/'"
  MissingStringLiteralEnd="String literal is not terminated. Expected closing \""
  TokenMismatch="The token does not match the expected token. Expected: {0}"
