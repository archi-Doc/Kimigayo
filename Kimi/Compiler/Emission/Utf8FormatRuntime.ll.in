  call void @__kimi_format_integer(ptr %ret, ptr %self, i128 %wide3, i1 true, ptr %location, i64 %location_length)
  ret void
integer4:
  %n4 = load i16, ptr %value, align 2
  %wide4 = zext i16 %n4 to i128
  call void @__kimi_format_integer(ptr %ret, ptr %self, i128 %wide4, i1 false, ptr %location, i64 %location_length)
  ret void
integer5:
  %n5 = load i32, ptr %value, align 4
  %wide5 = sext i32 %n5 to i128
  call void @__kimi_format_integer(ptr %ret, ptr %self, i128 %wide5, i1 true, ptr %location, i64 %location_length)
  ret void
integer6:
  %n6 = load i32, ptr %value, align 4
  %wide6 = zext i32 %n6 to i128
  call void @__kimi_format_integer(ptr %ret, ptr %self, i128 %wide6, i1 false, ptr %location, i64 %location_length)
  ret void
integer7:
  %n7 = load i64, ptr %value, align 8
  %wide7 = sext i64 %n7 to i128
  call void @__kimi_format_integer(ptr %ret, ptr %self, i128 %wide7, i1 true, ptr %location, i64 %location_length)
  ret void
integer8:
  %n8 = load i64, ptr %value, align 8
  %wide8 = zext i64 %n8 to i128
  call void @__kimi_format_integer(ptr %ret, ptr %self, i128 %wide8, i1 false, ptr %location, i64 %location_length)
  ret void
integer9:
  %n9 = load i128, ptr %value, align 8
  call void @__kimi_format_integer(ptr %ret, ptr %self, i128 %n9, i1 true, ptr %location, i64 %location_length)
  ret void
integer10:
  %n10 = load i128, ptr %value, align 8
  call void @__kimi_format_integer(ptr %ret, ptr %self, i128 %n10, i1 false, ptr %location, i64 %location_length)
  ret void
floating:
  %narrow = icmp eq i32 %kind, 11
  call void @__kimi_format_float(ptr %ret, ptr %value, ptr %self, i1 %narrow, ptr %location, i64 %location_length)
  ret void
character:
  %c = load i32, ptr %value, align 4
  call void @__kimi_format_character(ptr %ret, ptr %self, i32 %c, ptr %location, i64 %location_length)
  ret void
boolean:
  %b = load i8, ptr %value, align 1
  %yes = icmp ne i8 %b, 0
  %text = select i1 %yes, ptr @__kimi_utf8_true, ptr @__kimi_utf8_false
  %size = select i1 %yes, i64 4, i64 5
  call void @__kimi_format_bytes(ptr %ret, ptr %self, ptr %text, i64 %size, ptr %location, i64 %location_length)
  ret void
unit:
  call void @__kimi_format_bytes(ptr %ret, ptr %self, ptr @__kimi_utf8_unit, i64 2, ptr %location, i64 %location_length)
  ret void
bytes:
  %data = load ptr, ptr %value, align 8
  %lengthp = getelementptr i8, ptr %value, i64 8
  %length = load i64, ptr %lengthp, align 8
  call void @__kimi_format_bytes(ptr %ret, ptr %self, ptr %data, i64 %length, ptr %location, i64 %location_length)
  ret void
invalid:
  unreachable
}
