// To create diagnostic information, follow the Template format, add it below, and add the corresponding entry to the KimiDiagnostic enum.

  + Name="Template_Kd"
    Severity="Error"
    Message="The primary diagnostic message"
    Label="A short label describing the relevant code"
    Fix="A suggested fix for the diagnostic"
    Note="Additional information about the diagnostic"

  + Name="ConditionMustBeBool_Kd"
    Message="The condition expression must be of type Bool"

  + Name="UnresolvedBinding_Kd"
    Message="Required Name or Type information remains unresolved after final Binding"

  + Name="AmbiguousBinding_Kd"
    Message="More than one declaration or operation remains applicable"

  + Name="DuplicateBinding_Kd"
    Message="A declaration with the same Name or normalized Signature already exists in this scope"

  + Name="NotCallable_Kd"
    Message="The selected value is not callable; lookup does not fall back to an outer function"

  + Name="NoApplicableOverload_Kd"
    Message="No unique applicable overload can be established from the supplied arguments"

  + Name="CyclicBinding_Kd"
    Message="A cyclic dependency prevents Type inference"

  + Name="InvalidAssignment_Kd"
    Message="The selected target does not permit assignment"

  + Name="InaccessibleBinding_Kd"
    Message="The selected declaration is inaccessible in this context"

  + Name="InvalidCaptureBinding_Kd"
    Message="A runtime binding cannot cross this function boundary without a permitted capture"

  + Name="UnsupportedBinding_Kd"
    Message="The semantic obligations of this syntax are not yet implemented and cannot pass final Binding"

  + Name="InvalidOriginBinding_Kd"
    Message="The Origin name, mapping, or annotation is invalid in this type position"

  + Name="MissingOriginBinding_Kd"
    Message="This Origin must be explicitly bound or resolved by the position's omission rules"

  + Name="InvalidTypeFormation_Kd"
    Message="The resolved declaration or Semantics target cannot form this type"

  + Name="InvalidConstraint_Kd"
    Message="The Constraint contains an invalid subject, requirement, or contradictory evidence"

  + Name="UnprovenConstraint_Kd"
    Message="The required Constraint cannot be proven by its semantic deadline"

  + Name="UnsatisfiedConstraint_Kd"
    Message="The supplied Type arguments do not satisfy the declaration's Constraints"

  + Name="InvalidCoreIntrinsics_Kd"
    Message="The compiler-owned Core requirement declarations are missing, duplicated, or incompatible"

  + Name="MissingContractImplementation_Kd"
    Message="No implementation matches the Contract requirement after Type substitution"

  + Name="IncompatibleContractImplementation_Kd"
    Message="The identified implementation does not satisfy the Contract's constraints, Origins, result, or access contract"

  + Name="InvalidAssociatedType_Kd"
    Message="The associated Type has an ambiguous, missing, contradictory, or invalid Core-Type binding"

  + Name="InvalidCompileTimeCondition_Kd"
    Message="This expression is outside the compile-time Condition grammar (integer literals must fit i64)"

  + Name="InvalidCompileTimeSetting_Kd"
    Message="Invalid compile-time setting '{0}': use a non-reserved Name and exactly one Bool, Integer, or String value"

  + Name="UnknownCompileTimeName_Kd"
    Message="Unknown compile-time environment Name '{0}'"
    Fix="Use a built-in Compilation value or configure a Project setting before parsing"

  + Name="UnsupportedLanguageVersion_Kd"
    Message="Unsupported language version '{0}'; this compiler supports '{1}'"

  + Name="ChainedComparison_Kd"
    Message="Comparison operators cannot be chained without parentheses"
    Label="This comparison requires explicit grouping"
    Fix="Use parentheses for a nested comparison, or combine separate comparisons with and"

  + Name="EmptyExecutableBlock_Kd"
    Message="An executable Block requires at least one Syntax item"
    Fix="Indent the intended body, or write () to explicitly do nothing"

  + Name="BlockStatementInExpression_Kd"
    Message="Unsafe and Deferred Blocks are statements and cannot be used as expressions"

  + Name="InvalidInlineStatement_Kd"
    Message="An inline body requires one complete statement on the same line, without a following Block"

  + Name="SemicolonNotAllowed_Kd"
    Message="Semicolons are not allowed"
    Fix="Remove the semicolon, or use a newline to separate syntax items"

  + Name="CompileTimeCaseFallbackMustBeLast_Kd"
    Message="#case _ must be the final arm in a Case Group"

  + Name="CompileTimeCaseOutsideSwitch_Kd"
    Message="#case must be a direct arm of a #switch body"

  + Name="EmptyCompileTimeSwitch_Kd"
    Message="#switch requires an indented body containing at least one #case arm"

  + Name="InvalidCompileTimeSwitchItem_Kd"
    Message="A #switch body may contain only #case arms, blank lines, and comments"

  + Name="DuplicateCompileTimeCaseFallback_Kd"
    Message="A Case Group may contain at most one #case _ arm"

  + Name="DeclarationOrderWarning_Kd"
    Severity="Warning"
    Message="Declarations should appear in this order: type constraints, Properties, functions"

  // Reserved for required constant evaluation, not runtime arithmetic Abort.
  + Name="DivisionByZero_Kd"
    Message="Cannot divide by zero"

  + Name="DuplicateModifier_Kd"
    Message="Duplicate modifier '{0}'"

  + Name="DuplicatePropertyAccessor_Kd"
    Message="A Property may declare the '{0}' accessor at most once"

  + Name="DuplicateTypeConstraintDefinition_Kd"
    Message="Type constraints for this struct are already defined in another declaration"

  + Name="IdentifierExpected_Kd"
    Message="Identifier expected"

  + Name="IncompleteEscape_Kd"
    Message="The string ends with an incomplete escape sequence"

  + Name="IncompleteSyntax_Kd"
    Message="The syntax is incomplete"

  + Name="MissingReturnType_Kd"
    Message="A return type is required after '->'. Specify a type such as '()' or 'i32', or remove '->' to omit the return type annotation."
    Label="Missing return type after this arrow"

  + Name="IndentationLevelMismatch_Kd"
    Message="The indentation level does not match the expected level"

  + Name="IndentationLevelMismatchWarning_Kd"
    Severity="Warning"
    Message="The indentation level does not match the expected level"

  + Name="InvalidAttributeKoto_Kd"
    Message="An attribute must be in the form #Attribute or #Attribute(arguments)"

  + Name="InvalidCharacter_Kd"
    Message="Unexpected character '{0}'"

  + Name="InvalidCharLiteral_Kd"
    Message="A char literal must contain exactly one Unicode scalar value; quotes, backslashes, controls, and line separators must be escaped"

  + Name="InvalidSourceEncoding_Kd"
    Message="Source text must be valid Unicode encoded as UTF-8"

  + Name="MissingCharLiteralEnd_Kd"
    Message="Char literal is not terminated on the same line. Expected closing '"

  + Name="InvalidCharacterAtEndOfFile_Kd"
    Message="Invalid character at end of file"

  + Name="InvalidIdentifier_Kd"
    Message="'{0}' is not a valid identifier"
    Fix="Use an NFC name with valid identifier characters and no Unicode Format (Cf) characters"

  + Name="InvalidIndentation_Kd"
    Message="Invalid indentation. Insert {0} spaces for each indentation level"

  + Name="InvalidNumericLiteral_Kd"
    Message="Invalid numeric literal"

  + Name="InvalidReferenceSyntax_Kd"
    Message="Reference form &{0} is invalid"

  + Name="InvalidSemanticsConstraint_Kd"
    Message="'{0}' is not a valid semantics constraint"

  + Name="InvalidUnicodeEscape_Kd"
    Message="The Unicode escape sequence must have the form '\\u(...)' and contain one to six hexadecimal digits"

  + Name="InvalidUnicodeScalar_Kd"
    Message="The Unicode escape sequence does not represent a valid Unicode scalar value"

  + Name="IntegerOverflow_Kd"
    Message="The integer operation exceeds the supported range"

  + Name="LetPropertyCannotHaveSetter_Kd"
    Message="A let Property cannot declare a setter"

  + Name="MissingBlockCommentEnd_Kd"
    Message="Reached end-of-file. Missing '*/'"

  + Name="CodeAfterMultilineComment_Kd"
    Message="Code cannot follow a multiline block comment's closing delimiter on the same physical line"
    Fix="Move the code to the next line and use ordinary indentation"

  + Name="MissingComma_Kd"
    Message="A comma is required to separate syntax elements"

  + Name="MissingExpectedToken_Kd"
    Message="Expected: {0}, but reached the end of line."

  + Name="MissingStringLiteralEnd_Kd"
    Message="String literal is not terminated. Expected closing \""

  + Name="MultipleAccessibilityModifiers_Kd"
    Message="Only one accessibility modifier is allowed"

  + Name="NonExhaustiveCompileTimeCase_Kd"
    Message="No compile-time Case Group arm matches and no fallback arm is present"

  + Name="TokenMismatch_Kd"
    Message="The token does not match the expected token. Expected: {0}"

  + Name="TopLevelKeywordAfterCode_Kd"
    Message="Top-level keywords such as 'alias' must appear before any other code"
    Fix="Move this top-level keyword before all other code"

  + Name="TypeMismatch_Kd"
    Message="Values must be of the same type"

  + Name="ControlFlow_Kd"
    Message="{0}"

  + Name="UnexpectedIndent_Kd"
    Message="Unexpected indentation"

  + Name="UnexpectedToken_Kd"
    Message="Token {0} is not expected at this position"

  + Name="UnexpectedTrailingToken_Kd"
    Message="Unexpected token at the end of the statement"

  + Name="UnmatchedEndBlock_Kd"
    Message="Unmatched end block"

  + Name="UnmatchedAngleBracket_Kd"
    Message="Unmatched angle bracket"

  + Name="UnmatchedBrace_Kd"
    Message="Unmatched brace"

  + Name="UnmatchedBracket_Kd"
    Message="Unmatched bracket"

  + Name="UnmatchedParenthesis_Kd"
    Message="Unmatched parenthesis"

  + Name="UnmatchedToken_Kd"
    Message="Unmatched token {0}"

  + Name="UnsupportedCompileTimeConditionType_Kd"
    Message="This type is not supported in a compile-time condition expression"

  + Name="UnsupportedEscape_Kd"
    Message="The escape sequence '{0}' is not supported"

  + Name="MissingStartupBody_Kd"
    Message="An Application requires one top-level runtime body or one source-root public main"

  + Name="MixedStartupBodies_Kd"
    Message="Top-level runtime items and source-root public main cannot coexist in an Application"

  + Name="MultipleStartupSources_Kd"
    Message="Top-level runtime items must belong to one SourceDocument"

  + Name="MultipleStartupMains_Kd"
    Message="An Application cannot declare more than one source-root public main"

  + Name="InvalidStartupMain_Kd"
    Message="Startup main must be a safe, bodyful, non-imported public function with no parameters, generics, Origins or constraints, returning Unit"

  + Name="LibraryRuntimeBody_Kd"
    Message="A Library cannot contain top-level runtime items"

  + Name="UninitializedPlace_Kd"
    Message="This use requires an initialized value on every incoming path"

  + Name="MovedPlace_Kd"
    Message="This value may have been moved on an incoming path"

  + Name="ReassignedLet_Kd"
    Message="This let binding may already have completed its first initialization"

  + Name="UnsupportedOwnership_Kd"
    Message="This operation requires ownership or cleanup analysis outside the implemented subset"

  + Name="DeferredExpansionLimit_Kd"
    Message="Deferred cleanup expansion exceeds the implementation limit of 8192 ownership operations per function"

  + Name="InvalidPattern_Kd"
    Message="The Pattern is not valid for this matched Type, Case, or payload arity"

  + Name="NonExhaustiveMatch_Kd"
    Message="{0}"

  + Name="UnreachablePattern_Kd"
    Severity="Warning"
    Message="This Pattern is covered by earlier unguarded arm {0}"

  + Name="ControlFlowWarning_Kd"
    Severity="Warning"
    Message="{0}"

  + Name="OuterCloserInBody_Kd"
    Message="An outer closing delimiter cannot close an indented body on the same line"
    Fix="Dedent on the next effective line before writing the closing delimiter"

  + Name="GenerationFailed_Kd"
    Message="LLVM artifact generation failed: {0}"
