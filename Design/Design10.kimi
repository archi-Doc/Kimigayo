public struct Array<s/T>
    Self is all
    s is owning
    T is Comparable

    // Index and Range endpoints are nonnegative isize values.
    // ^n resolves to count - n. ^0 is a valid Range boundary but not an element Index.
    var count: isize
    var capacity: isize
    var buffer: ptr

