            return

        var st = TestStruct.New()
        var st2 = Arc.New(st) // &owner Arc<TestStruct> // TそのものはThread-traversalではない
        /*_ = Task.Run(async () -> // Closure -> Block. Require reference analysis
            var i = 0
            i++
            st.Test() // Error
            st2.Test() // Success
        )*/



#Namespace(Kimi.Low.Windows)
public group Helper
    #LibraryImport("kernel32.dll")
    public static func HeapAlloc(hHeap: isize, dwFlags: uint32, dwBytes: usize) -> isize

    public func Method1(x: i32) -> i32
        return x + 4

    #Condition(Architecture=="x64")
    public func ReadTsc() -> i64
        let low: u32;
        let high: u32;
        #Assembler("""
            "rdtsc",
            out("eax") low,
            out("edx") high,
            options(nomem, nostack, preserves_flags)
            """)
        return ((high@u64) << 32) | low@u64

