func FuncA<s/T>(value: s/T)
    #case s is ref and T is Comparable
        ProcessComparableReference(value)

    #case s is ref
        ProcessReference(value)

    #case s is obj
        ProcessObject(value)

    #case _
        ProcessOther(value)

