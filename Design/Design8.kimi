public group Example
    public method Main() => Task
        $Console.WriteLine("Hello world!")
        context.Console.WriteLine("Hello world!")
        Example::Example.Test()
        $Panic("")
        self.Method2(32)
        new Class() -> var x
        var x = new Class()
        var y = &x
        var z = !x
        var a < new Class()
        &Class b < &x
        !Class c <- !x
classA.x = classB.x
classA.y <= classB.y
        return

    private static method Test()

    private static method Test() => Task
        // Block
        if (context.CancellationToken.IsCancelRequested)
            return

        var st = TestStruct.New()
        var st2 = Arc.New(st) // &owner Arc<TestStruct> // TそのものはThread-traversalではない
        _ = Task.Run(async () => // Closure -> Block. Require reference analysis
            var i = 0
            i++
            st.Test() // Error
            st2.Test() // Success
        )

        _ = Task.Run(async () =>
            var i = 0
            i++
        )
        .ConfigureAwait(false)



#Namespace(Kimi.Low.Windows)
public group Helper
    #LibraryImport("kernel32.dll")
    public static method HeapAlloc(isize hHeap, uint32 dwFlags, usize dwBytes) -> isize

    public method Method1(int x) -> int
        return x + 4

    #Condition(Architecture=="x64")
    public method ReadTsc() -> i64
        let low: u32;
        let high: u32;
        #Assembler(
            "rdtsc",
            out("eax") low,
            out("edx") high,
            options(nomem, nostack, preserves_flags)
            )
        return ((high as u64) << 32) | low as u64

