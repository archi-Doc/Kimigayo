// The rows' platform (SPEC 22.4.5, IMPL 21.6.3) on QEMU's q35 machine: pages from the loader's largest usable memory map
// entry, output on COM1, the clock from the time-stamp counter and the end through QEMU's isa-debug-exit device.
struct Board
    Self is Copy
    Self is Platform
    var next: usize
    var end: usize

    init(next: usize, end: usize)
        self.next = next
        self.end = end

    // The page run is the largest usable (kind 0) entry through the direct map. The kernel's image and the loader's
    // bootloader-reclaimable memory (the stack, page tables and responses) are other kinds, so the run is clear of them (IMPL 21.6.2).
    public func start(boot: Boot) -> Self
        var next: usize = 0
        var end: usize = 0
        var i: isize = 0
        while i < boot.regionCount
            unsafe
                let region = boot.regions[i]
                if (*region).kind == 0 and (*region).length@usize > end - next
                    next = boot.directMapOffset + (*region).address@usize
                    end = next + (*region).length@usize
            i += 1
        return Board.init(next, end)

    public func mapPages(self: uniq/Self, bytes: isize) -> raw/u8
        if self.end - self.next < bytes@usize
            return null
        let run = self.next
        self.next += bytes@usize
        return run@raw/u8

    // This board keeps released runs unused.
    public func releasePages(self: uniq/Self, run: raw/u8, bytes: isize) -> i64 => 0

    // COM1 at 0x3F8 needs no setup under QEMU; each byte waits for an empty transmitter (line status 0x3FD, bit 5).
    public func write(self: uniq/Self, stream: i32, text: Text.Utf8Slice) -> i64
        let bytes = text.bytes()
        var i: isize = 0
        while i < bytes.length
            unsafe
                while (X86.readPort8(0x3FD) & 0x20) == 0
                    X86.pause()
                X86.writePort8(0x3F8, bytes[i])
            i += 1
        return 0

    // This board assumes a 1 GHz invariant time-stamp counter.
    public func clock(self: uniq/Self) -> i64 => X86.readTimestamp()@i64

    // QEMU's isa-debug-exit at 0xF4 ends QEMU with exit status 2 * status + 1.
    public func terminate(self: uniq/Self, status: i32) -> Never
        unsafe => X86.writePort8(0xF4, status@u8)
        loop => X86.halt()
