// The rows' timer handler (B10 §6.1, IMPL 21.6.9): the PIC's end of interrupt for IRQ 0, without which no later tick arrives.
// It shares no storage with the code it interrupts (handler rules 1-3).
struct TimerTick
    Self is X86.InterruptHandler

    public func handle(frame: ref/X86.InterruptFrame)
        unsafe => X86.writePort8(0x20, 0x20)
