diff --git a/src/Kimi/Compiler/Mir/Analysis/MirBorrows.WProto.cs b/src/Kimi/Compiler/Mir/Analysis/MirBorrows.WProto.cs
new file mode 100644
index 000000000..f9ccfd0ad
--- /dev/null
+++ b/src/Kimi/Compiler/Mir/Analysis/MirBorrows.WProto.cs
@@ -0,0 +1,378 @@
+// Copyright (c) All contributors. All rights reserved. Licensed under the MIT license.
+
+#pragma warning disable SA1401, SA1402, SA1600, SA1201, SA1202, SA1204, SA1513, SA1515, SA1116, SA1117, SA1118
+
+// THROWAWAY (2a-2 prototype round for rule W, R4-M104; never committed): the per-(Loan, holder) direct bit of the proposal's §4, held as a
+// shadow element per Loan or marker (shadowBase + element) that marks the element indirect in a set, so the dataflow's union join is the
+// bit's AND; the per-store fixed-part check for _0 and E; and each Loan problem's W reading over the carriers its check set found.
+using System.Text;
+using Kimi.Diagnostics;
+
+namespace Kimi.Compiler.Mir;
+
+internal sealed partial class MirBorrows
+{
+    private readonly List<(int Element, int Via, bool Indirect)> wCarriers = [];
+    private Dictionary<int, int> indirectMemo = [];
+    private int shadowBase = int.MaxValue;
+    private int wLocation;
+    private int wTransit = -1;
+    private int wStamp = -1;
+    private (bool Derived, string Loans, List<(SourceRef, BoundOrigin, BoundOrigin)> Causes)? wNote;
+
+    // Whether an element is a Loan, a marker or Φ_E (not a shadow).
+    private bool IsElement(int element) => element < this.shadowBase;
+
+    // A set with every Loan and marker it holds marked indirect.
+    private int Indirect(int set)
+    {
+        if (this.shadowBase == int.MaxValue || set == 0)
+        {
+            return set;
+        }
+
+        if (this.indirectMemo.TryGetValue(set, out var known))
+        {
+            return known;
+        }
+
+        // The shadows by runs of consecutive elements: one Range and one Union per run.
+        var result = set;
+        var count = this.sets.Count(set);
+        for (var i = 0; i < count;)
+        {
+            var element = this.sets.Elements(set)[i];
+            if (element < Markers || element >= this.shadowBase)
+            {
+                i++;
+                continue;
+            }
+
+            var end = i + 1;
+            while (end < count && this.sets.Elements(set)[end] == element + (end - i) && this.sets.Elements(set)[end] < this.shadowBase)
+            {
+                end++;
+            }
+
+            result = this.sets.Union(result, this.sets.Range(this.shadowBase + element, end - i));
+            i = end;
+        }
+
+        this.indirectMemo[set] = result;
+        this.indirectMemo[result] = result;
+        return result;
+    }
+
+    // A store's arrival into a holder: into _0 or E the bit holds only where the receiving part's Origin is fixed; into a local, only for a
+    // whole-root replacement.
+    private (int Value, int Own) Arrive(int slot, MirPlace place, int value, int own, bool whole)
+    {
+        if (this.shadowBase == int.MaxValue)
+        {
+            return (value, own);
+        }
+
+        var keep = slot == Escaped || this.IsResult(slot) ? this.FixedPart(place) : whole;
+        return keep ? (value, own) : (this.Indirect(value), this.Indirect(own));
+    }
+
+    private bool IsResult(int slot) => this.body.Locals.Length > 0 && this.slots[0] == slot && slot >= 0;
+
+    private bool[] transit = [];
+
+    // Whether a set's direct Loans all name whole roots (a borrow of a root's storage itself) and it carries no Φ_E: its content is
+    // the whole values of those roots.
+    private bool WholeContent(int set)
+    {
+        var any = false;
+        foreach (var element in this.sets.Elements(set))
+        {
+            if (element == Escaped)
+            {
+                return false;
+            }
+
+            if (element >= this.loanBase && this.IsElement(element) && this.loans[element - this.loanBase] is { Direct: true } loan)
+            {
+                if (loan.Count != 0 || loan.Named < 0)
+                {
+                    return false;
+                }
+
+                any = true;
+            }
+        }
+
+        return any;
+    }
+
+    // THE MISSING FACT, emulated: a local the builder uses only to carry the returned value into _0 (every read of it a whole-value
+    // Copy or Move into _0 or another such local), so its value is the result in transit across the body's cleanup.
+    private void Transit()
+    {
+        var locals = this.body.Locals.Length;
+        MirDataflow.Grow(ref this.transit, locals);
+        var bad = new bool[locals];
+        var edges = new List<(int From, int To)>();
+        void Bad(MirPlace place)
+        {
+            if (place.Root >= 0)
+            {
+                bad[place.Root] = true;
+            }
+        }
+
+        foreach (var statement in this.body.Statements)
+        {
+            if (statement.Kind == MirStatementKind.Assign)
+            {
+                var rvalue = statement.Rvalue;
+                if (rvalue is { Kind: MirRvalueKind.Use, Count: 1 } && this.body.Operands[rvalue.Start] is { Kind: MirOperandKind.Copy or MirOperandKind.Move, Place: { Projection: 0, Root: >= 1 } from } &&
+                    statement.Place is { Projection: 0, Root: >= 0 } to)
+                {
+                    edges.Add((from.Root, to.Root));
+                    continue;
+                }
+
+                for (var o = rvalue.Start; o < rvalue.Start + rvalue.Count; o++)
+                {
+                    Bad(this.body.Operands[o].Place);
+                }
+
+                if (rvalue.Kind == MirRvalueKind.Ref)
+                {
+                    Bad(rvalue.Place);
+                }
+
+                if (statement.Place.Projection != 0)
+                {
+                    Bad(statement.Place);
+                }
+            }
+            else if (statement.Kind is not (MirStatementKind.StorageLive or MirStatementKind.StorageDead))
+            {
+                Bad(statement.Place);
+            }
+        }
+
+        foreach (var block in this.body.Blocks)
+        {
+            var terminator = block.Terminator;
+            if (terminator.Operand.Kind != MirOperandKind.Const)
+            {
+                Bad(terminator.Operand.Place);
+            }
+
+            for (var o = terminator.Start; o < terminator.Start + terminator.Count; o++)
+            {
+                Bad(this.body.Operands[o].Place);
+            }
+
+            if (terminator.Place.Projection != 0)
+            {
+                Bad(terminator.Place);
+            }
+        }
+
+        var has = new bool[locals];
+        foreach (var (from, _) in edges)
+        {
+            has[from] = true;
+        }
+
+        for (var i = 0; i < locals; i++)
+        {
+            this.transit[i] = i > 0 && has[i] && !bad[i] && this.body.Locals[i].Kind == MirLocalKind.Temp; // A builder temp: a user local is never the result.
+        }
+
+        for (var changed = true; changed;)
+        {
+            changed = false;
+            foreach (var (from, to) in edges)
+            {
+                if (this.transit[from] && to != 0 && !this.transit[to])
+                {
+                    (this.transit[from], changed) = (false, true);
+                }
+            }
+        }
+    }
+
+    // A carrier that is the result: _0, or a local carrying the returned value into it, where _0's Origin is fixed.
+    private bool ResultLike(int slot)
+    {
+        if (this.IsResult(slot))
+        {
+            return true;
+        }
+
+        for (var i = 1; i < this.body.Locals.Length; i++)
+        {
+            if (this.slots[i] == slot && slot >= 0)
+            {
+                return this.transit[i] && this.FixedPart(new MirPlace(0));
+            }
+        }
+
+        return false;
+    }
+
+    // Whether a Place's case Type has an outer Origin the C1-F4 view classes Fixed at the location.
+    private bool FixedPart(MirPlace place)
+    {
+        var type = this.body.TypeOf(place) is { } t ? cases.Type(t) : null;
+        return this.FixedOrigin(type?.Origin);
+    }
+
+    // Whether a written argument's referent part has a fixed Origin (the call clause's store into E).
+    private bool FixedReferent(int operand)
+    {
+        var type = this.TypeOf(operand);
+        return type is { Components.Count: > 0 } && this.FixedOrigin(type.Components[0].Origin);
+    }
+
+    private bool FixedOrigin(BoundOrigin? origin)
+    {
+        if (origin is null || this.shadowBase == int.MaxValue)
+        {
+            return false;
+        }
+
+        var site = this.body.Subject(this.Source(this.wLocation));
+        var index = types.OriginAtom(this.body.Key.Body, origin, site);
+        return types.OriginRows(this.body.Key.Body).Atoms[index].Kind == OriginAtomKind.Fixed;
+    }
+
+    // A Loan or marker found in a holder (-1: a transit value, whose destination wTransit names) at the check.
+    private void Carrier(int set, int element, int via)
+    {
+        if (this.shadowBase == int.MaxValue || element < Markers)
+        {
+            return;
+        }
+
+        if (this.wStamp != this.stamp)
+        {
+            (this.wStamp, _) = (this.stamp, 0);
+            this.wCarriers.Clear();
+        }
+
+        var holder = via == -1 ? this.wTransit : via;
+        this.wCarriers.Add((element, holder, this.sets.Contains(set, this.shadowBase + element)));
+    }
+
+    // The W reading of an access's conflicts: every Loan of its root's check set it conflicts with.
+    private void WAccess(int root, ReadOnlySpan<MirStep> steps, AccessKind kind, int taking, int scope, int reservation)
+    {
+        if (this.shadowBase == int.MaxValue)
+        {
+            return;
+        }
+
+        var elements = new List<int>();
+        for (var c = this.First(root); c != None; c = this.candidates[c].Next)
+        {
+            if (this.Conflicts(c, root, steps, kind, taking) && !this.Covered(scope, this.candidates[c].Loan, reservation))
+            {
+                elements.Add(this.loanBase + this.candidates[c].Loan);
+            }
+        }
+
+        this.WRead(elements);
+    }
+
+    // The W reading of err(ended): the candidate's marker.
+    private void WEnded(int candidate)
+    {
+        if (this.shadowBase != int.MaxValue)
+        {
+            this.WRead([Markers + candidate]);
+        }
+    }
+
+    // Per element: its Borrow's atom (a Loan's Ref statement; a marker's Ref into its candidate), the Refuted problems from that atom in this
+    // view, and its carriers at the check: derived when the atom is Finite, refuted, and every carrier is _0 or E with the bit set.
+    private void WRead(List<int> elements)
+    {
+        var text = new StringBuilder();
+        var causes = new List<(SourceRef, BoundOrigin, BoundOrigin)>();
+        var derived = elements.Count > 0;
+        WProto.RefAtoms.TryGetValue(this.body.Ordinal, out var atoms);
+        WProto.Refuted.TryGetValue(this.body.Ordinal, out var refuted);
+        foreach (var element in elements)
+        {
+            var statement = this.BorrowOf(element);
+            var atom = statement >= 0 && atoms is not null && atoms.TryGetValue(statement, out var a) ? a : default;
+            var mine = new List<(SourceRef, BoundOrigin, BoundOrigin)>();
+            foreach (var (source, target, views, subject) in refuted ?? [])
+            {
+                if (atom.Atom is not null && ReferenceEquals(source, atom.Atom) && (views & this.views) != 0)
+                {
+                    mine.Add((subject, source, target));
+                }
+            }
+
+            var carriers = new StringBuilder();
+            var escapeOnly = true;
+            var any = false;
+            foreach (var (found, via, indirect) in this.wCarriers)
+            {
+                if (found != element || this.wStamp != this.stamp)
+                {
+                    continue;
+                }
+
+                any = true;
+                var name = via == Escaped ? "E" : this.IsResult(via) ? "_0" : this.ResultLike(via) ? $"_0'(slot{via})" : via < 0 ? "transit?" : $"slot{via}";
+                carriers.Append($" {name}{(indirect ? "~" : string.Empty)}");
+                escapeOnly &= (via == Escaped || this.ResultLike(via)) && !indirect;
+            }
+
+            var mineDerived = atom.Kind == OriginAtomKind.Finite && atom.Atom is not null && mine.Count > 0 && any && escapeOnly;
+            derived &= mineDerived;
+            if (mineDerived)
+            {
+                causes.AddRange(mine);
+            }
+
+            var label = element < this.loanBase ? $"marker{element - Markers}" : $"loan{element - this.loanBase}@s{statement}";
+            text.Append($"[{label} atom={atom.Kind}{(atom.Atom is null ? "-none" : string.Empty)} refuted={mine.Count} carriers={carriers.ToString().Trim()} -> {(mineDerived ? "derived" : "independent")}] ");
+        }
+
+        this.wNote = (derived, text.ToString().Trim(), derived ? causes : []);
+    }
+
+    // The statement of an element's Borrow: a Loan's issuing statement, a marker's Ref into its guard candidate (the first in body order).
+    private int BorrowOf(int element)
+    {
+        if (element >= this.loanBase)
+        {
+            var location = this.loans[element - this.loanBase].Location;
+            return location < this.body.Statements.Length ? location : -1;
+        }
+
+        var candidate = element - Markers;
+        for (var s = 0; s < this.body.Statements.Length; s++)
+        {
+            if (this.body.Statements[s] is { Kind: MirStatementKind.Assign, Place: { Projection: 0, Root: var root }, Rvalue.Kind: MirRvalueKind.Ref } && root == candidate)
+            {
+                return s;
+            }
+        }
+
+        return -1;
+    }
+
+    // Records the W reading of the problem just recorded (none read: "n/a").
+    private void WRecord(DiagnosticCode code, SourceRef subject)
+    {
+        if (this.shadowBase == int.MaxValue)
+        {
+            return;
+        }
+
+        var note = this.wNote ?? (false, "n/a", []);
+        WProto.Records.Add(new(this.body.Ordinal, this.view, code, subject, note.Derived, note.Loans, note.Causes));
+        this.wNote = null;
+    }
+}
