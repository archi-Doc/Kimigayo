+// Copyright (c) All contributors. All rights reserved. Licensed under the MIT license.
+
+#pragma warning disable SA1401, SA1402, SA1600, SA1649, SA1201, SA1202, SA1204, SA1214, CS1591
+
+// THROWAWAY (2a-2 prototype round for rule W, R4-M104; never committed): the channel between MirOrigins' Refuted chains and MirBorrows'
+// per-(Loan, holder) direct bit, and the records the probe reads.
+using Kimi.Diagnostics;
+
+namespace Kimi.Compiler.Mir;
+
+internal static class WProto
+{
+    // Whether the bit runs (the probe sets it; off gives the unmodified stratum's work).
+    internal static bool Enabled = Environment.GetEnvironmentVariable("KIMI_W_OFF") is null;
+
+    // The records of the last program: one per Loan problem recorded by MirBorrows (its W status) and the Origin context per body.
+    internal static readonly List<WRecord> Records = [];
+
+    // Per body ordinal: each Ref statement's atom (canonical BoundOrigin) and class; and the Refuted problems Judge found.
+    internal static readonly Dictionary<int, Dictionary<int, (BoundOrigin Atom, OriginAtomKind Kind)>> RefAtoms = [];
+    internal static readonly Dictionary<int, List<(BoundOrigin Source, BoundOrigin Target, ulong Views, SourceRef Subject)>> Refuted = [];
+
+    internal static void Clear()
+    {
+        Records.Clear();
+        RefAtoms.Clear();
+        Refuted.Clear();
+    }
+}
+
+// One Loan problem's W reading in one view: Derived when every conflicting Loan's conflict is derived; Loans: per conflicting element its
+// reading; Causes: the Refuted problems (subject, source, target) named.
+internal sealed record WRecord(int Body, long View, DiagnosticCode Code, SourceRef Subject, bool Derived, string Loans, List<(SourceRef Subject, BoundOrigin Source, BoundOrigin Target)> Causes);
