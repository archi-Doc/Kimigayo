diff -ruN '--exclude=bin' '--exclude=obj' src/Kimi/Compiler/F4Probe.cs ../copy/src/Kimi/Compiler/F4Probe.cs
--- a/src/Kimi/Compiler/F4Probe.cs
+++ b/src/Kimi/Compiler/F4Probe.cs
@@ -0,0 +1,200 @@
+// Copyright (c) All contributors. All rights reserved. Licensed under the MIT license.
+
+#pragma warning disable SA1600, SA1401, CS1591, SA1649, SA1402
+
+using System.Text;
+using Kimi.Compiler.Parsing;
+
+namespace Kimi.Compiler;
+
+// Scratch probe of A5 step 2 unit 2a0-0 (never in a tracked source file): events recorded by the instrumented copy of the
+// compiler, read by the census test. Inert unless Enabled is set.
+public static class F4Probe
+{
+    public static readonly bool NoSkip = Environment.GetEnvironmentVariable("F4_NOSKIP") == "1";
+    public static readonly bool JudgeCallBorrows = Environment.GetEnvironmentVariable("F4_CALLBORROWS") == "1";
+    public static readonly List<(string Kind, Koto? Node, string Detail)> Events = new();
+    public static volatile bool Enabled;
+
+    [ThreadStatic]
+    public static Compilation? LastIrCompilation;
+
+    // The documents of the last compilation WriteIr wrote on this thread, in the ledger's source format.
+    public static string? LastIrSource()
+    {
+        if (LastIrCompilation is not { } compilation)
+        {
+            return null;
+        }
+
+        var text = new StringBuilder();
+        foreach (var module in compilation.SourceModules)
+        {
+            foreach (var document in module.SourceDocuments)
+            {
+                text.Append("// ").Append(Path.GetFileName(document.Path)).Append('\n').Append(document.SourceText).Append('\n');
+            }
+        }
+
+        return text.ToString();
+    }
+
+    // RecordMismatch window: whether a judged chain went through LocalRegionSources (FailingOperand, AddFailingChains) or
+    // through JudgeLocalRegion.
+    [ThreadStatic]
+    internal static int MismatchDepth;
+    [ThreadStatic]
+    internal static HashSet<BoundOrigin>? RegionOperands;
+    [ThreadStatic]
+    internal static bool JudgedViaRegion;
+
+    public static void Add(string kind, Koto? node, string detail)
+    {
+        if (!Enabled)
+        {
+            return;
+        }
+
+        lock (Events)
+        {
+            Events.Add((kind, node, detail));
+        }
+    }
+
+    internal static void BeginMismatch()
+    {
+        MismatchDepth++;
+        (RegionOperands ??= new(ReferenceEqualityComparer.Instance)).Clear();
+        JudgedViaRegion = false;
+    }
+
+    internal static void EndMismatch() => MismatchDepth--;
+
+    internal static void RegionOperand(BoundOrigin origin)
+    {
+        if (MismatchDepth > 0)
+        {
+            RegionOperands?.Add(origin);
+        }
+    }
+
+    // An Origin with its kind: S static, P parameter, I input, Pr projection (finite body-local Borrow), A anchor, R local region,
+    // Inf other inference, U unbound, (a & b) a meet.
+    public static string Show(BoundOrigin? origin)
+    {
+        if (origin is null)
+        {
+            return "-";
+        }
+
+        if (origin.Kind == OriginKind.Intersection)
+        {
+            var text = new StringBuilder("(");
+            for (var i = 0; i < origin.Operands.Count; i++)
+            {
+                text.Append(i == 0 ? string.Empty : " & ").Append(Show(origin.Operands[i]));
+            }
+
+            return text.Append(')').ToString();
+        }
+
+        var prefix = origin.Kind switch
+        {
+            OriginKind.Static => "S",
+            OriginKind.Parameter => "P",
+            OriginKind.Input => "I",
+            OriginKind.Projection => "Pr",
+            OriginKind.Anchor => "A",
+            OriginKind.Unbound => "U",
+            OriginKind.Inference when Binding.IsLocalRegion(origin) => "R",
+            _ => "Inf",
+        };
+        return prefix + ":" + origin.Name + "@" + (origin.Binder?.Span.Start.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "-") + "/" + origin.Slot;
+    }
+
+    // The class of an end under SPEC 15.6.5 as Binding represents it: fixed (static, parameter, input, or a meet of them), finite
+    // (a Projection: a body-local Borrow), anchor (a raw Borrow), region (a local region), inferred (other inference), unbound,
+    // or mixed (a meet of different classes).
+    public static string Class(BoundOrigin? origin)
+    {
+        if (origin is null)
+        {
+            return "-";
+        }
+
+        if (origin.Kind == OriginKind.Intersection)
+        {
+            string? result = null;
+            for (var i = 0; i < origin.Operands.Count; i++)
+            {
+                var part = Class(origin.Operands[i]);
+                result = result is null || result == part ? part : "mixed";
+            }
+
+            return result ?? "fixed";
+        }
+
+        return origin.Kind switch
+        {
+            OriginKind.Static or OriginKind.Parameter or OriginKind.Input => "fixed",
+            OriginKind.Projection => "finite",
+            OriginKind.Anchor => "anchor",
+            OriginKind.Unbound => "unbound",
+            OriginKind.Inference when Binding.IsLocalRegion(origin) => "region",
+            _ => "inferred",
+        };
+    }
+
+    public static bool HasAnchor(BoundOrigin? origin)
+    {
+        if (origin is null)
+        {
+            return false;
+        }
+
+        if (origin.Kind == OriginKind.Anchor)
+        {
+            return true;
+        }
+
+        for (var i = 0; i < origin.Operands.Count; i++)
+        {
+            if (HasAnchor(origin.Operands[i]))
+            {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    // A node's document file name and start offset.
+    public static string Where(Koto? node)
+    {
+        var path = node?.CodeContext?.SourceDocument?.Path;
+        return (path is null ? "?" : path[(Math.Max(path.LastIndexOf('/'), path.LastIndexOf('\\')) + 1)..]) + ":" + (node?.Span.Start.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "?");
+    }
+
+    public static string Function(Koto? node)
+    {
+        for (var current = node; current is not null; current = current.Parent)
+        {
+            if (current is FunctionKoto function)
+            {
+                var owner = string.Empty;
+                for (var parent = function.Parent; parent is not null; parent = parent.Parent)
+                {
+                    if (parent is DeclarationContainerKoto { Name: { Length: > 0 } name })
+                    {
+                        owner = name + ".";
+                        break;
+                    }
+                }
+
+                return owner + (function.Name.Length == 0 ? "<anon>" : function.Name);
+            }
+        }
+
+        return "-";
+    }
+}
