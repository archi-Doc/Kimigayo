struct KeptBox<T>
    public var p: raw/T
    public init(p: raw/T) => self.p = p
func storeKept<T>(b: uniq/KeptBox<T>, v: T)
    unsafe => Raw.initialize(b.p, v@move)
struct Buffer<T>
    internal let data: raw/T
    internal var length: isize
    let capacity: isize
    public init(capacity: isize)
        self.data = Raw.allocate<T>(capacity)
        self.length = 0
        self.capacity = capacity
    public func push(self: uniq/Self, value: T)
        require self.length < self.capacity else => $abort("Buffer is full")
        unsafe => Raw.initialize(self.data + self.length, value@move)
        self.length += 1
func keptDead()
    var x = 1
    var b = KeptBox<ref/i32>.init(p: Raw.allocate(1))
    storeKept(b@uniq, x@ref)
    x = 5
func keptLive()
    var x = 1
    var b = KeptBox<ref/i32>.init(p: Raw.allocate(1))
    storeKept(b@uniq, x@ref)
    x = 5
    inspect(b)
func bufferDead()
    var x = 1
    var buf = Buffer<ref/i32>.init(capacity: 2)
    buf.push(x@ref)
    x = 5
func bufferLive()
    var x = 1
    var buf = Buffer<ref/i32>.init(capacity: 2)
    buf.push(x@ref)
    x = 5
    inspect(buf)
func views()
    var a = Data.init()
    var views: Array<ref/Data> = [a@ref]
    for v in views
        inspect(v)
    a.value = 3
func viewsLater()
    var a = Data.init()
    do
        var views: Array<ref/Data> = [a@ref]
        for v in views
            inspect(v)
    a.value = 3
    inspect(a)
func viewsUniq()
    var a = Data.init()
    var views: Array<ref/Data> = [a@ref]
    for v in views@uniq
        inspect(v)
    a.value = 3
func viewsOwned()
    var a = Data.init()
    var views: Array<ref/Data> = [a@ref]
    for v in views@move
        inspect(v)
    a.value = 3
