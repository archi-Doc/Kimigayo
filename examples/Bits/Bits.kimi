func masked(value: i32, mask: i32) -> i32 => value & mask

func snapshot() -> i32
    var value = 3
    defer => value <<= 2
    return value << 1

public func main() -> ()
    defer => writeLine("done")
    var bits = 10
    bits |= 1
    bits ^= 2
    bits <<= 1
    bits >>= 1
    if masked(bits, 15) == 9 and snapshot() == 6 and (-3 >> 1) == -2
        writeLine("ok")
        return
    writeLine("unexpected")
