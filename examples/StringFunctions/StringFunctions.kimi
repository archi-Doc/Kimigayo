func echo(text: string) -> string => text@move

func choose(first: string, second: string, takeFirst: bool) -> string
    defer => Console.writeLine("cleanup")
    return if takeFirst => first@move else => second@move

public func main()
    var text = echo(echo("before"))
    text = choose(second: "after", first: text@move, takeFirst: false)
    Console.writeLine(text)
    echo("discarded")
