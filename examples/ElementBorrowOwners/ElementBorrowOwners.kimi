func same(left: ref/string, right: ref/string) -> bool => left == right

func make() -> (string, i32) => ("held", 42)

func inspect(pair: (string, i32)) -> bool
    return same(pair.0, pair.0)

func conditional(flag: bool) -> bool
    return flag and (if flag => make() else => ("other", 0)).0 == "held"

if inspect(make())
    Console.writeLine("owned parameter")

if same(make().0, ("held", 0).0)
    Console.writeLine("temporary owners")

if conditional(true) and not conditional(false)
    Console.writeLine("conditional lifetime")

if (work: do
    exit to work: ("held", 0)
).0 == "held"
    Console.writeLine("delivered result")
