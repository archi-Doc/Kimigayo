func first(pair: (string, string)) -> string => pair.0

func choose(pair: (string, string), takeFirst: bool) -> string
    return if takeFirst => pair.0 else => pair.1

func middle(values: [3 of string]) -> string => values[1]

Console.writeLine(first(("first", "unused")))
Console.writeLine(choose(("unused", "last"), false))
let values: [3 of string] = ["left", "middle", "right"]
Console.writeLine(middle(values))
