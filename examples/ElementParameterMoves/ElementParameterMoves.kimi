func first(pair: (string, string)) -> string => pair.0@move

func choose(pair: (string, string), takeFirst: bool) -> string
    return if takeFirst => pair.0@move else => pair.1@move

func middle(values: [3 of string]) -> string => values[1]@move

Console.writeLine(first(("first", "unused")))
Console.writeLine(choose(("unused", "last"), false))
let values: [3 of string] = ["left", "middle", "right"]
Console.writeLine(middle(values@move))
