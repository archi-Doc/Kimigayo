// A let can supply a Move. Its remaining sibling is still usable.
let original = ("taken", 40)
let text = original.0
if original.1 == 40 => writeLine(text)

// A constructed var can repair a missing static element.
var values: [2 of string] = ["first", "last"]
let first = values[0]
values[(0x0)] = "replacement"
values[1] = values[1]
let complete = values

// Both branch outcomes retain exactly one destruction responsibility per string.
func replace(take: bool)
    var pair = ("old", "sibling")
    if take
        let old = pair.0
    pair.0 = "new"
    let complete = pair

replace(true)
replace(false)
writeLine("element moves complete")
