// Milestone 8: nested declaration containers and generic ownership transfer.
group Toolkit
    public group Storage
        public struct Box<T>
            let value: T

            public init(value: T)
                self.value = value

            // No deinit: extracting a Non-Copy field is permitted.
            public func take(self: Self) -> T => self.value

    public group Selection
        public func choose<T>(first: T, second: T, useFirst: bool) -> T
            return if useFirst => first else => second

public func main()
    defer => ::Kimi.Console.writeLine("Generic scope finished.")
    let selected = Toolkit.Selection.choose(
        Toolkit.Storage.Box<string>.init("Chosen item."),
        Toolkit.Storage.Box<string>.init("Unused item."),
        true)
    // The unselected Box is destroyed in choose; selected is consumed here.
    ::Kimi.Console.writeLine(selected.take())

    let numbers = Toolkit.Storage.Box<[3 of i32]>.init([2, 4, 6])
    let values = numbers.take()
    var total: i32 = 0
    for value in values
        total = total + value
    require total == 12 else => $abort("Unexpected boxed array total")
    ::Kimi.Console.writeLine("Boxed array total is 12.")
