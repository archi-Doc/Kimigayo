// Milestone 31: Dictionary equality, retained keys, insertion order and ownership.
struct Key
    Self is Equatable
    public let code: i32
    public let tag: i32
    public init(code: i32, tag: i32)
        self.code = code
        self.tag = tag
    // Equality is stable and ignores the tag identifying this particular key value.
    public func equals(self: ref/Self, other: ref/Self) -> bool => self.code == other.code
    deinit
        match self.tag
            0 => () // Quiet temporary search key.
            1 => Console.writeLine("Key 1 destroyed.")
            2 => Console.writeLine("Key 2 destroyed.")
            3 => Console.writeLine("Key 3 destroyed.")
            4 => Console.writeLine("Key 4 destroyed.")
            8 => Console.writeLine("Replacement key destroyed.")
            9 => Console.writeLine("Rejected key destroyed.")
            _ => $abort("Unexpected key")

struct Item
    public let id: i32
    public init(id: i32) => self.id = id
    deinit
        match self.id
            10 => Console.writeLine("Item 10 destroyed.")
            11 => Console.writeLine("Item 11 destroyed.")
            12 => Console.writeLine("Item 12 destroyed.")
            20 => Console.writeLine("Item 20 destroyed.")
            30 => Console.writeLine("Item 30 destroyed.")
            40 => Console.writeLine("Item 40 destroyed.")
            99 => Console.writeLine("Rejected item destroyed.")
            _ => $abort("Unexpected item")

public func main()
    var entries: Dictionary<Key, Item> = [:]
    require entries.length == 0 and entries.capacity == 0 else => $abort("Empty Dictionary allocated storage")
    entries.reserve(additional: 3)
    let capacity = entries.capacity
    require capacity >= 3 else => $abort("Reserve failed")
    match entries.tryInsert(Key.init(1, 1), Item.init(10))
        .Ok(()) => ()
        .Err(_) => $abort("First insertion failed")
    match entries.tryInsert(Key.init(2, 2), Item.init(20))
        .Ok(()) => ()
        .Err(_) => $abort("Second insertion failed")
    match entries.tryInsert(Key.init(3, 4), Item.init(40))
        .Ok(()) => ()
        .Err(_) => $abort("Third insertion failed")

    // Err returns the acquired input pair; it does not return the stored entry.
    match entries.tryInsert(Key.init(1, 9), Item.init(99))
        .Ok(()) => $abort("Duplicate was inserted")
        .Err((let key, let value))
            require key.tag == 9 and value.id == 99 else => $abort("Rejected inputs were lost")
            Console.writeLine("Duplicate returned both inputs.")
            // Pattern bindings are destroyed right to left: value, then key.
    require entries.length == 3 and entries.capacity == capacity else => $abort("Duplicate changed storage")

    // Replacement destroys the unused input key before delivering the old value.
    match entries.insertOrReplace(Key.init(1, 8), Item.init(11))
        .Some(let old)
            require old.id == 10 else => $abort("Wrong old value")
            Console.writeLine("Replacement returned item 10.")
        .None => $abort("Replacement appended an entry")
    entries[Key.init(1, 0)] = Item.init(12) // Existing-key assignment destroys Item 11.
    match entries.tryGet(Key.init(1, 0))@move
        .Some(let found)
            require found.id == 12 else => $abort("Lookup failed")
        .None => $abort("Existing key is missing")
    match entries.tryGet(Key.init(9, 0))@move
        .Some(_) => $abort("Absent key was found")
        .None => ()

    // Shared iteration exposes the original key, not either equal input key.
    var position: i32 = 0
    for (key, value) in entries
        position += 1
        match position
            1 => require key.tag == 1 and value.id == 12 else => $abort("Stored key changed")
            2 => require key.tag == 2 and value.id == 20 else => $abort("Second entry changed")
            3 => require key.tag == 4 and value.id == 40 else => $abort("Third entry changed")
            _ => $abort("Extra entry")
    require position == 3 else => $abort("Shared iteration skipped entries")
    Console.writeLine("Stored keys and insertion order preserved.")

    match entries.remove(Key.init(1, 0))
        .Some((let key, let value))
            require key.tag == 1 and value.id == 12 else => $abort("Wrong removed entry")
            Console.writeLine("Removed the original key and item.")
        .None => $abort("Removal failed")
    match entries.remove(Key.init(1, 0))
        .Some(_) => $abort("Removed an absent key")
        .None => ()
    match entries.tryInsert(Key.init(1, 3), Item.init(30))
        .Ok(()) => ()
        .Err(_) => $abort("Reinsertion failed")
    require entries.length == 3 and entries.capacity == capacity else => $abort("Churn changed capacity")
    // Order is now key 2, key 4, key 3. Stop after the first acquired pair.
    for (key, value) in entries@move
        require key.tag == 2 and value.id == 20 else => $abort("Reinsertion order failed")
        Console.writeLine("Owning iteration starts at key 2.")
        exit // Destroy this pair, then unyielded entries in reverse insertion order.
    Console.writeLine("Dictionary run finished.")
