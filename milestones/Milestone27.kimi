// Milestone 27: saved bounds, nested Slice views and separate backing/element Origins.
func startBound() -> isize
    Console.writeLine("Start evaluated.")
    return 1

func endBound() -> Index
    Console.writeLine("End evaluated.")
    return ^1

func tail<T>(values: Slice<T>) -> Slice<T>{result}
    origin result.source == values.source
    return values[1..]

public func main()
    let grid: [3 of [4 of i32]] = [[1, 2, 3, 4], [10, 20, 30, 40], [5, 6, 7, 8]]
    let bounds: Range = startBound()..endBound()
    let resolved = bounds.resolve(grid[1].length)
    require resolved.start == 1 and resolved.end == 3 else => $abort("Range resolution failed")
    let middle: Slice<i32> = selection: do
        let rows: Slice<[4 of i32]> = grid[1..]
        let row = rows[0][..]
        exit to selection: row[resolved] // Retain grid, not either local Slice handle.
    let last: Index = ^1
    require middle.length == 2 and middle[0] == 20 and middle[last] == 30 else => $abort("Nested view failed")
    let parts = middle.splitAt(1)
    require parts.0[0] == 20 and parts.1[0] == 30 else => $abort("Split failed")
    let empty = middle[^0..]
    require empty.isEmpty and empty.length == 0 else => $abort("Empty view failed")
    require tail(middle)[0] == 30 else => $abort("Generic reslice failed")
    Console.writeLine("Nested views retain 20 and 30.")

    match middle.tryGet(^0)
        .Some(_) => $abort("End boundary became an element")
        .None => Console.writeLine("End boundary is not an element.")
    match bounds.tryResolve(1)
        .Some(_) => $abort("Reversed resolved bounds accepted")
        .None => Console.writeLine("Short target rejected.")

    let text: [2 of string] = ["First text.", "Last text."]
    let words = text[..]
    Console.writeLine(words[last]) // Borrow a Non-Copy element without consuming it.
    Console.writeLine(text[1])
    let number: i32 = 42
    let refs: [1 of ref/i32] = [number@ref]
    let copied: ref/i32 = reference: do
        let handles: Slice<ref/i32> = refs[..]
        exit to reference: handles[0] // Copy the inner reference, not a reference to the handle.
    require copied == 42 else => $abort("Element Origin was lost")
    Console.writeLine("Slice Origins preserved.")
