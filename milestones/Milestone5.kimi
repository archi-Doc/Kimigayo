// Milestone 5: exclusive/shared borrows, returned Origins, and Lifetime.
struct Counter
    public var value: i32 = 0
    deinit => Console.writeLine("Counter destroyed.")
    // All fields have initializers, so a public init() is synthesized.

struct CounterView {source}
    let counter: ref{source}/Counter

    public init(counter: ref{source}/Counter)
        self.counter = counter

    public func read(self: ref/Self) -> i32 => self.counter.value

    deinit
        // The referent must remain alive and unchanged through this use.
        if self.counter.value != 55
            $abort("Borrowed counter changed")
        Console.writeLine("View destroyed; counter is still 55.")

func add(counter: uniq/Counter, amount: i32)
    counter.value = counter.value + amount

func borrowCounter(counter: ref/Counter) -> ref{counter}/Counter
    return counter

func finish(counter: Counter)
    if counter.value != 56
        $abort("Unexpected final value")
    Console.writeLine("Final value is 56.")

public func main()
    var counter = Counter.init()
    var number: i32 = 1
    while number <= 10
        add(counter@uniq, number) // Each exclusive Loan ends after the call.
        number = number + 1

    do
        let view = CounterView.init(borrowCounter(counter@ref))
        if view.read() != 55
            $abort("Unexpected sum")
        Console.writeLine("Borrowed sum is 55.")
        // Mutating or moving counter here would conflict with view's deinit.
    // view is destroyed and its shared Loan has ended.

    add(counter@uniq, 1)
    finish(counter) // Move is valid after all dependent borrows have ended.
    Console.writeLine("Done.")
