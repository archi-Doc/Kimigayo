// Milestone 29: dynamic Array growth, insertion, replacement, removal and owning iteration.
struct Task
    public let id: i32
    public init(id: i32) => self.id = id
    deinit
        match self.id
            1 => Console.writeLine("Task 1 destroyed.")
            2 => Console.writeLine("Task 2 destroyed.")
            3 => Console.writeLine("Task 3 destroyed.")
            4 => Console.writeLine("Task 4 destroyed.")
            5 => Console.writeLine("Task 5 destroyed.")
            _ => Console.writeLine("Task 6 destroyed.")

func describe(tasks: ref/Array<Task>)
    // Length metadata shares access without reading or copying elements.
    match tasks.length
        0 => Console.writeLine("No tasks.")
        2 => Console.writeLine("Two tasks.")
        _ => Console.writeLine("Many tasks.")

public func main()
    var tasks: Array<Task> = [] // Length and capacity zero; nothing is allocated.
    describe(tasks@ref)
    tasks@uniq.reserve(additional: 4)
    require tasks.length == 0 and tasks.capacity >= 4 else => $abort("Reserve failed")
    tasks@uniq.append(Task.init(1))
    tasks@uniq.append(Task.init(3))
    tasks@uniq.insert(1, Task.init(2))  // Before position 1: [1, 2, 3].
    tasks@uniq.insert(^0, Task.init(4)) // From the end, ^0 appends: [1, 2, 3, 4].
    require tasks.length == 4 and tasks.capacity >= 4 else => $abort("Growth failed")
    describe(tasks@ref)
    let last = tasks@uniq.remove(^1) // Transfers Task 4 out; [1, 2, 3]; capacity is unchanged.
    require last.id == 4 and tasks.length == 3 else => $abort("Removal failed")
    Console.writeLine("Removed the last task.")
    tasks[0] = Task.init(5) // Indexed replacement destroys Task 1 first: [5, 2, 3].
    match tasks@uniq.pop()
        .Some(let popped)
            require popped.id == 3 else => $abort("Pop failed")
            Console.writeLine("Popped a task.")
            // popped is destroyed here, at the end of its arm.
        .None => $abort("Unexpected empty pop")
    describe(tasks@ref)
    var spare: Array<Task> = [Task.init(6)] // An independent literal constructs an Array.
    spare@uniq.clear() // Destroys every element in reverse index order; capacity is preserved.
    require spare.length == 0 and spare.capacity >= 1 else => $abort("Clear failed")
    Console.writeLine("Cleared the spare tasks.")
    for task in tasks@move // Owning iteration consumes the Array: Task 5, then Task 2.
        require task.id == 5 else => $abort("Iteration order failed")
        Console.writeLine("Iterating task 5.")
        exit // task is destroyed first; the iterator then destroys the unyielded Task 2.
    Console.writeLine("Array run finished.")
    // Scope exit destroys last (Task 4); spare is empty and tasks was consumed.
