// O2 timing corpus (O2Corpus.md): rc and arc creation, clone, shared reads, handles in an Array and the final release.
struct Payload
    public let value: i64
    public init(value: i64) => self.value = value

// One FNV-1a step over a round's sum, then an xorshift so the high bits reach the low ones: each part is invertible, so a wrong
// value in any round changes the checksum.
func fold(checksum: i64, value: i64) -> i64
    let mixed = ((checksum ^ (value & 0xFFFF_FFFF)) * 16777619) & 0xFFFF_FFFF
    return mixed ^ (mixed >> 16)

public func main()
    var checksum: i64 = 0
    for round in 0..1048576
        let owner = Kimi.Intrinsics.makeRc(Payload.init(round@i64))
        var sum: i64 = 0
        var handles: Array<rc/Payload> = []
        for k in 0..4
            handles.append(Kimi.Intrinsics.clone(owner@ref))
        for handle in handles@move
            sum += handle.value
        let shared = Kimi.Intrinsics.makeArc(Payload.init(3))
        do
            let copy = Kimi.Intrinsics.clone(shared@ref)
            sum += copy.value
        checksum = fold(checksum, sum + shared.value + owner.value)
    Console.writeLine("checksum \(checksum)")
