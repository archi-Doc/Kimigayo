is_global = true

# Lists use commas (semicolons start comments). Architecture policy is enforced by KR1001–KR1003.
kimi_code_rules.stage = R4
kimi_code_rules.scope.accretion.exclude = src/Kimi/Compiler/Analysis/,src/Kimi/Compiler/Emission/
kimi_code_rules.scope.density.exclude = src/Kimi/Compiler/Analysis/,src/Kimi/Compiler/Emission/
kimi_code_rules.scope.syntax_dispatch.include = src/Kimi/Compiler/Mir/Build/
kimi_code_rules.catch_boundaries = src/Kimi/Unit/,src/Kimi/Lsp/,src/Kimi/Testing/

kimi_code_rules.max_line_length = 160
kimi_code_rules.max_parameters = 6
kimi_code_rules.max_optional_parameters = 2
kimi_code_rules.max_out_parameters = 1
kimi_code_rules.max_bool_parameters = 1
kimi_code_rules.max_statements = 60
kimi_code_rules.max_nesting_depth = 4
kimi_code_rules.max_logical_operands = 4
kimi_code_rules.max_file_tokens = 5000

# Dependency policy. Longest path prefix wins, /*.cs matches direct children only.
kimi_code_rules.layer.syntax = src/Kimi/Compiler/Lexing/,src/Kimi/Compiler/Parsing/
kimi_code_rules.layer.binding = src/Kimi/Compiler/Binding/
kimi_code_rules.layer.compiler_root = src/Kimi/Compiler/*.cs
kimi_code_rules.layer.legacy = src/Kimi/Compiler/Analysis/,src/Kimi/Compiler/Emission/
kimi_code_rules.layer.mir_build = src/Kimi/Compiler/Mir/Build/
kimi_code_rules.layer.mir = src/Kimi/Compiler/Mir/
kimi_code_rules.layer.hover = src/Kimi/Checking/Hover/
kimi_code_rules.deny_types.syntax = Kimi.Compiler.Binding
kimi_code_rules.deny_types.hover = Kimi.Compiler.Binding
kimi_code_rules.deny_layers.mir_build = binding,compiler_root,legacy
kimi_code_rules.deny_layers.mir = binding,compiler_root,legacy,syntax
kimi_code_rules.allow_types.mir_build = Kimi.Compiler.AdtDef,Kimi.Compiler.BindingSymbol,Kimi.Compiler.BindingSymbolKind,Kimi.Compiler.BoundArgumentOperation,Kimi.Compiler.BoundCapture,Kimi.Compiler.BoundClosure,Kimi.Compiler.BoundDefaultArgument,Kimi.Compiler.BoundEnumCase,Kimi.Compiler.BoundEnumConstruction,Kimi.Compiler.BoundLength,Kimi.Compiler.BoundMatch,Kimi.Compiler.BoundMatchArm,Kimi.Compiler.BoundOrigin,Kimi.Compiler.BoundPattern,Kimi.Compiler.BoundPatternKind,Kimi.Compiler.BoundType,Kimi.Compiler.BoundTypeKind,Kimi.Compiler.BuiltinForm,Kimi.Compiler.CallPlan,Kimi.Compiler.CalleeKind,Kimi.Compiler.CompilerFunctionKind,Kimi.Compiler.ConversionBinding,Kimi.Compiler.DefaultDecl,Kimi.Compiler.DispositionKind,Kimi.Compiler.ExpansionKind,Kimi.Compiler.ExpansionPlan,Kimi.Compiler.FunctionResultMode,Kimi.Compiler.HirAcquire,Kimi.Compiler.HirAdaptation,Kimi.Compiler.HirAdjust,Kimi.Compiler.HirCompletion,Kimi.Compiler.HirOp,Kimi.Compiler.HirPlace,Kimi.Compiler.HirPlaceKind,Kimi.Compiler.HirRes,Kimi.Compiler.HirTables,Kimi.Compiler.IntrinsicDisposition,Kimi.Compiler.IntrinsicId,Kimi.Compiler.KimiLibrary,Kimi.Compiler.PairBinder,Kimi.Compiler.PairCase,Kimi.Compiler.PatternLiteral,Kimi.Compiler.PatternLiteralKind,Kimi.Compiler.PlanRow,Kimi.Compiler.Subst,Kimi.Compiler.TestDefinition,Kimi.Compiler.TyCtxt
kimi_code_rules.allow_types.mir = Kimi.Compiler.AdtDef,Kimi.Compiler.BindingSymbol,Kimi.Compiler.BindingSymbolKind,Kimi.Compiler.BoundCapture,Kimi.Compiler.BoundDefaultArgument,Kimi.Compiler.BoundEnumCase,Kimi.Compiler.BoundEnumConstruction,Kimi.Compiler.BoundLength,Kimi.Compiler.BoundMatchArm,Kimi.Compiler.BoundOrigin,Kimi.Compiler.BoundPattern,Kimi.Compiler.BoundPatternKind,Kimi.Compiler.BoundType,Kimi.Compiler.BoundTypeKind,Kimi.Compiler.BuiltinForm,Kimi.Compiler.CalleeKind,Kimi.Compiler.CompilerFunctionKind,Kimi.Compiler.ConversionBinding,Kimi.Compiler.DispositionKind,Kimi.Compiler.ExpansionKind,Kimi.Compiler.FunctionResultMode,Kimi.Compiler.IntrinsicDisposition,Kimi.Compiler.IntrinsicId,Kimi.Compiler.KimiLibrary,Kimi.Compiler.PairBinder,Kimi.Compiler.PairCase,Kimi.Compiler.PatternLiteral,Kimi.Compiler.PatternLiteralKind,Kimi.Compiler.Subst,Kimi.Compiler.TestDefinition,Kimi.Compiler.TyCtxt
