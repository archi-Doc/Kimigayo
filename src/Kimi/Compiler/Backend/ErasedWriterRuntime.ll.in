; The erased writer's kept runtime (SPEC 22.9.4, 22.10.1): the call of a Writer's reserve through the adapter's dispatch word
; with the window check (ErasedReserve). Adapter offsets: destination 0, dispatch 8 (Utf8Writer's first two Fields, which
; Text.writer's body stores). A Result has an i32 tag (Ok=0, Err=1) and its window {state, start, written, remaining} at byte 8.

; A window from the Writer's reserve is accepted only with written == 0 and remaining >= amount; otherwise the result is
; BufferFull, and the caller records the failure.
{{__kimi_erased_reserve}}
entry:
  %destination = load ptr, ptr %writer, align 8
  %functionp = getelementptr i8, ptr %writer, i64 8
  %function = load ptr, ptr %functionp, align 8
  call void %function(ptr %ret, ptr %destination, i64 %amount)
  %tag = load i32, ptr %ret, align 4
  %ok = icmp eq i32 %tag, 0
  br i1 %ok, label %validate, label %done
validate:
  %writtenp = getelementptr i8, ptr %ret, i64 24
  %remainingp = getelementptr i8, ptr %ret, i64 32
  %written = load i64, ptr %writtenp, align 8
  %remaining = load i64, ptr %remainingp, align 8
  %empty = icmp eq i64 %written, 0
  %enough = icmp sge i64 %remaining, %amount
  %valid = and i1 %empty, %enough
  br i1 %valid, label %done, label %invalid
invalid:
  store i32 1, ptr %ret, align 4
  br label %done
done:
  ret void
}
