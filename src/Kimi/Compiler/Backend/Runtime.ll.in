; The common internal runtime of every target: output, Abort, allocation and string release over the platform layer's routines
; (WindowsPlatform.ll.in on windows-x64), which own every operating system call of the runtime, and Kimi's allocator (HeapRuntime.ll.in).
; Definitions receive the Backend's common #0 profile.
; No buffer allocation, encoding conversion, CRT startup or exception unwinding.
@__kimi_lf = private constant [1 x i8] c"\0A"
@__kimi_abort_prefix = private constant [8 x i8] c": abort "
@__kimi_explicit_abort = private constant [14 x i8] c"KIMI_E_ABORT: "
@__kimi_close = private constant [1 x i8] c")"
{{abort_reasons}}

; Stream 1 is standard output and 2 standard error. -1 = success; {{no_os_error}} = failure without an OS error; otherwise the
; layer's OS error. Allocation validity/lifetime is established by checked lowering, not by these numeric checks.
define internal i64 @__kimi_write_bytes(i32 %stream, ptr %data, i64 %length) #0 {
entry:
  %empty = icmp eq i64 %length, 0
  br i1 %empty, label %success, label %range
range:
  %too_large = icmp ugt i64 %length, 9223372036854775807
  %null = icmp eq ptr %data, null
  %bad = or i1 %too_large, %null
  br i1 %bad, label %failure, label %address
address:
  %base = ptrtoint ptr %data to i64
  %last_offset = sub i64 %length, 1
  %last = add i64 %base, %last_offset
  %overflow = icmp ult i64 %last, %base
  br i1 %overflow, label %failure, label %write
write:
  ; The checked last address bounds every advance of the layer's write.
  %error = call i64 @__kimi_write(i32 %stream, ptr %data, i64 %length)
  ret i64 %error
failure:
  ret i64 {{no_os_error}}
success:
  ret i64 -1
}

define internal i1 @__kimi_try_stderr(ptr %data, i64 %length) #0 {
entry:
  %error = call i64 @__kimi_write_bytes(i32 2, ptr %data, i64 %length)
  %ok = icmp eq i64 %error, -1
  ret i1 %ok
}

; The owned message is evaluated/acquired before entry. Abort never destroys it.
{{__kimi_abort_message}}
entry:
  %located = call i1 @__kimi_try_stderr(ptr %location, i64 %location_length)
  br i1 %located, label %prefix, label %exit
prefix:
  %prefixed = call i1 @__kimi_try_stderr(ptr @__kimi_abort_prefix, i64 8)
  br i1 %prefixed, label %code, label %exit
code:
  %coded = call i1 @__kimi_try_stderr(ptr @__kimi_explicit_abort, i64 14)
  br i1 %coded, label %message, label %exit
message:
  %data = load ptr, ptr %text, align 8
  %length_ptr = getelementptr %kimi.string, ptr %text, i32 0, i32 1
  %length = load i64, ptr %length_ptr, align 8
  %messaged = call i1 @__kimi_try_stderr(ptr %data, i64 %length)
  br i1 %messaged, label %newline, label %exit
newline:
  %ignored = call i1 @__kimi_try_stderr(ptr @__kimi_lf, i64 1)
  br label %exit
exit:
  call void @__kimi_exit(i32 1)
  unreachable
}

; The OS error follows the layer's prefix, whose length the layer's definition gives.
{{__kimi_abort}}
entry:
  %digits = alloca [10 x i8], align 1
  %known = icmp ult i32 %reason, {{abort_reason_count}}
  br i1 %known, label %location_output, label %exit
location_output:
  %located = call i1 @__kimi_try_stderr(ptr %location, i64 %location_length)
  br i1 %located, label %prefix, label %exit
prefix:
  %prefixed = call i1 @__kimi_try_stderr(ptr @__kimi_abort_prefix, i64 8)
  br i1 %prefixed, label %message, label %exit
message:
  %record = getelementptr [{{abort_reason_count}} x { ptr, i64 }], ptr @__kimi_reasons, i32 0, i32 %reason
  %record_value = load { ptr, i64 }, ptr %record, align 8
  %data = extractvalue { ptr, i64 } %record_value, 0
  %length = extractvalue { ptr, i64 } %record_value, 1
  %messaged = call i1 @__kimi_try_stderr(ptr %data, i64 %length)
  br i1 %messaged, label %os, label %exit
os:
  %has_error = icmp sge i64 %os_error, 0
  br i1 %has_error, label %decimal, label %newline
decimal:
  %value = phi i64 [ %os_error, %os ], [ %quotient, %decimal ]
  %index = phi i32 [ 10, %os ], [ %digit_index, %decimal ]
  %digit_index = sub i32 %index, 1
  %remainder = urem i64 %value, 10
  %quotient = udiv i64 %value, 10
  %byte = trunc i64 %remainder to i8
  %ascii = add i8 %byte, 48
  %digit_ptr = getelementptr [10 x i8], ptr %digits, i32 0, i32 %digit_index
  store i8 %ascii, ptr %digit_ptr, align 1
  %more = icmp ne i64 %quotient, 0
  br i1 %more, label %decimal, label %os_prefix
os_prefix:
  %os_prefixed = call i1 @__kimi_try_stderr(ptr @__kimi_os_prefix, i64 {{os_prefix_length}})
  br i1 %os_prefixed, label %number, label %exit
number:
  %digit_count = sub i32 10, %digit_index
  %digit_length = zext i32 %digit_count to i64
  %numbered = call i1 @__kimi_try_stderr(ptr %digit_ptr, i64 %digit_length)
  br i1 %numbered, label %close, label %exit
close:
  %closed = call i1 @__kimi_try_stderr(ptr @__kimi_close, i64 1)
  br i1 %closed, label %newline, label %exit
newline:
  %ignored = call i1 @__kimi_try_stderr(ptr @__kimi_lf, i64 1)
  br label %exit
exit:
  call void @__kimi_exit(i32 1)
  unreachable
}

define internal void @__kimi_stdout(ptr %data, i64 %length, ptr %location, i64 %location_length) #0 {
entry:
  %error = call i64 @__kimi_write_bytes(i32 1, ptr %data, i64 %length)
  %ok = icmp eq i64 %error, -1
  br i1 %ok, label %done, label %abort
abort:
  call void @__kimi_abort(i32 {{reason_stdout}}, ptr %location, i64 %location_length, i64 %error)
  unreachable
done:
  ret void
}

; A block of the allocator; no pages for it Aborts at the location without an OS error.
define internal ptr @__kimi_alloc(i64 %size, ptr %location, i64 %location_length) #0 {
entry:
  %invalid = icmp ugt i64 %size, 9223372036854775807
  br i1 %invalid, label %size_failure, label %allocate
allocate:
  %memory = call ptr @__kimi_heap_allocate(i64 %size)
  %failed = icmp eq ptr %memory, null
  br i1 %failed, label %alloc_failure, label %done
size_failure:
  call void @__kimi_abort(i32 {{reason_size}}, ptr %location, i64 %location_length, i64 {{no_os_error}})
  unreachable
alloc_failure:
  call void @__kimi_abort(i32 {{reason_alloc}}, ptr %location, i64 %location_length, i64 {{no_os_error}})
  unreachable
done:
  ret ptr %memory
}

; SPEC 5.6: a negative count (as for Array capacity) or an unrepresentable byte size Aborts; zero bytes return the nonnull substitute {{zero_sized_buffer}}, which
; is aligned for every supported element and which __kimi_free ignores.
define internal ptr @__kimi_raw_allocate(i64 %count, i64 %stride, ptr %location, i64 %location_length) #0 {
entry:
  %negative = icmp slt i64 %count, 0
  br i1 %negative, label %argument_failure, label %measure
measure:
  %empty_stride = icmp eq i64 %stride, 0
  %empty_count = icmp eq i64 %count, 0
  %empty = or i1 %empty_stride, %empty_count
  br i1 %empty, label %substitute, label %bound
bound:
  %limit = udiv i64 9223372036854775807, %stride
  %overflow = icmp ugt i64 %count, %limit
  br i1 %overflow, label %size_failure, label %heap
heap:
  %size = mul i64 %count, %stride
  %memory = call ptr @__kimi_alloc(i64 %size, ptr %location, i64 %location_length)
  ret ptr %memory
substitute:
  ret ptr inttoptr (i64 {{zero_sized_buffer}} to ptr)
size_failure:
  call void @__kimi_abort(i32 {{reason_size}}, ptr %location, i64 %location_length, i64 {{no_os_error}})
  unreachable
argument_failure:
  call void @__kimi_abort(i32 {{reason_argument_range}}, ptr %location, i64 %location_length, i64 {{no_os_error}})
  unreachable
}

define internal void @__kimi_free(ptr %memory, ptr %location, i64 %location_length) #0 {
entry:
  ; Null and the zero-sized-element buffer substitute lie below the unmapped bound, where the layer's pages never lie.
  %address = ptrtoint ptr %memory to i64
  %reserved = icmp ult i64 %address, {{unmapped_bound}}
  br i1 %reserved, label %done, label %release
release:
  %error = call i64 @__kimi_heap_release(ptr %memory)
  %failed = icmp ne i64 %error, -1
  br i1 %failed, label %free_failure, label %done
free_failure:
  call void @__kimi_abort(i32 {{reason_free}}, ptr %location, i64 %location_length, i64 %error)
  unreachable
done:
  ret void
}

{{__kimi_destroy_string}}
entry:
  %kind_ptr = getelementptr %kimi.string, ptr %text, i32 0, i32 2
  %kind = load i8, ptr %kind_ptr, align 1
  switch i8 %kind, label %invalid [ i8 {{static_release_kind}}, label %done
                                  i8 {{heap_release_kind}}, label %heap ]
heap:
  %data = load ptr, ptr %text, align 8
  call void @__kimi_free(ptr %data, ptr %location, i64 %location_length)
  br label %done
invalid:
  call void @__kimi_abort(i32 {{reason_release}}, ptr %location, i64 %location_length, i64 {{no_os_error}})
  unreachable
done:
  ret void
}
