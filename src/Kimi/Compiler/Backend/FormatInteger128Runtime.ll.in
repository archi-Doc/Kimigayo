; SPEC 22.10.2: the FormatInteger128 intrinsic's routine (Storage.formatInteger128, R8-S2b2), a module part on request
; (LlvmModuleText.FormatInteger128), interim by RQ16 (a). It writes the ASCII decimal digits of the u128 %value at the end of the
; 40-byte %destination and returns their count, 1 to 39: no sign, no leading zero, 0 for zero; exactly those bytes and no other.
; The text is ASCII, so valid UTF-8. It allocates nothing and never Aborts.
; Base-2^32 long division avoids the compiler-rt dependency of an i128 division at O0 (IMPL 21.3.3); a value below 2^64
; takes the native 64-bit path.
define internal { i128, i8 } @__kimi_decimal_div10(i128 %value) #0 {
entry:
  %high = lshr i128 %value, 64
  %small = icmp eq i128 %high, 0
  br i1 %small, label %narrow, label %wide
narrow:
  %value64 = trunc i128 %value to i64
  %q64 = udiv i64 %value64, 10
  %r64 = urem i64 %value64, 10
  %q128 = zext i64 %q64 to i128
  %r8 = trunc i64 %r64 to i8
  %a = insertvalue { i128, i8 } poison, i128 %q128, 0
  %b = insertvalue { i128, i8 } %a, i8 %r8, 1
  ret { i128, i8 } %b
wide:
  %shift3 = lshr i128 %value, 96
  %part3 = trunc i128 %shift3 to i32
  %limb3 = zext i32 %part3 to i64
  %quot3 = udiv i64 %limb3, 10
  %rem3 = urem i64 %limb3, 10
  %extend3 = zext i64 %quot3 to i128
  %position3 = shl i128 %extend3, 96
  %shift2 = lshr i128 %value, 64
  %part2 = trunc i128 %shift2 to i32
  %limb2 = zext i32 %part2 to i64
  %carry2 = shl i64 %rem3, 32
  %dividend2 = or i64 %carry2, %limb2
  %quot2 = udiv i64 %dividend2, 10
  %rem2 = urem i64 %dividend2, 10
  %extend2 = zext i64 %quot2 to i128
  %position2 = shl i128 %extend2, 64
  %shift1 = lshr i128 %value, 32
  %part1 = trunc i128 %shift1 to i32
  %limb1 = zext i32 %part1 to i64
  %carry1 = shl i64 %rem2, 32
  %dividend1 = or i64 %carry1, %limb1
  %quot1 = udiv i64 %dividend1, 10
  %rem1 = urem i64 %dividend1, 10
  %extend1 = zext i64 %quot1 to i128
  %position1 = shl i128 %extend1, 32
  %part0 = trunc i128 %value to i32
  %limb0 = zext i32 %part0 to i64
  %carry0 = shl i64 %rem1, 32
  %dividend0 = or i64 %carry0, %limb0
  %quot0 = udiv i64 %dividend0, 10
  %rem0 = urem i64 %dividend0, 10
  %extend0 = zext i64 %quot0 to i128
  %upper = or i128 %position3, %position2
  %lower = or i128 %position1, %extend0
  %quotient = or i128 %upper, %lower
  %remainder = trunc i64 %rem0 to i8
  %c = insertvalue { i128, i8 } poison, i128 %quotient, 0
  %d = insertvalue { i128, i8 } %c, i8 %remainder, 1
  ret { i128, i8 } %d
}

{{__kimi_format_integer128}}
entry:
  br label %digits
digits:
  %number = phi i128 [ %value, %entry ], [ %quotient, %digits ]
  %position = phi i64 [ 40, %entry ], [ %index, %digits ]
  %division = call { i128, i8 } @__kimi_decimal_div10(i128 %number)
  %quotient = extractvalue { i128, i8 } %division, 0
  %digit = extractvalue { i128, i8 } %division, 1
  %ascii = add i8 %digit, 48
  %index = sub i64 %position, 1
  %address = getelementptr i8, ptr %destination, i64 %index
  store i8 %ascii, ptr %address, align 1
  %again = icmp ne i128 %quotient, 0
  br i1 %again, label %digits, label %done
done:
  %count = sub i64 40, %index
  ret i64 %count
}
