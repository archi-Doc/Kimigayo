; Checked buffer runtime: {data, capacity, length, validated}, Window: {state, start, written, remaining}.
; Result has i32 tag (Ok=0, Err=1), with nonempty aligned payload at byte 8.
; The adapter's routine __kimi_text_writer is the kept ErasedWriterRuntime.ll.in's.

{{__kimi_write_line_utf8}}
entry:
  %data = load ptr, ptr %self, align 8
  %len = getelementptr i8, ptr %self, i64 8
  %length = load i64, ptr %len, align 8
  call void @__kimi_stdout(ptr %data, i64 %length, ptr %location, i64 %location_length)
  call void @__kimi_stdout(ptr @__kimi_lf, i64 1, ptr %location, i64 %location_length)
  ret void
}

{{__kimi_text_fixed}}
entry:
  store ptr %self, ptr %ret, align 8
  %cap = getelementptr i8, ptr %ret, i64 8
  %len = getelementptr i8, ptr %ret, i64 16
  %valid = getelementptr i8, ptr %ret, i64 24
  store i64 %capacity, ptr %cap, align 8
  store i64 0, ptr %len, align 8
  store i64 0, ptr %valid, align 8
  ret void
}

{{__kimi_text_heap}}
entry:
  %negative = icmp slt i64 %capacity, 0
  br i1 %negative, label %invalid, label %check
check:
  %empty = icmp eq i64 %capacity, 0
  br i1 %empty, label %done, label %allocate
allocate:
  %allocated = call ptr @__kimi_alloc(i64 %capacity, ptr %location, i64 %location_length)
  br label %done
done:
  %data = phi ptr [ null, %check ], [ %allocated, %allocate ]
  call void @__kimi_text_fixed(ptr %ret, ptr %data, i64 %capacity)
  ret void
invalid:
  call void @__kimi_abort(i32 {{reason_argument_range}}, ptr %location, i64 %location_length, i64 {{no_os_error}})
  unreachable
}

; The committed bytes as a Slice, for the formatting adapter and the conversions until W1c and W2.
define internal void @__kimi_buffer_bytes(ptr %ret, ptr %self) #0 {
entry:
  %data = load ptr, ptr %self, align 8
  %len = getelementptr i8, ptr %self, i64 16
  %length = load i64, ptr %len, align 8
  store ptr %data, ptr %ret, align 8
  %outlen = getelementptr i8, ptr %ret, i64 8
  store i64 %length, ptr %outlen, align 8
  ret void
}

; Hints affect growth only. Fixed buffers fail without changing committed bytes or length.
define internal void @__kimi_buffer_reserve(ptr %ret, ptr %self, i64 %amount, i1 %heap, i64 %hint, ptr %location, i64 %location_length) #0 {
entry:
  %negative = icmp slt i64 %amount, 0
  br i1 %negative, label %invalid, label %check
check:
  %capptr = getelementptr i8, ptr %self, i64 8
  %lenptr = getelementptr i8, ptr %self, i64 16
  %capacity = load i64, ptr %capptr, align 8
  %length = load i64, ptr %lenptr, align 8
  %room = sub i64 %capacity, %length
  %fits = icmp ule i64 %amount, %room
  br i1 %fits, label %success, label %growcheck
growcheck:
  br i1 %heap, label %check_size, label %full
check_size:
  %maximum = sub i64 9223372036854775807, %length
  %overflow = icmp ugt i64 %amount, %maximum
  br i1 %overflow, label %size_failure, label %target
target:
  %required = add i64 %length, %amount
  %hintroom = sub i64 9223372036854775807, %required
  %badhint = icmp ugt i64 %hint, %hintroom
  %safehint = select i1 %badhint, i64 0, i64 %hint
  %hinted = add i64 %required, %safehint
  %doublefits = icmp ule i64 %capacity, 4611686018427387903
  %doubled = shl i64 %capacity, 1
  %safe = select i1 %doublefits, i64 %doubled, i64 %hinted
  %large = icmp ugt i64 %safe, %hinted
  %newcapacity = select i1 %large, i64 %safe, i64 %hinted
  %memory = call ptr @__kimi_alloc(i64 %newcapacity, ptr %location, i64 %location_length)
  %old = load ptr, ptr %self, align 8
  %empty = icmp eq i64 %length, 0
  br i1 %empty, label %replace, label %copy
copy:
  call void @llvm.memcpy.p0.p0.i64(ptr %memory, ptr %old, i64 %length, i1 false)
  br label %replace
replace:
  call void @__kimi_free(ptr %old, ptr %location, i64 %location_length)
  store ptr %memory, ptr %self, align 8
  store i64 %newcapacity, ptr %capptr, align 8
  br label %success
success:
  %actual = load i64, ptr %capptr, align 8
  %remaining = sub i64 %actual, %length
  store i32 0, ptr %ret, align 4
  %window = getelementptr i8, ptr %ret, i64 8
  %start = getelementptr i8, ptr %window, i64 8
  %written = getelementptr i8, ptr %window, i64 16
  %rest = getelementptr i8, ptr %window, i64 24
  store ptr %self, ptr %window, align 8
  store i64 %length, ptr %start, align 8
  store i64 0, ptr %written, align 8
  store i64 %remaining, ptr %rest, align 8
  ret void
full:
  store i32 1, ptr %ret, align 4
  ret void
invalid:
  call void @__kimi_abort(i32 {{reason_argument_range}}, ptr %location, i64 %location_length, i64 {{no_os_error}})
  unreachable
size_failure:
  call void @__kimi_abort(i32 {{reason_size}}, ptr %location, i64 %location_length, i64 {{no_os_error}})
  unreachable
}

define internal ptr @__kimi_window_address(ptr %self) #0 {
entry:
  %state = load ptr, ptr %self, align 8
  %data = load ptr, ptr %state, align 8
  %startptr = getelementptr i8, ptr %self, i64 8
  %writtenptr = getelementptr i8, ptr %self, i64 16
  %start = load i64, ptr %startptr, align 8
  %written = load i64, ptr %writtenptr, align 8
  %offset = add i64 %start, %written
  %address = getelementptr i8, ptr %data, i64 %offset
  ret ptr %address
}

define internal void @__kimi_window_advance(ptr %self, i64 %amount) #0 {
entry:
  %writtenptr = getelementptr i8, ptr %self, i64 16
  %restptr = getelementptr i8, ptr %self, i64 24
  %written = load i64, ptr %writtenptr, align 8
  %rest = load i64, ptr %restptr, align 8
  %newwritten = add i64 %written, %amount
  %newrest = sub i64 %rest, %amount
  store i64 %newwritten, ptr %writtenptr, align 8
  store i64 %newrest, ptr %restptr, align 8
  ret void
}
