; Strict Unicode Scalar Value validation; NUL is ordinary ASCII. Bounds precede each sequence.
define internal i1 @__kimi_utf8_valid(ptr %data, i64 %length) #0 {
entry:
  br label %loop
loop:
  %index = phi i64 [ 0, %entry ], [ %next, %ascii ], [ %end, %scalar ]
  %done = icmp eq i64 %index, %length
  br i1 %done, label %yes, label %read
read:
  %at = getelementptr i8, ptr %data, i64 %index
  %lead8 = load i8, ptr %at, align 1
  %lead = zext i8 %lead8 to i32
  %simple = icmp ult i32 %lead, 128
  br i1 %simple, label %ascii, label %classify
ascii:
  %next = add i64 %index, 1
  br label %loop
classify:
  %low = icmp ult i32 %lead, 194
  %high = icmp ugt i32 %lead, 244
  %badlead = or i1 %low, %high
  br i1 %badlead, label %no, label %width
width:
  %two = icmp ult i32 %lead, 224
  %three = icmp ult i32 %lead, 240
  %wide = select i1 %three, i64 3, i64 4
  %count = select i1 %two, i64 2, i64 %wide
  %mask3 = select i1 %three, i32 15, i32 7
  %mask = select i1 %two, i32 31, i32 %mask3
  %min3 = select i1 %three, i32 2048, i32 65536
  %minimum = select i1 %two, i32 128, i32 %min3
  %initial = and i32 %lead, %mask
  %remaining = sub i64 %length, %index
  %short = icmp ult i64 %remaining, %count
  br i1 %short, label %no, label %prepare
prepare:
  %end = add i64 %index, %count
  %first = add i64 %index, 1
  br label %continuation
continuation:
  %cursor = phi i64 [ %first, %prepare ], [ %advance, %accumulate ]
  %prefix = phi i32 [ %initial, %prepare ], [ %codepoint, %accumulate ]
  %address = getelementptr i8, ptr %data, i64 %cursor
  %byte = load i8, ptr %address, align 1
  %top = and i8 %byte, -64
  %valid = icmp eq i8 %top, -128
  br i1 %valid, label %accumulate, label %no
accumulate:
  %bits8 = and i8 %byte, 63
  %bits = zext i8 %bits8 to i32
  %shifted = shl i32 %prefix, 6
  %codepoint = or i32 %shifted, %bits
  %advance = add i64 %cursor, 1
  %last = icmp eq i64 %advance, %end
  br i1 %last, label %scalar, label %continuation
scalar:
  %overlong = icmp ult i32 %codepoint, %minimum
  %excess = icmp ugt i32 %codepoint, 1114111
  %surrogate_offset = sub i32 %codepoint, 55296
  %surrogate = icmp ult i32 %surrogate_offset, 2048
  %bad_range = or i1 %overlong, %excess
  %bad_scalar = or i1 %bad_range, %surrogate
  br i1 %bad_scalar, label %no, label %loop
yes:
  ret i1 true
no:
  ret i1 false
}

define internal i1 @__kimi_buffer_valid(ptr %self) #0 {
entry:
  %len = getelementptr i8, ptr %self, i64 16
  %valid = getelementptr i8, ptr %self, i64 24
  %length = load i64, ptr %len, align 8
  %validated = load i64, ptr %valid, align 8
  %known = icmp eq i64 %length, %validated
  br i1 %known, label %yes, label %scan
scan:
  %data = load ptr, ptr %self, align 8
