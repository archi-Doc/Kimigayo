; Checked buffer runtime: {data, capacity, length, validated}, Window: {state, start, written, remaining}.
; Result has i32 tag (Ok=0, Err=1), with nonempty aligned payload at byte 8.
declare void @llvm.memset.p0.i64(ptr nocapture writeonly, i8, i64, i1 immarg)

{{__kimi_text_writer}}
entry:
