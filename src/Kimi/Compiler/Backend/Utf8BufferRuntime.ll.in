  store ptr %self, ptr %ret, align 8
  %dispatchp = getelementptr i8, ptr %ret, i64 8
  %kindp = getelementptr i8, ptr %ret, i64 16
  store ptr %dispatch, ptr %dispatchp, align 8
  store i64 %kind, ptr %kindp, align 8
  ret void
}

