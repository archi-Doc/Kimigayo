; none-x64-v1 platform layer of a freestanding x86-64 program booted by Limine (IMPL 21.6; the Tatara plan's decisions 30
; and 31): Limine's base-revision tag and its higher-half direct map and memory map requests (base revision 6, Limine's PROTOCOL.md at
; limine-protocol c5a7f597a, implemented by Limine v11.2.1), the boot that passes their answers to the program's platform, and the
; routines through which the common runtime (Runtime.ll.in) writes and exits, its allocator (HeapRuntime.ll.in) maps and releases pages
; and Kimi.Time reads the clock, each over the program's platform member through its adapter (__kimi_platform_member_<member>, which
; ModuleCodegen's frame defines). A routine tests the busy flag, sets it, calls its adapter, clears it and maps the result: a member
; call while a member runs, an Abort's report included, halts the processor with interrupts disabled, without a report. No system call,
; no import and no adapter declaration; the template makes no other call of the program.

@__kimi_os_prefix = private constant [{{os_prefix_length}} x i8] c"{{os_prefix}}"

; Limine's requests, the program's, of which the loader writes only the base-revision tag's words and the response pointers before
; the entry: the start marker, the base-revision tag (the loader sets its third word to 0 when it accepts the revision), the two
; requests (id, revision 0, the response pointer the loader sets) and the end marker, each 8-byte aligned, in the sections the linker
; script orders and keeps. @llvm.compiler.used keeps them through the IR passes.
@__kimi_limine_start = internal global [4 x i64] [i64 u0xf6b8f4b39de7d1ae, i64 u0xfab91a6940fcb9cf, i64 u0x785c6ed015d3e316, i64 u0x181e920a7852b9d9], section ".limine_requests_start", align 8
@__kimi_limine_base_revision = internal global [3 x i64] [i64 u0xf9562b2d5c95a6c8, i64 u0x6a7b384944536bdc, i64 6], section ".limine_requests", align 8
@__kimi_limine_hhdm = internal global { [4 x i64], i64, ptr } { [4 x i64] [i64 u0xc7b1dd30df4c8b88, i64 u0x0a82e883a194f07b, i64 u0x48dcf1cb8ad2b852, i64 u0x63984e959a98244b], i64 0, ptr null }, section ".limine_requests", align 8
@__kimi_limine_memmap = internal global { [4 x i64], i64, ptr } { [4 x i64] [i64 u0xc7b1dd30df4c8b88, i64 u0x0a82e883a194f07b, i64 u0x67cf3d9d378a806f, i64 u0xe304acdfc50c3c62], i64 0, ptr null }, section ".limine_requests", align 8
@__kimi_limine_end = internal global [2 x i64] [i64 u0xadc0e0531bb10d03, i64 u0x9572709f31764c62], section ".limine_requests_end", align 8
@llvm.compiler.used = appending global [5 x ptr] [ptr @__kimi_limine_start, ptr @__kimi_limine_base_revision, ptr @__kimi_limine_hhdm, ptr @__kimi_limine_memmap, ptr @__kimi_limine_end], section "llvm.metadata"

; Set while a platform member runs (never i1 in memory).
@__kimi_platform_busy = internal global i8 0, align 1

; The processor halted with interrupts disabled, for good.
define internal void @__kimi_halt() noreturn #0 {
entry:
  br label %halt
halt:
  call void asm sideeffect "cli\0Ahlt", "~{memory},~{dirflag},~{fpsr},~{flags}"()
  br label %halt
}

; The loader's answers into a Kimi.Boot (C layout: directMapOffset at 0, regions at 8, regionCount at 16): the tag's third word and the
; two response pointers are read volatile, since the loader writes them outside the program. A revision the loader did not accept or a
; request it did not answer halts.
define internal void @__kimi_boot(ptr %boot) #0 {
entry:
  %accepted_slot = getelementptr i8, ptr @__kimi_limine_base_revision, i64 16
  %accepted = load volatile i64, ptr %accepted_slot, align 8
  %hhdm_slot = getelementptr i8, ptr @__kimi_limine_hhdm, i64 40
  %hhdm = load volatile ptr, ptr %hhdm_slot, align 8
  %memmap_slot = getelementptr i8, ptr @__kimi_limine_memmap, i64 40
  %memmap = load volatile ptr, ptr %memmap_slot, align 8
  %refused = icmp ne i64 %accepted, 0
  %no_hhdm = icmp eq ptr %hhdm, null
  %no_memmap = icmp eq ptr %memmap, null
  %unanswered = or i1 %no_hhdm, %no_memmap
  %failed = or i1 %refused, %unanswered
  br i1 %failed, label %halt, label %answered
halt:
  call void @__kimi_halt()
  unreachable
answered:
  %offset_slot = getelementptr i8, ptr %hhdm, i64 8
  %offset = load i64, ptr %offset_slot, align 8
  %count_slot = getelementptr i8, ptr %memmap, i64 8
  %count = load i64, ptr %count_slot, align 8
  %entries_slot = getelementptr i8, ptr %memmap, i64 16
  %entries = load ptr, ptr %entries_slot, align 8
  store i64 %offset, ptr %boot, align 8
  %regions = getelementptr i8, ptr %boot, i64 8
  store ptr %entries, ptr %regions, align 8
  %region_count = getelementptr i8, ptr %boot, i64 16
  store i64 %count, ptr %region_count, align 8
  ret void
}

; Compiler-facing definitions are expanded from RuntimeAbi FunctionAbi records. Each routine has one shape: the flag's test (set: halt),
; its set, the adapter's call, its clear, then the result's mapping.
; The platform's start: the loader's answers in a Boot local, passed to the program's start, which stores the platform value.
{{__kimi_platform_start}}
entry:
  %boot = alloca [24 x i8], align 8
  %busy = load i8, ptr @__kimi_platform_busy, align 1
  %reentered = icmp ne i8 %busy, 0
  br i1 %reentered, label %halt, label %call
halt:
  call void @__kimi_halt()
  unreachable
call:
  store i8 1, ptr @__kimi_platform_busy, align 1
  call void @__kimi_boot(ptr %boot)
  call void @__kimi_platform_member_start(ptr %boot)
  store i8 0, ptr @__kimi_platform_busy, align 1
  ret void
}

; The platform's terminate, which never returns; the flag stays set.
{{__kimi_exit}}
entry:
  %busy = load i8, ptr @__kimi_platform_busy, align 1
  %reentered = icmp ne i8 %busy, 0
  br i1 %reentered, label %halt, label %call
halt:
  call void @__kimi_halt()
  unreachable
call:
  store i8 1, ptr @__kimi_platform_busy, align 1
  call void @__kimi_platform_member_terminate(i32 %code)
  unreachable
}

; The platform's write of a nonempty checked range to stream 1 or 2 (the common part's checks hold). The member's 0 = written (-1);
; its -1 = failure without an OS error ({{no_os_error}}); any other result is the platform error.
{{__kimi_write}}
entry:
  %busy = load i8, ptr @__kimi_platform_busy, align 1
  %reentered = icmp ne i8 %busy, 0
  br i1 %reentered, label %halt, label %call
halt:
  call void @__kimi_halt()
  unreachable
call:
  store i8 1, ptr @__kimi_platform_busy, align 1
  %result = call i64 @__kimi_platform_member_write(i32 %stream, ptr %data, i64 %length)
  store i8 0, ptr @__kimi_platform_busy, align 1
  %succeeded = icmp eq i64 %result, 0
  %unexplained = icmp eq i64 %result, -1
  %failure = select i1 %unexplained, i64 {{no_os_error}}, i64 %result
  %error = select i1 %succeeded, i64 -1, i64 %failure
  ret i64 %error
}

; The platform's mapPages: a run below the unmapped bound or not 4,096-aligned is refused as null, so no heap block lies below the
; bound and every run is page-aligned.
{{__kimi_pages}}
entry:
  %busy = load i8, ptr @__kimi_platform_busy, align 1
  %reentered = icmp ne i8 %busy, 0
  br i1 %reentered, label %halt, label %call
halt:
  call void @__kimi_halt()
  unreachable
call:
  store i8 1, ptr @__kimi_platform_busy, align 1
  %run = call ptr @__kimi_platform_member_mapPages(i64 %bytes)
  store i8 0, ptr @__kimi_platform_busy, align 1
  %address = ptrtoint ptr %run to i64
  %low = icmp ult i64 %address, {{unmapped_bound}}
  %offset = and i64 %address, 4095
  %misaligned = icmp ne i64 %offset, 0
  %refused = or i1 %low, %misaligned
  %result = select i1 %refused, ptr null, ptr %run
  ret ptr %result
}

; The platform's releasePages of a run the pages routine returned, by its start and byte count; its result mapped as the write's.
{{__kimi_release_pages}}
entry:
  %busy = load i8, ptr @__kimi_platform_busy, align 1
  %reentered = icmp ne i8 %busy, 0
  br i1 %reentered, label %halt, label %call
halt:
  call void @__kimi_halt()
  unreachable
call:
  store i8 1, ptr @__kimi_platform_busy, align 1
  %result = call i64 @__kimi_platform_member_releasePages(ptr %pages, i64 %bytes)
  store i8 0, ptr @__kimi_platform_busy, align 1
  %succeeded = icmp eq i64 %result, 0
  %unexplained = icmp eq i64 %result, -1
  %failure = select i1 %unexplained, i64 {{no_os_error}}, i64 %result
  %error = select i1 %succeeded, i64 -1, i64 %failure
  ret i64 %error
}

; The platform's clock: monotonic nanoseconds, a negative result a failure, returned as it is.
{{__kimi_clock}}
entry:
  %busy = load i8, ptr @__kimi_platform_busy, align 1
  %reentered = icmp ne i8 %busy, 0
  br i1 %reentered, label %halt, label %call
halt:
  call void @__kimi_halt()
  unreachable
call:
  store i8 1, ptr @__kimi_platform_busy, align 1
  %result = call i64 @__kimi_platform_member_clock()
  store i8 0, ptr @__kimi_platform_busy, align 1
  ret i64 %result
}
