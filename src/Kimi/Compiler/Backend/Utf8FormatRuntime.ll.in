{{__kimi_writer_write_builtin}}
entry:
  %failedp = getelementptr i8, ptr %self, i64 56
  %failed = load i8, ptr %failedp, align 1
  %stopped = icmp ne i8 %failed, 0
  br i1 %stopped, label %failure, label %format
format:
  call void @__kimi_format_builtin(ptr %ret, ptr %value, ptr %self, i32 %kind, ptr %location, i64 %location_length)
  %tag = load i32, ptr %ret, align 4
  %nested = load i8, ptr %failedp, align 1
  %bad = icmp ne i32 %tag, 0
  %nestedbad = icmp ne i8 %nested, 0
  %any = or i1 %bad, %nestedbad
  br i1 %any, label %failure, label %done
failure:
  call void @__kimi_writer_fail(ptr %ret, ptr %self)
  br label %done
done:
  ret void
}

{{__kimi_format_builtin}}
entry:
  switch i32 %kind, label %invalid [
    i32 16, label %bytes
  ]
bytes:
  %data = load ptr, ptr %value, align 8
  %lengthp = getelementptr i8, ptr %value, i64 8
  %length = load i64, ptr %lengthp, align 8
