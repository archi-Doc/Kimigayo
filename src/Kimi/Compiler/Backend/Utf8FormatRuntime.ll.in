; UTF-8 formatting uses one erased adapter and one checked reservation per nonempty builtin.
; Adapter offsets: destination 0, dispatch 8, kind 16, hint 24, pending 32/40, logical length 48, failed 56.

; Fresh formatting buffers contain only validated output. Transfer without a validation pass or copy.
define internal void @__kimi_format_take_string(ptr %ret, ptr %buffer) #0 {
entry:
  call void @__kimi_buffer_bytes(ptr %ret, ptr %buffer)
  %data = load ptr, ptr %buffer, align 8
  %heap = icmp ne ptr %data, null
  %kind = zext i1 %heap to i8
  %kindp = getelementptr i8, ptr %ret, i64 16
  store i8 %kind, ptr %kindp, align 1
  ; The private owner remains in the original temporary cleanup order, now empty.
  call void @llvm.memset.p0.i64(ptr %buffer, i8 0, i64 32, i1 false)
  ret void
}

define internal void @__kimi_format_check(ptr %writer, ptr %location, i64 %location_length) #0 {
entry:
  %failedp = getelementptr i8, ptr %writer, i64 56
  %failed = load i8, ptr %failedp, align 1
  %ok = icmp eq i8 %failed, 0
  br i1 %ok, label %success, label %failure
success:
  ret void
failure:
  call void @__kimi_abort(i32 {{reason_format}}, ptr %location, i64 %location_length, i64 {{no_os_error}})
  unreachable
}

define internal void @__kimi_format_hint(ptr %writer, i64 %hint) #0 {
entry:
  %hintp = getelementptr i8, ptr %writer, i64 24
  store i64 %hint, ptr %hintp, align 8
  ret void
}

; Only compiler-created owning roots use this entry. Literal size is checked
; immediately, before the next expression, even when its physical copy is delayed.
define internal void @__kimi_format_literal(ptr %ret, ptr %self, ptr %value, i32 %kind, ptr %location, i64 %location_length) #0 {
entry:
  %buffer = load ptr, ptr %self, align 8
  %lengthp = getelementptr i8, ptr %buffer, i64 16
  %length = load i64, ptr %lengthp, align 8
  %pendingp = getelementptr i8, ptr %self, i64 40
  %pending = load i64, ptr %pendingp, align 8
  %literalp = getelementptr i8, ptr %value, i64 8
  %literal = load i64, ptr %literalp, align 8
  %room0 = sub i64 9223372036854775807, %length
  %room = sub i64 %room0, %pending
  %overflow = icmp ugt i64 %literal, %room
  br i1 %overflow, label %size_failure, label %append
append:
  %data = load ptr, ptr %value, align 8
  %empty = icmp eq i64 %pending, 0
  br i1 %empty, label %defer, label %flush
defer:
  %datap = getelementptr i8, ptr %self, i64 32
  store ptr %data, ptr %datap, align 8
  store i64 %literal, ptr %pendingp, align 8
  %logicalp = getelementptr i8, ptr %self, i64 48
  %logical = add i64 %length, %literal
  store i64 %logical, ptr %logicalp, align 8
  store i32 0, ptr %ret, align 4
  ret void
flush:
  call void @__kimi_format_bytes(ptr %ret, ptr %self, ptr %data, i64 %literal, ptr %location, i64 %location_length)
  ret void
size_failure:
  call void @__kimi_abort(i32 {{reason_size}}, ptr %location, i64 %location_length, i64 {{no_os_error}})
  unreachable
}

define internal void @__kimi_format_finish(ptr %ret, ptr %buffer, ptr %writer, ptr %location, i64 %location_length) #0 {
entry:
  %reservation = alloca [40 x i8], align 8
  call void @__kimi_format_check(ptr %writer, ptr %location, i64 %location_length)
  %pendingp = getelementptr i8, ptr %writer, i64 40
  %pending = load i64, ptr %pendingp, align 8
  %empty = icmp eq i64 %pending, 0
  br i1 %empty, label %take, label %flush
flush:
  call void @__kimi_writer_reserve(ptr %reservation, ptr %writer, i64 0, ptr %location, i64 %location_length)
  call void @__kimi_format_check(ptr %writer, ptr %location, i64 %location_length)
  %window = getelementptr i8, ptr %reservation, i64 8
  call void @__kimi_utf8_commit(ptr %window, i64 0)
  br label %take
take:
  call void @__kimi_format_take_string(ptr %ret, ptr %buffer)
  ret void
}

define internal void @__kimi_writer_fail(ptr %ret, ptr %self) #0 {
entry:
  %failed = getelementptr i8, ptr %self, i64 56
  store i8 1, ptr %failed, align 1
  store i32 1, ptr %ret, align 4
  ret void
}

define internal void @__kimi_writer_reserve(ptr %ret, ptr %self, i64 %amount, ptr %location, i64 %location_length) #0 {
