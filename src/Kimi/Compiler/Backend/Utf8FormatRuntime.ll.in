  ret void
done:
  %haspending = icmp ne i64 %pending, 0
  br i1 %haspending, label %prepend, label %complete
prepend:
  %pendingdatap = getelementptr i8, ptr %self, i64 32
  %pendingdata = load ptr, ptr %pendingdatap, align 8
  %window = getelementptr i8, ptr %ret, i64 8
  %address = call ptr @__kimi_window_address(ptr %window)
  call void @llvm.memcpy.p0.p0.i64(ptr %address, ptr %pendingdata, i64 %pending, i1 false)
  call void @__kimi_window_advance(ptr %window, i64 %pending)
  store i64 0, ptr %pendingp, align 8
  br label %complete
complete:
  ret void
size_failure:
  call void @__kimi_abort(i32 {{reason_size}}, ptr %location, i64 %location_length, i64 {{no_os_error}})
