define internal void @__kimi_utf8_commit(ptr %window, i64 %amount) #0 {
entry:
  %state = load ptr, ptr %window, align 8
  %lengthp = getelementptr i8, ptr %state, i64 16
  %validp = getelementptr i8, ptr %state, i64 24
  %length = load i64, ptr %lengthp, align 8
  %valid = load i64, ptr %validp, align 8
  %complete = icmp eq i64 %length, %valid
  call void @__kimi_window_advance(ptr %window, i64 %amount)
  %startp = getelementptr i8, ptr %window, i64 8
  %writtenp = getelementptr i8, ptr %window, i64 16
  %start = load i64, ptr %startp, align 8
  %written = load i64, ptr %writtenp, align 8
  %newlength = add i64 %start, %written
  store i64 %newlength, ptr %lengthp, align 8
  br i1 %complete, label %validated, label %done
validated:
  store i64 %newlength, ptr %validp, align 8
  br label %done
done:
  ret void
