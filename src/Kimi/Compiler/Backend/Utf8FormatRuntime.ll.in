; UTF-8 formatting uses one erased adapter and one checked reservation per nonempty builtin.
; Adapter offsets: destination 0, dispatch 8, kind 16, hint 24, pending 32/40, logical length 48, failed 56.

define internal void @__kimi_format_hint(ptr %writer, i64 %hint) #0 {
entry:
  %hintp = getelementptr i8, ptr %writer, i64 24
  store i64 %hint, ptr %hintp, align 8
  ret void
}

define internal void @__kimi_writer_fail(ptr %ret, ptr %self) #0 {
entry:
  %failed = getelementptr i8, ptr %self, i64 56
  store i8 1, ptr %failed, align 1
  store i32 1, ptr %ret, align 4
  ret void
}

define internal void @__kimi_writer_reserve(ptr %ret, ptr %self, i64 %amount, ptr %location, i64 %location_length) #0 {
entry:
  %failedp = getelementptr i8, ptr %self, i64 56
  %failed = load i8, ptr %failedp, align 1
  %stopped = icmp ne i8 %failed, 0
  br i1 %stopped, label %full, label %dispatch
dispatch:
  %destination = load ptr, ptr %self, align 8
  %pendingp = getelementptr i8, ptr %self, i64 40
  %pending = load i64, ptr %pendingp, align 8
  %room = sub i64 9223372036854775807, %pending
  %overflow = icmp ugt i64 %amount, %room
  br i1 %overflow, label %size_failure, label %select
select:
  %requested = add i64 %amount, %pending
  %kindp = getelementptr i8, ptr %self, i64 16
  %kind = load i64, ptr %kindp, align 8
  switch i64 %kind, label %user [
    i64 0, label %fixed
    i64 1, label %heap
  ]
fixed:
  call void @__kimi_buffer_reserve(ptr %ret, ptr %destination, i64 %requested, i1 false, i64 0, ptr %location, i64 %location_length)
  br label %check
heap:
  %hintp = getelementptr i8, ptr %self, i64 24
  %hint = load i64, ptr %hintp, align 8
  call void @__kimi_buffer_reserve(ptr %ret, ptr %destination, i64 %requested, i1 true, i64 %hint, ptr %location, i64 %location_length)
  br label %check
user:
  ; The kept ErasedReserve routine: the Writer's reserve through the dispatch word, its window checked.
  call void @__kimi_erased_reserve(ptr %ret, ptr %self, i64 %amount)
  br label %check
check:
  %tag = load i32, ptr %ret, align 4
  %ok = icmp eq i32 %tag, 0
  br i1 %ok, label %done, label %full
full:
  call void @__kimi_writer_fail(ptr %ret, ptr %self)
  ret void
done:
  %haspending = icmp ne i64 %pending, 0
  br i1 %haspending, label %prepend, label %complete
prepend:
  %pendingdatap = getelementptr i8, ptr %self, i64 32
  %pendingdata = load ptr, ptr %pendingdatap, align 8
  %window = getelementptr i8, ptr %ret, i64 8
  %address = call ptr @__kimi_window_address(ptr %window)
  call void @llvm.memcpy.p0.p0.i64(ptr %address, ptr %pendingdata, i64 %pending, i1 false)
  call void @__kimi_window_advance(ptr %window, i64 %pending)
  store i64 0, ptr %pendingp, align 8
  br label %complete
complete:
  ret void
size_failure:
  call void @__kimi_abort(i32 {{reason_size}}, ptr %location, i64 %location_length, i64 {{no_os_error}})
  unreachable
}

define internal void @__kimi_utf8_commit(ptr %window, i64 %amount) #0 {
entry:
  %state = load ptr, ptr %window, align 8
  %lengthp = getelementptr i8, ptr %state, i64 16
  %validp = getelementptr i8, ptr %state, i64 24
  %length = load i64, ptr %lengthp, align 8
  %valid = load i64, ptr %validp, align 8
  %complete = icmp eq i64 %length, %valid
  call void @__kimi_window_advance(ptr %window, i64 %amount)
  %startp = getelementptr i8, ptr %window, i64 8
  %writtenp = getelementptr i8, ptr %window, i64 16
  %start = load i64, ptr %startp, align 8
  %written = load i64, ptr %writtenp, align 8
  %newlength = add i64 %start, %written
  store i64 %newlength, ptr %lengthp, align 8
  br i1 %complete, label %validated, label %done
validated:
  store i64 %newlength, ptr %validp, align 8
  br label %done
done:
  ret void
}
