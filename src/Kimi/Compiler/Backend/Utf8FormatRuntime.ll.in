define internal void @__kimi_format_bytes(ptr %ret, ptr %self, ptr %data, i64 %length, ptr %location, i64 %location_length) #0 {
entry:
  %reservation = alloca [40 x i8], align 8
  %empty = icmp eq i64 %length, 0
  br i1 %empty, label %success, label %reserve
reserve:
  call void @__kimi_writer_reserve(ptr %reservation, ptr %self, i64 %length, ptr %location, i64 %location_length)
  %tag = load i32, ptr %reservation, align 4
  %ok = icmp eq i32 %tag, 0
  br i1 %ok, label %copy, label %failure
copy:
  %window = getelementptr i8, ptr %reservation, i64 8
  %destination = call ptr @__kimi_window_address(ptr %window)
  call void @llvm.memcpy.p0.p0.i64(ptr %destination, ptr %data, i64 %length, i1 false)
  call void @__kimi_utf8_commit(ptr %window, i64 %length)
  br label %success
success:
  store i32 0, ptr %ret, align 4
  ret void
failure:
