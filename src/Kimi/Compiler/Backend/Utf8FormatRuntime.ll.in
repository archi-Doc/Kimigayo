  %failed = load i8, ptr %failedp, align 1
  %stopped = icmp ne i8 %failed, 0
  br i1 %stopped, label %full, label %dispatch
dispatch:
  %destination = load ptr, ptr %self, align 8
  %pendingp = getelementptr i8, ptr %self, i64 40
  %pending = load i64, ptr %pendingp, align 8
  %room = sub i64 9223372036854775807, %pending
  %overflow = icmp ugt i64 %amount, %room
  br i1 %overflow, label %size_failure, label %select
select:
  %requested = add i64 %amount, %pending
  %kindp = getelementptr i8, ptr %self, i64 16
  %kind = load i64, ptr %kindp, align 8
  switch i64 %kind, label %user [
    i64 0, label %fixed
    i64 1, label %heap
