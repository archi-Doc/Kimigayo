// Compiler-managed dynamic Array (SPEC 4.5, 4.7): storage, length/capacity metadata and the mutation
// operations are supplied by the compiler; helpers may be added here as functions only.
public struct Array<T>
    Self is Iterable
    associate Iterable.IteratorType(source) is ArrayIterator<T> during source
    Self is UniqIterable
    associate UniqIterable.IteratorType(source) is ArrayUniqIterator<T> during source
    Self is IntoIterable
    associate IntoIterable.IteratorType is ArrayOwningIterator<T>

    /// Borrows the complete contiguous storage without copying elements.
    public func slice(self: ref/Self) -> Slice<T> during self
        return self[..]

    public func slice<R>(self: ref/Self, range: R) -> Slice<T> during self
        R is PositionRange
        return self[range]

    /// Borrows the complete contiguous storage exclusively, including an empty array.
    public func sliceUniq(self: uniq/Self) -> UniqSlice<T> during self
        return UniqSlice<T>.init(Storage.borrowStorageUniq(self))

    public func sliceUniq<R>(self: uniq/Self, range: R) -> UniqSlice<T> during self
        R is PositionRange
        return Storage.sliceUniq(Storage.borrowStorageUniq(self), range)

    /// Starts a shared enumeration of the elements in index order.
    public func iterate(self: ref/Self during source) -> ArrayIterator<T> during source
        return ArrayIterator<T>.init(Storage.borrowStorage(self))

    /// Starts an exclusive enumeration of the elements in index order; each element is lent exclusively once.
    public func iterateUniq(self: uniq/Self during source) -> ArrayUniqIterator<T> during source
        return ArrayUniqIterator<T>.init(Storage.borrowStorageUniq(self))

    /// Starts an owning enumeration: each element is transferred out once, and the unreturned elements are destroyed
    /// with the iterator in reverse index order (SPEC 4.7.6).
    public func intoIterator(self: Self) -> ArrayOwningIterator<T>
        return ArrayOwningIterator<T>.init(Storage.ownStorage(self@move))

    /// Inserts `value` before the boundary `index` resolves to; `insert(^0, value)` appends (SPEC 4.7.2).
    ///
    /// - abort: `index` does not resolve against the current length.
    public func insert<P>(self: uniq/Self, index: P, value: T)
        P is Position
        // Each path calls insertAt, so a resolved position reaches it unmerged and `^1` moves one element; -1 fails
        // insertAt's own check.
        match index.tryResolve(self.length)
            .Some(let position) => self.insertAt(position, value@move)
            .None => self.insertAt(-1, value@move)

    /// Removes and returns the element `index` resolves to; the following elements keep their order.
    ///
    /// - return: The removed element; the caller takes ownership.
    /// - abort: `index` does not resolve to an element position.
    public func remove<P>(self: uniq/Self, index: P) -> T
        P is Position
        // As insert: a resolved position reaches removeAt unmerged; -1 fails removeAt's own check.
        match index.tryResolve(self.length)
            .Some(let position) => return self.removeAt(position)
            .None => return self.removeAt(-1)

    /// Exchanges the elements `first` and `second` resolve to; positions resolving to one element change nothing.
    ///
    /// - abort: A position does not resolve to an element position.
    public func swap<P, Q>(self: uniq/Self, first: P, second: Q)
        P is Position
        Q is Position
        let count = self.length
        self.swapAt(first: PositionSyntax.resolved(first, count), second: PositionSyntax.resolved(second, count))

    /// Returns a shared reference to the element `index` resolves to, or `None` when it resolves to no element.
    public func tryGet<P>(self, index: P) -> Option<ref/T during self>
        P is Position
        match index.tryResolve(self.length)
            .Some(let position)
                require position < self.length else => return .None
                return .Some(self[position]@ref/T)
            .None => return .None

    /// Returns the Slice `range` selects, or `None` when `range` does not resolve against the current length.
    public func trySlice<R>(self, range: R) -> Option<Slice<T> during self>
        R is PositionRange
        match range.tryResolve(self.length)
            .Some(let resolved) => return .Some(self[resolved])
            .None => return .None

    /// Splits the elements at the boundary `index` resolves to, `p`, into the Slices `[0, p)` and `[p, length)`.
    ///
    /// - abort: `index` does not resolve against the current length.
    public func splitAt<P>(self, index: P) -> (Slice<T> during self, Slice<T> during self)
        P is Position
        let position = PositionSyntax.resolved(index, self.length)
        return (self[..position], self[position..])

    /// Splits the elements at the boundary `index` resolves to, returning `None` when it does not resolve.
    public func trySplitAt<P>(self, index: P) -> Option<(Slice<T> during self, Slice<T> during self)>
        P is Position
        match index.tryResolve(self.length)
            .Some(let position) => return .Some((self[..position], self[position..]))
            .None => return .None

    /// Returns an exclusive reference to the element `index` resolves to, or `None` when it resolves to no element.
    public func tryGetUniq<P>(self: uniq/Self, index: P) -> Option<uniq/T during self>
        P is Position
        match index.tryResolve(self.length)
            .Some(let position)
                require position < self.length else => return .None
                let slot = self[position]@uniq/T
                return .Some(slot@move)
            .None => return .None

    /// Returns two disjoint exclusive element references in argument order, or `None` for invalid/equal positions.
    public func tryGetPairUniq<P, Q>(
        self: uniq/Self ! first: P, second: Q
    ) -> Option<(uniq/T during self, uniq/T during self)>
        P is Position
        Q is Position
        return Storage.tryGetPairUniq(Storage.borrowStorageUniq(self), first: first, second: second)

    /// Removes and returns the element `index` resolves to; the last element takes its position.
    ///
    /// Runs in O(1) and does not preserve order.
    ///
    /// - return: The removed element; the caller takes ownership.
    /// - abort: `index` does not resolve to an element position.
    public func swapRemove<P>(self: uniq/Self, index: P) -> T
        P is Position
        // As remove: swapAt's one check rejects -1, the end boundary and an empty Array, so pop then has an element.
        let count = self.length
        match index.tryResolve(count)
            .Some(let position) => self.swapAt(first: position, second: count - 1)
            .None => self.swapAt(first: -1, second: count - 1)
        match self.pop()
            .Some(let removed) => return removed@move
            .None => $abort("Array index out of range")

    /// Destroys the elements from `length` to the end in decreasing index order.
    ///
    /// A length at or above the current length changes nothing.
    ///
    /// - abort: `length` is negative.
    public func truncate(self: uniq/Self, length: isize)
        require length >= 0 else => Kimi.Storage.argumentOutOfRange()
        while self.length > length
            match self.pop()
                .Some(_) => ()
                .None => return

    /// Moves every element of `other` to the end, in order; `other` is consumed.
    public func appendAll(self: uniq/Self, other: Array<T>)
        var source = other@move
        self.reserve(additional: source.length)
        source.reverse()
        while source.length > 0
            match source.pop()
                .Some(let value) => self.append(value@move)
                .None => return

    /// Defines `init(! repeating:count:)`: `count` Copies of `repeating` placed in one reserved buffer (SPEC 4.7.4).
    ///
    /// - abort: `count` is negative; the capacity constructor aborts before any element is placed.
    internal func initRepeating(repeating: T, count: isize) -> Self
        T is Copy
        var result = Array<T>.init(capacity: count)
        unsafe
            let storage = Storage.borrowStorageUniq(result@uniq).storage
            // The new Array is exclusively owned and holds no element, and Copy cannot invoke user code, so each slot below
            // `count` is initialized exactly once before the length is published.
            var index: isize = 0
            while index < count
                Raw.initialize(storage + index, repeating)
                index += 1
            Storage.setArrayLength(result@uniq, count)
        return result@move

    /// Copies each element of `values` to the end, in order.
    public func appendCopies(self: uniq/Self, values: Slice<T>)
        T is Copy
        let count = values.length
        if count == 0 => return
        let offset = self.length
        // Reserve checks capacity and length overflow once, before reading any element.
        self.reserve(additional: count)
        unsafe
            let storage = Storage.borrowStorageUniq(self).storage
            // The exclusive receiver keeps the buffer stable. Copy cannot invoke user code, and the
            // source Loan excludes overlapping storage. Only the newly reserved tail is initialized.
            for index in values.indices
                Raw.initialize(storage + offset + index, values[index])
            Storage.setArrayLength(self, offset + count)

    /// Removes the elements for which `matching` returns true and keeps the order of the others.
    ///
    /// `matching` is called once per element in increasing index order with a shared reference. The removed
    /// elements are destroyed after the last call, in an unspecified order.
    public func removeAll<F>(self: uniq/Self, matching: F)
        F is Callable<(ref/T) -> bool>
        let count = self.length
        var kept: isize = 0
        var index: isize = 0
        while index < count
            if not matching(self[index])
                if kept != index => self.swapAt(first: kept, second: index)
                kept += 1
            index += 1
        self.truncate(kept)

    /// Reverses the order of the elements.
    public func reverse(self: uniq/Self)
        var low: isize = 0
        var high = self.length - 1
        while low < high
            self.swapAt(first: low, second: high)
            low += 1
            high -= 1

    /// Sorts the elements in nondecreasing `compare` order, without allocation; not stable.
    public func sort(self: uniq/Self)
        T is Comparable
        // Keep the heap traversal aligned with the callback overload. Direct Contract calls avoid a generic
        // Callable adapter until generic anonymous functions are supported.
        var end = self.length
        var start = end / 2
        while end > 1
            var parent: isize = 0
            if start > 0
                start -= 1
                parent = start
            else
                end -= 1
                self.swapAt(first: 0, second: end)
            // Only parents with a child compute 2 * parent + 1, so the index cannot overflow.
            while parent < end / 2
                var child = parent * 2 + 1
                if child + 1 < end and self[child].compare(self[child + 1]) < 0 => child += 1
                if self[parent].compare(self[child]) >= 0 => exit
                self.swapAt(first: parent, second: child)
                parent = child

    /// Sorts the elements in nondecreasing order of `by`, which returns a negative, zero or positive value
    /// for less, equal or greater.
    ///
    /// Heapsort: O(n log n) calls and moves in the worst case, without allocation; not stable.
    public func sort<F>(self: uniq/Self, by: F)
        F is Callable<(ref/T, ref/T) -> i32>
        var end = self.length
        var start = end / 2
        while end > 1
            // The first phase builds the heap from start = length / 2 down to 0; the second moves the maximum
            // to the end and restores the heap on the shorter prefix.
            var parent: isize = 0
            if start > 0
                start -= 1
                parent = start
            else
                end -= 1
                self.swapAt(first: 0, second: end)
            while parent < end / 2
                var child = parent * 2 + 1
                if child + 1 < end and by(self[child], self[child + 1]) < 0 => child += 1
                if by(self[parent], self[child]) >= 0 => exit
                self.swapAt(first: parent, second: child)
                parent = child

/// The standard shared Array iterator: each `next` lends the next untaken element for shared access (SPEC 22.1.2.3).
public struct ArrayIterator<T> {source}
    Self is Iterator
    associate Iterator.Item is ref/T during source
    var state: Storage.RefRemainder<T> during source
    internal init(state: Storage.RefRemainder<T> during source) => self.state = state@move
    public func next(self: uniq/Self) -> Option<ref/T during source>
        return Storage.splitFirst(self.state@uniq)

/// The standard exclusive Array iterator: each `next` splits the next untaken element off as a child Loan, so earlier
/// items stay valid (SPEC 15.6.3, 22.1.2.5).
public struct ArrayUniqIterator<T> {source}
    Self is Iterator
    associate Iterator.Item is uniq/T during source
    var state: Storage.UniqRemainder<T> during source
    internal init(state: Storage.UniqRemainder<T> during source) => self.state = state@move
    public func next(self: uniq/Self) -> Option<uniq/T during source>
        return Storage.splitFirst(self.state@uniq)

/// The standard owning Array iterator: each `next` transfers the next unreturned element out (SPEC 22.1.2.3).
public struct ArrayOwningIterator<T>
    Self is Iterator
    associate Iterator.Item is T
    var state: Storage.OwnedRemainder<T>
    internal init(state: Storage.OwnedRemainder<T>) => self.state = state@move
    public func next(self: uniq/Self) -> Option<T>
        return Storage.takeFirst(self.state@uniq)

/// The standard owning fixed-array iterator: each `next` transfers the next unreturned element out, and the unreturned
/// elements are destroyed with the iterator in reverse index order (SPEC 22.1.2.3, 22.1.2.5). `A` is the array Type
/// `[N of E]`, since only functions have length slots (SPEC 4.4).
public struct FixedArrayOwningIterator<E, A>
    Self is Iterator
    associate Iterator.Item is E
    var state: Storage.FixedOwnedRemainder<E, A>
    internal init(state: Storage.FixedOwnedRemainder<E, A>) => self.state = state@move
    public func next(self: uniq/Self) -> Option<E>
        return Storage.takeFirst(self.state@uniq)
