/// Operations on raw storage (SPEC 5.6). `allocate` is safe; `release`, `initialize`, `slice`, `readVolatile` and `writeVolatile`
/// carry the obligations their contracts state. Elements are taken and destroyed with `@move` on raw Places (SPEC 5.2.3), and none
/// of these operations is an environment effect (SPEC 8.11.2).
public group Raw
    /// Allocates raw storage for `count` elements; it holds no value.
    ///
    /// A zero-byte request allocates nothing and returns a nonnull address aligned for `T`, with provenance of its own.
    ///
    /// - abort: `count` is negative, `count * stride(T)` overflows, or the allocation fails.
    #Intrinsic("RawAllocate")
    public func allocate<T>(count: isize) -> raw/T
    /// Releases storage that `allocate` returned, at its start address, without destroying any value.
    ///
    /// Null is ignored, and nothing is freed for a zero-byte result, which may be released again. Afterwards every
    /// pointer into the storage is invalid.
    ///
    /// - safety: `storage` is null, a zero-byte result or the start of an unreleased `allocate` result, possibly converted
    ///   to another raw pointer Type. Every Non-Copy value placed in the storage is already destroyed, taken or relocated,
    ///   whole or, if destroying it whole would only destroy its components, by its remaining Non-Copy components under
    ///   the same rule (SPEC 5.6).
    #Lang("RawRelease")
    #Intrinsic("RawRelease")
    public unsafe func release<T>(storage: raw/T)
    /// Moves `value` into a Place of `T` at `storage`, an existing one or, in raw storage, a new one, destroying nothing.
    ///
    /// - safety: The write meets the raw access conditions (SPEC 5.2.1): `storage` is live, aligned for `T` and writable,
    ///   the Place lies within its provenance, and no live Loan conflicts. The Place holds no value, and no Initialized
    ///   Place other than its ancestors holds any of its bytes (SPEC 5.2).
    #Lang("RawInitialize")
    #Intrinsic("RawInitialize")
    public unsafe func initialize<T>(storage: raw/T, value: T)
    /// Forms a shared Slice of `length` elements starting at `storage` without reading them; the caller fixes the
    /// result Origin `s`.
    ///
    /// - safety: `length >= 0`. A positive `length` needs a nonnull, aligned `storage` with `length * stride(T)` fitting
    ///   in `isize`, each `storage[i]` below `length` designating a distinct Place that holds a complete, valid value or
    ///   belongs to a noinit array, and no element is written for `s` (SPEC 5.6). The programmer writes valid values
    ///   before reading noinit elements through this view.
    #Lang("RawSlice")
    #Intrinsic("RawSlice")
    public unsafe func slice<T>(storage: raw/T, length: isize) -> Slice<T> during s
    /// Reads the value of `T` at `storage` with a volatile access (SPEC 5.6), which the compiler never merges, splits, removes,
    /// duplicates or reorders with another volatile access.
    ///
    /// - safety: The read meets the raw access conditions (SPEC 5.2.1): `storage` is live, aligned for `T` and readable, it holds
    ///   a valid, initialized value of `T` within its provenance, and no live Loan conflicts.
    #Lang("RawReadVolatile")
    #Intrinsic("VolatileRead")
    public unsafe func readVolatile<T>(storage: raw/T) -> T
        T is PrimitiveInteger
    /// Writes `value` to the Place of `T` at `storage` with a volatile access (SPEC 5.6), ordered as `readVolatile`'s; the Place
    /// may hold a value or none.
    ///
    /// - safety: The write meets the raw access conditions (SPEC 5.2.1): `storage` is live, aligned for `T` and writable, the
    ///   Place lies within its provenance, and no live Loan conflicts.
    #Intrinsic("VolatileWrite")
    public unsafe func writeVolatile<T>(storage: raw/T, value: T)
        T is PrimitiveInteger
