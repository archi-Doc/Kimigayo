#Lang("MakeObj")
#Intrinsic("MakeObj")
public func makeObj<T>(value: T) -> obj/T
    T is ObjectPayload
#Lang("MakeRc")
#Intrinsic("MakeRc")
public func makeRc<T>(value: T) -> rc/T
    T is ObjectPayload
#Lang("MakeArc")
#Intrinsic("MakeArc")
public func makeArc<T>(value: T) -> arc/T
    T is ObjectPayload
#Lang("Clone")
#Intrinsic("Clone")
public func clone<s/T>(value: ref/(s/T)) -> s/T
    s is rc or arc
#Unsupported
