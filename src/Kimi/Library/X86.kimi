#if arch == "x86_64"
    /// x86-64 processor instructions (IMPL 21.6). Each function executes its instruction once, in program order with every memory
    /// access and every other function (a compiler barrier), and every function is an environment effect (SPEC 8.11.2).
    public group X86
        /// Hints to the processor that the caller spins in a wait loop (`pause`).
        #Intrinsic("Instruction", "pause")
        public func pause()

        /// Reads the processor's time-stamp counter (`rdtsc`).
        #Intrinsic("Instruction", "rdtsc")
        public func readTimestamp() -> u64

        #if os == "none"
            /// Stops the processor until the next interrupt (`hlt`).
            #Intrinsic("Instruction", "hlt")
            public func halt()

            /// Clears the interrupt flag (`cli`).
            #Intrinsic("Instruction", "cli")
            public func disableInterrupts()

            /// Sets the interrupt flag (`sti`).
            #Intrinsic("Instruction", "sti")
            public func enableInterrupts()

            /// Reads one byte from an I/O port (`in al, dx`).
            ///
            /// - safety: The device at `port` may change any storage it can reach; the caller keeps that storage within the
            ///   program's platform contract (IMPL 21.6).
            #Intrinsic("Instruction", "inb")
            public unsafe func readPort8(port: u16) -> u8

            /// Writes one byte to an I/O port (`out dx, al`).
            ///
            /// - safety: The device at `port` may change any storage it can reach; the caller keeps that storage within the
            ///   program's platform contract (IMPL 21.6).
            #Intrinsic("Instruction", "outb")
            public unsafe func writePort8(port: u16, value: u8)

            /// Reads two bytes from an I/O port (`in ax, dx`).
            ///
            /// - safety: The device at `port` may change any storage it can reach; the caller keeps that storage within the
            ///   program's platform contract (IMPL 21.6).
            #Intrinsic("Instruction", "inw")
            public unsafe func readPort16(port: u16) -> u16

            /// Writes two bytes to an I/O port (`out dx, ax`).
            ///
            /// - safety: The device at `port` may change any storage it can reach; the caller keeps that storage within the
            ///   program's platform contract (IMPL 21.6).
            #Intrinsic("Instruction", "outw")
            public unsafe func writePort16(port: u16, value: u16)

            /// Reads four bytes from an I/O port (`in eax, dx`).
            ///
            /// - safety: The device at `port` may change any storage it can reach; the caller keeps that storage within the
            ///   program's platform contract (IMPL 21.6).
            #Intrinsic("Instruction", "inl")
            public unsafe func readPort32(port: u16) -> u32

            /// Writes four bytes to an I/O port (`out dx, eax`).
            ///
            /// - safety: The device at `port` may change any storage it can reach; the caller keeps that storage within the
            ///   program's platform contract (IMPL 21.6).
            #Intrinsic("Instruction", "outl")
            public unsafe func writePort32(port: u16, value: u32)

        /// What the processor pushes on an interrupt in 64-bit mode, as it lies in memory from its lowest address; each Field holds
        /// the register its doc names.
        #Layout("C")
        public struct InterruptFrame
            Self is Copy

            /// The address at which the interrupted code resumes (`rip`).
            public let ip: u64
            /// The interrupted code's code segment selector (`cs`).
            public let cs: u64
            /// The interrupted code's flags (`rflags`).
            public let flags: u64
            /// The interrupted code's stack pointer (`rsp`).
            public let sp: u64
            /// The interrupted code's stack segment selector (`ss`).
            public let ss: u64

        /// The Contract of a handler for a vector without an error code.
        public contract InterruptHandler
            func handle(frame: ref/InterruptFrame)

        /// The Contract of a handler for a vector that pushes an error code, which `code` receives.
        public contract ErrorCodeHandler
            func handle(frame: ref/InterruptFrame, code: u64)
