#if arch == "x86_64"
    /// x86-64 processor instructions (IMPL 21.6). Each function executes its instruction once, in program order with every memory
    /// access and every other function (a compiler barrier), and every function is an environment effect (SPEC 8.11.2).
    public group X86
        /// Hints to the processor that the caller spins in a wait loop (`pause`).
        #Intrinsic("Instruction", "pause")
        public func pause()

        /// Reads the processor's time-stamp counter (`rdtsc`).
        #Intrinsic("Instruction", "rdtsc")
        public func readTimestamp() -> u64

        /// Reads the processor's identification and feature information for `leaf` and `subleaf` (`cpuid`).
        ///
        /// - return: The four registers the instruction writes.
        #Intrinsic("Instruction", "cpuid")
        public func cpuid(leaf: u32, subleaf: u32) -> CpuidResult

        #if os == "none"
            /// Stops the processor until the next interrupt (`hlt`).
            #Intrinsic("Instruction", "hlt")
            public func halt()

            /// Clears the interrupt flag (`cli`).
            #Intrinsic("Instruction", "cli")
            public func disableInterrupts()

            /// Sets the interrupt flag (`sti`).
            #Intrinsic("Instruction", "sti")
            public func enableInterrupts()

            /// Sets the interrupt flag and stops the processor until the next interrupt (`sti; hlt`).
            ///
            /// `sti` delays interrupts by one instruction, so an interrupt pending at the call ends the `hlt` instead of running
            /// before it: the idle wait without a lost wakeup.
            #Intrinsic("Instruction", "stihlt")
            public func enableInterruptsAndHalt()

            /// Reads one byte from an I/O port (`in al, dx`).
            ///
            /// - safety: The device at `port` may change any storage it can reach; the caller keeps that storage within the
            ///   program's platform contract (IMPL 21.6).
            #Intrinsic("Instruction", "inb")
            public unsafe func readPort8(port: u16) -> u8

            /// Writes one byte to an I/O port (`out dx, al`).
            ///
            /// - safety: The device at `port` may change any storage it can reach; the caller keeps that storage within the
            ///   program's platform contract (IMPL 21.6).
            #Intrinsic("Instruction", "outb")
            public unsafe func writePort8(port: u16, value: u8)

            /// Reads two bytes from an I/O port (`in ax, dx`).
            ///
            /// - safety: The device at `port` may change any storage it can reach; the caller keeps that storage within the
            ///   program's platform contract (IMPL 21.6).
            #Intrinsic("Instruction", "inw")
            public unsafe func readPort16(port: u16) -> u16

            /// Writes two bytes to an I/O port (`out dx, ax`).
            ///
            /// - safety: The device at `port` may change any storage it can reach; the caller keeps that storage within the
            ///   program's platform contract (IMPL 21.6).
            #Intrinsic("Instruction", "outw")
            public unsafe func writePort16(port: u16, value: u16)

            /// Reads four bytes from an I/O port (`in eax, dx`).
            ///
            /// - safety: The device at `port` may change any storage it can reach; the caller keeps that storage within the
            ///   program's platform contract (IMPL 21.6).
            #Intrinsic("Instruction", "inl")
            public unsafe func readPort32(port: u16) -> u32

            /// Writes four bytes to an I/O port (`out dx, eax`).
            ///
            /// - safety: The device at `port` may change any storage it can reach; the caller keeps that storage within the
            ///   program's platform contract (IMPL 21.6).
            #Intrinsic("Instruction", "outl")
            public unsafe func writePort32(port: u16, value: u32)

            /// Loads the interrupt descriptor table register from the 10-byte limit and base at `descriptor` (`lidt`).
            ///
            /// - safety: The 10 bytes at `descriptor` are live, and the table they name stays live and unchanged while
            ///   interrupts may use it.
            #Intrinsic("Instruction", "lidt")
            public unsafe func loadInterruptTable(descriptor: raw/u8)

            /// Loads the global descriptor table register from the 10-byte limit and base at `descriptor` (`lgdt`).
            ///
            /// - safety: The 10 bytes at `descriptor` are live, and the table they name stays live and unchanged while
            ///   the processor may use it.
            #Intrinsic("Instruction", "lgdt")
            public unsafe func loadDescriptorTable(descriptor: raw/u8)

            /// Loads the task register with the task-state segment `selector` names in the global descriptor table (`ltr`).
            ///
            /// - safety: `selector` names an available task-state segment descriptor, and the segment stays live and unchanged
            ///   while the processor may use it.
            #Intrinsic("Instruction", "ltr")
            public unsafe func loadTaskRegister(selector: u16)

            /// Invalidates the processor's cached translation of the page that holds `address` (`invlpg`); it accesses no
            /// storage at `address`.
            ///
            /// - safety: The translation that follows keeps the program's storage within its platform contract (IMPL 21.6).
            #Intrinsic("Instruction", "invlpg")
            public unsafe func invalidatePage(address: raw/())

            /// Reads control register 0, the processor's operating mode (`mov r64, cr0`).
            #Intrinsic("Instruction", "rdcr0")
            public func readCr0() -> u64

            /// Reads control register 2, the linear address of the latest page fault (`mov r64, cr2`).
            #Intrinsic("Instruction", "rdcr2")
            public func readCr2() -> u64

            /// Reads control register 3, the physical address of the page tables' root (`mov r64, cr3`).
            #Intrinsic("Instruction", "rdcr3")
            public func readCr3() -> u64

            /// Reads control register 4, the processor's extension flags (`mov r64, cr4`).
            #Intrinsic("Instruction", "rdcr4")
            public func readCr4() -> u64

            /// Writes control register 0 (`mov cr0, r64`).
            ///
            /// - safety: The processor's mode that follows keeps the program's storage and execution within its platform
            ///   contract (IMPL 21.6).
            #Intrinsic("Instruction", "wrcr0")
            public unsafe func writeCr0(value: u64)

            /// Writes control register 3, switching the page tables to the root at `value` (`mov cr3, r64`).
            ///
            /// - safety: The page tables at `value` stay live while the processor uses them, and each translation they give,
            ///   including after a later edit and its invalidation, keeps the program's storage within its platform contract
            ///   (IMPL 21.6).
            #Intrinsic("Instruction", "wrcr3")
            public unsafe func writeCr3(value: u64)

            /// Writes control register 4 (`mov cr4, r64`).
            ///
            /// - safety: The processor's extensions that follow keep the program's storage and execution within its platform
            ///   contract (IMPL 21.6).
            #Intrinsic("Instruction", "wrcr4")
            public unsafe func writeCr4(value: u64)

            /// Reads the model-specific register `index` (`rdmsr`).
            ///
            /// - safety: `index` names a model-specific register the processor implements; a read may change the state it
            ///   reports.
            #Intrinsic("Instruction", "rdmsr")
            public unsafe func readMsr(index: u32) -> u64

            /// Writes `value` to the model-specific register `index` (`wrmsr`).
            ///
            /// - safety: `index` names a model-specific register the processor implements, and the state that follows keeps
            ///   the program's storage and execution within its platform contract (IMPL 21.6).
            #Intrinsic("Instruction", "wrmsr")
            public unsafe func writeMsr(index: u32, value: u64)

        /// What the processor pushes on an interrupt in 64-bit mode; the Field names are the processor's register names.
        #Layout("C")
        public struct InterruptFrame
            Self is Copy

            /// The address at which the interrupted code resumes (`rip`).
            public let ip: u64
            /// The interrupted code's code segment selector (`cs`).
            public let cs: u64
            /// The interrupted code's flags (`rflags`).
            public let flags: u64
            /// The interrupted code's stack pointer (`rsp`).
            public let sp: u64
            /// The interrupted code's stack segment selector (`ss`).
            public let ss: u64

        /// A Type whose `handle` runs as an interrupt handler for a vector without an error code.
        public contract InterruptHandler
            func handle(frame: ref/InterruptFrame)

        /// A Type whose `handle` runs as an interrupt handler for a vector that pushes an error code.
        public contract ErrorCodeHandler
            func handle(frame: ref/InterruptFrame, code: u64)

        /// The four registers `cpuid` writes, in the processor's order.
        #Layout("C")
        public struct CpuidResult
            Self is Copy

            public let eax: u32
            public let ebx: u32
            public let ecx: u32
            public let edx: u32
