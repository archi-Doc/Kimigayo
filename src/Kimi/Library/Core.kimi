public contract Copy
public contract Owned
public contract Callable
public contract Sealed
public contract ObjectPayload
public contract PrimitiveInteger

/// A boundary of a target of length `L` that resolves to an integer in `[0, L]` (SPEC 4.6.2).
///
/// A closed Contract: the twelve integer Types, `FromEnd<T>`, `Start` and `End` conform, and no other Type can.
public contract Position: Equatable, Utf8Format
    Self is Copy
    Self is Owned

    /// Resolves this position against `length`, or returns `None` when `length < 0` or the position lies outside
    /// `[0, length]`.
    func tryResolve(self: Self, length: isize) -> Option<isize>

/// An interval of positions that resolves against a length to a validated half-open interval (SPEC 4.6.4).
///
/// A closed Contract: `Range<S, E>`, `ClosedRange<S, E>` and `ResolvedRange` conform, and no other Type can.
public contract PositionRange: Equatable, Utf8Format
    Self is Copy
    Self is Owned

    /// Resolves this range against `length`, or returns `None` when `length < 0`, a boundary does not resolve or the
    /// resolved boundaries are reversed.
    func tryResolve(self: Self, length: isize) -> Option<ResolvedRange>

// SPEC 4.6.2, 8.4.7: the built-in integer conformance to Position. The compiler binds an integer's `tryResolve`
// requirement to this receiver function; integers gain no members.
internal group IntegerPosition
    /// Returns `self` as an isize boundary when `0 <= self <= length`, or None; no wide value is truncated first.
    public func tryResolve<I>(self: I, length: isize) -> Option<isize>
        I is PrimitiveInteger
        require self >= 0 and length >= 0 else => return .None
        require self@u128 <= length@u128 else => return .None
        return .Some(self@isize)

    specialize func tryResolve<isize>(self: isize, length: isize) -> Option<isize>
        require self >= 0 and self <= length else => return .None
        return .Some(self)

    specialize func tryResolve<i32>(self: i32, length: isize) -> Option<isize>
        let wide = self@isize
        require wide >= 0 and wide <= length else => return .None
        return .Some(wide)

    specialize func tryResolve<usize>(self: usize, length: isize) -> Option<isize>
        require length >= 0 and self <= length@usize else => return .None
        return .Some(self@isize)

public enum Option<T>
    Self is Copy when T is Copy
    Some(T)
    None

public enum Result<T, E>
    Ok(T)
    Err(E)

/// The wrapping integer Type over `T` (SPEC 3.1.1.1): the same representation, order, comparison and formatting as `T`,
/// with arithmetic that wraps modulo 2ᴺ instead of Aborting.
///
/// Division by zero and an invalid shift count still Abort. The Type has no members: enter and leave it with
/// `x@Wrapping<T>` and `w@T`. It is neither `PrimitiveInteger` nor a `Position`, so it is a value, never an index,
/// a range boundary, a length or a shift count.
public struct Wrapping<T>
    T is PrimitiveInteger
    Self is Copy

/// A position `offset` elements before the end of a target (SPEC 4.6.2); prefix `^` constructs it.
///
/// Construction checks nothing: `^(-1)` is a valid value that fails to resolve. `^0` is the end boundary and `^1`
/// the last element.
public struct FromEnd<T>
    T is PrimitiveInteger
    Self is Copy
    Self is Equatable
    Self is Position
    public let offset: T

    internal init(offset: T)
        self.offset = offset

    /// Compares the offsets.
    public func equals(self: ref/Self, other: ref/Self) -> bool
        return self.offset == other.offset

    /// Resolves to `length - offset` when `0 <= offset <= length`, or returns `None`.
    public func tryResolve(self: Self, length: isize) -> Option<isize>
        match self.offset.tryResolve(length)
            .Some(let distance) => return .Some(length - distance)
            .None => return .None

    /// Resolves to `length - offset`.
    ///
    /// - abort: `offset` lies outside `[0, length]`.
    public func resolve(self: Self, length: isize) -> isize
        match self.tryResolve(length)
            .Some(let position) => return position
            .None => $abort("Position out of range")

    /// Writes `^` followed by the offset.
    public func format(self: ref/Self, writer: uniq/Utf8Writer) -> Result<(), BufferFull>
        try writer.write("^")
        return writer.write(self.offset)

/// The start boundary of a target, which an omitted range start denotes (SPEC 4.6.2).
public struct Start
    Self is Copy
    Self is Equatable
    Self is Position

    internal init() => ()

    /// Returns true: all Start values are equal.
    public func equals(self: ref/Self, other: ref/Self) -> bool
        return true

    /// Resolves to `0`, or returns `None` when `length < 0`.
    public func tryResolve(self: Self, length: isize) -> Option<isize>
        require length >= 0 else => return .None
        return .Some(0)

    /// Resolves to `0`.
    ///
    /// - abort: `length < 0`.
    public func resolve(self: Self, length: isize) -> isize
        require length >= 0 else => $abort("Position out of range")
        return 0

    /// Writes nothing: the boundary that range syntax omits.
    public func format(self: ref/Self, writer: uniq/Utf8Writer) -> Result<(), BufferFull>
        return .Ok(())

/// The end boundary of a target, which an omitted range end denotes (SPEC 4.6.2).
public struct End
    Self is Copy
    Self is Equatable
    Self is Position

    internal init() => ()

    /// Returns true: all End values are equal.
    public func equals(self: ref/Self, other: ref/Self) -> bool
        return true

    /// Resolves to `length`, or returns `None` when `length < 0`.
    public func tryResolve(self: Self, length: isize) -> Option<isize>
        require length >= 0 else => return .None
        return .Some(length)

    /// Resolves to `length`.
    ///
    /// - abort: `length < 0`.
    public func resolve(self: Self, length: isize) -> isize
        require length >= 0 else => $abort("Position out of range")
        return length

    /// Writes nothing: the boundary that range syntax omits.
    public func format(self: ref/Self, writer: uniq/Utf8Writer) -> Result<(), BufferFull>
        return .Ok(())

/// A half-open interval of positions from `start`, excluding `end` (SPEC 4.6.3.2).
///
/// Range syntax `a..b`, `a..`, `..b` and `..` constructs it; an omitted boundary is `Start` or `End`. Construction
/// checks nothing, so a reversed range is a valid value that fails to resolve. It is iterable when both boundaries
/// have one integer Type.
public struct Range<S, E>
    S is Position
    E is Position
    Self is Copy
    Self is Equatable
    Self is PositionRange
    public let start: S
    public let end: E

    internal init(start: S, end: E)
        self.start = start
        self.end = end

    /// Compares both boundaries.
    public func equals(self: ref/Self, other: ref/Self) -> bool
        return self.start == other.start and self.end == other.end

    /// Resolves both boundaries against `length` into `[start, end)`, or returns `None` when a boundary does not
    /// resolve or the resolved start exceeds the resolved end (SPEC 4.6.4).
    public func tryResolve(self: Self, length: isize) -> Option<ResolvedRange>
        match self.start.tryResolve(length)
            .Some(let first)
                match self.end.tryResolve(length)
                    .Some(let last)
                        require first <= last else => return .None
                        return .Some(ResolvedRange.init(start: first, end: last))
                    .None => return .None
            .None => return .None

    /// Resolves both boundaries against `length` into `[start, end)`.
    ///
    /// - abort: A boundary does not resolve, or the resolved start exceeds the resolved end.
    public func resolve(self: Self, length: isize) -> ResolvedRange
        match self.tryResolve(length)
            .Some(let resolved) => return resolved
            .None => $abort("Range out of range")

    /// Writes the start, `..` and the end, each boundary in its own representation: `1..^1`, `2..`.
    public func format(self: ref/Self, writer: uniq/Utf8Writer) -> Result<(), BufferFull>
        try writer.write(self.start)
        try writer.write("..")
        return writer.write(self.end)

    Self is Iterable when S is PrimitiveInteger, E is S
        associate Iterable.IteratorType(source) is RangeIterator<S>

        /// Starts a shared enumeration from `start` upward; the iterator keeps no borrow of the range.
        ///
        /// - abort: `start > end`.
        public func iterate(self: ref/Self during source) -> RangeIterator<S>
            return RangeIterator<S>.starting(self.start, self.end)

    Self is UniqIterable when S is PrimitiveInteger, E is S
        associate UniqIterable.IteratorType(source) is RangeIterator<S>

        /// Starts an enumeration through an exclusive borrow; the range itself does not change.
        ///
        /// - abort: `start > end`.
        public func iterateUniq(self: uniq/Self during source) -> RangeIterator<S>
            return RangeIterator<S>.starting(self.start, self.end)

    Self is IntoIterable when S is PrimitiveInteger, E is S
        associate IntoIterable.IteratorType is RangeIterator<S>

        /// Starts an enumeration of the consumed range value.
        ///
        /// - abort: `start > end`.
        public func intoIterator(self: Self) -> RangeIterator<S>
            return RangeIterator<S>.starting(self.start, self.end)

/// A closed interval of positions from `start`, including `end` (SPEC 4.6.3.2).
///
/// Range syntax `a..=b` and `..=b` constructs it; its end resolves as an element position. Construction checks
/// nothing. It is iterable when both boundaries have one integer Type.
public struct ClosedRange<S, E>
    S is Position
    E is Position
    Self is Copy
    Self is Equatable
    Self is PositionRange
    public let start: S
    public let end: E

    internal init(start: S, end: E)
        self.start = start
        self.end = end

    /// Compares both boundaries.
    public func equals(self: ref/Self, other: ref/Self) -> bool
        return self.start == other.start and self.end == other.end

    /// Resolves the start and the end, as an element position `q`, against `length` into `[start, q + 1)`, or returns
    /// `None` when a boundary does not resolve, `q` is not below `length` or the start exceeds `q` (SPEC 4.6.4).
    public func tryResolve(self: Self, length: isize) -> Option<ResolvedRange>
        match self.start.tryResolve(length)
            .Some(let first)
                match self.end.tryResolve(length)
                    .Some(let last)
                        require first <= last and last < length else => return .None
                        return .Some(ResolvedRange.init(start: first, end: last + 1))
                    .None => return .None
            .None => return .None

    /// Resolves the range against `length` into the half-open `[start, end + 1)`.
    ///
    /// - abort: A boundary does not resolve, the end is not an element position or the start exceeds the end.
    public func resolve(self: Self, length: isize) -> ResolvedRange
        match self.tryResolve(length)
            .Some(let resolved) => return resolved
            .None => $abort("Range out of range")

    /// Writes the start, `..=` and the end, each boundary in its own representation: `1..=3`, `..=^1`.
    public func format(self: ref/Self, writer: uniq/Utf8Writer) -> Result<(), BufferFull>
        try writer.write(self.start)
        try writer.write("..=")
        return writer.write(self.end)

    Self is Iterable when S is PrimitiveInteger, E is S
        associate Iterable.IteratorType(source) is ClosedRangeIterator<S>

        /// Starts a shared enumeration from `start` through `end`; the iterator keeps no borrow of the range.
        ///
        /// - abort: `start > end`.
        public func iterate(self: ref/Self during source) -> ClosedRangeIterator<S>
            return ClosedRangeIterator<S>.starting(self.start, self.end)

    Self is UniqIterable when S is PrimitiveInteger, E is S
        associate UniqIterable.IteratorType(source) is ClosedRangeIterator<S>

        /// Starts an enumeration through an exclusive borrow; the range itself does not change.
        ///
        /// - abort: `start > end`.
        public func iterateUniq(self: uniq/Self during source) -> ClosedRangeIterator<S>
            return ClosedRangeIterator<S>.starting(self.start, self.end)

    Self is IntoIterable when S is PrimitiveInteger, E is S
        associate IntoIterable.IteratorType is ClosedRangeIterator<S>

        /// Starts an enumeration of the consumed range value.
        ///
        /// - abort: `start > end`.
        public func intoIterator(self: Self) -> ClosedRangeIterator<S>
            return ClosedRangeIterator<S>.starting(self.start, self.end)

/// The iterator of a half-open integer range (SPEC 4.6.3.4).
///
/// It yields `start` upward in unit steps while the value is below `end`, and keeps no end flag.
public struct RangeIterator<T>
    T is PrimitiveInteger
    Self is Iterator
    associate Iterator.Item is T
    var current: T
    let end: T

    init(current: T, end: T)
        self.current = current
        self.end = end

    /// Starts at `start` after checking the order of a range entry.
    ///
    /// - abort: `start > end`.
    internal func starting(start: T, end: T) -> RangeIterator<T>
        require start <= end else => $abort("Reversed range")
        return RangeIterator<T>.init(start, end)

    /// Starts at `start` of a validated half-open interval, which is never reversed.
    internal func unchecked(start: T, end: T) -> RangeIterator<T> => RangeIterator<T>.init(start, end)

    /// Returns the next value, or None after the last one.
    public func next(self: uniq/Self) -> Option<T>
        let value = self.current
        require value < self.end else => return .None
        self.current = value + 1
        return .Some(value)

/// The iterator of a closed integer range (SPEC 4.6.3.4).
///
/// It yields `start` upward in unit steps and `end` last, and never adds past `end`, so it also ends at the maximum
/// of `T`. Unless `end` is that maximum it iterates the half-open `[start, end + 1)` with its flag unset, so a loop over
/// it is a counted loop; only an end at the maximum is produced through the flag.
public struct ClosedRangeIterator<T>
    T is PrimitiveInteger
    Self is Iterator
    associate Iterator.Item is T
    var current: T
    let end: T
    var includesEnd: bool

    init(current: T, end: T, includesEnd: bool)
        self.current = current
        self.end = end
        self.includesEnd = includesEnd

    /// Starts at `start` after checking the order of a range entry.
    ///
    /// - abort: `start > end`.
    internal func starting(start: T, end: T) -> ClosedRangeIterator<T>
        require start <= end else => $abort("Reversed closed range")
        if ClosedRangeIterator<T>.isMaximum(end) => return ClosedRangeIterator<T>.init(start, end, true)
        return ClosedRangeIterator<T>.init(start, end + 1, false)

    // Whether `value` is the maximum of T, decided without its width and without overflow: shifting a one in from the
    // right leaves only an all-ones pattern unchanged, and the maximum is the nonnegative value whose shifted pattern is
    // all ones and not above it (all ones for an unsigned T; a zero followed by ones for a signed T).
    internal func isMaximum(value: T) -> bool
        let shifted = (value << 1) | 1
        return value >= 0 and shifted <= value and ((shifted << 1) | 1) == shifted

    /// Returns the next value, or None after `end`.
    public func next(self: uniq/Self) -> Option<T>
        let value = self.current
        if value < self.end
            self.current = value + 1
            return .Some(value)
        if self.includesEnd
            self.includesEnd = false
            return .Some(value)
        return .None

// SPEC 4.6.2-4.6.4: prefix `^` and range syntax construct their Types through these functions, and a position or range
// key of a built-in sequence selection that the compiler does not apply directly resolves through them. The compiler
// calls them by declaration, so neither a same-named source declaration nor the source's access rules affect them.
internal group PositionSyntax
    /// Constructs `^offset`.
    internal func fromEnd<T>(offset: T) -> FromEnd<T>
        T is PrimitiveInteger
        return FromEnd<T>.init(offset)

    /// Constructs `start..end`.
    internal func between<S, E>(start: S, end: E) -> Range<S, E>
        S is Position
        E is Position
        return Range<S, E>.init(start, end)

    /// Constructs `start..`.
    internal func from<S>(start: S) -> Range<S, End>
        S is Position
        return Range<S, End>.init(start, End.init())

    /// Constructs `..end`.
    internal func to<E>(end: E) -> Range<Start, E>
        E is Position
        return Range<Start, E>.init(Start.init(), end)

    /// Constructs `..`.
    internal func all() -> Range<Start, End> => Range<Start, End>.init(Start.init(), End.init())

    /// Constructs `start..=end`.
    internal func through<S, E>(start: S, end: E) -> ClosedRange<S, E>
        S is Position
        E is Position
        return ClosedRange<S, E>.init(start, end)

    /// Constructs `..=end`.
    internal func upTo<E>(end: E) -> ClosedRange<Start, E>
        E is Position
        return ClosedRange<Start, E>.init(Start.init(), end)

    /// Resolves `position` against `length`, or returns `-1` when it does not resolve.
    ///
    /// The caller's own bounds check rejects `-1`, so resolution and the check fail as one (SPEC 4.6.9).
    internal func resolved<P>(position: P, length: isize) -> isize
        P is Position
        match position.tryResolve(length)
            .Some(let resolved) => return resolved
            .None => return -1

    /// Resolves the range key of a sequence selection against `length`.
    ///
    /// A range that does not resolve yields an interval that the selection's own check rejects, so resolution and
    /// application fail as one (SPEC 4.6.4); the interval never reaches source code.
    internal func resolvedRange<R>(range: R, length: isize) -> ResolvedRange
        R is PositionRange
        match range.tryResolve(length)
            .Some(let resolved) => return resolved
            .None => return ResolvedRange.init(start: 0, end: -1)

/// A validated absolute half-open interval `[start, end)` with `0 <= start <= end` (SPEC 4.6.3.3).
///
/// Only `indices`, `resolve` and `tryResolve` produce it. A `for` loop over it runs the same positions as its
/// entries without an iterator value; selection with a ResolvedRange still checks `end` against the target's length.
public struct ResolvedRange
    Self is Copy
    Self is Equatable
    Self is PositionRange
    Self is Iterable
    associate Iterable.IteratorType(source) is RangeIterator<isize>
    Self is UniqIterable
    associate UniqIterable.IteratorType(source) is RangeIterator<isize>
    Self is IntoIterable
    associate IntoIterable.IteratorType is RangeIterator<isize>
    public let start: isize
    public let end: isize

    /// The number of positions in the interval, `end - start`.
    public computed length: isize
        get() -> isize
            return self.end - self.start

    /// Whether the interval contains no position.
    public computed isEmpty: bool
        get() -> bool
            return self.start == self.end

    /// Creates the interval `[start, end)` that `resolve` or `tryResolve` validated: `0 <= start <= end`.
    internal init(! start: isize, end: isize)
        self.start = start
        self.end = end

    /// Compares both bounds.
    public func equals(self: ref/Self, other: ref/Self) -> bool
        return self.start == other.start and self.end == other.end

    /// Returns this interval when its end does not exceed `length`, or None; its start needs no check (SPEC 4.6.4).
    public func tryResolve(self: Self, length: isize) -> Option<ResolvedRange>
        require self.end <= length else => return .None
        return .Some(self)

    /// Returns this interval when its end does not exceed `length`.
    ///
    /// - abort: The end exceeds `length`.
    public func resolve(self: Self, length: isize) -> ResolvedRange
        match self.tryResolve(length)
            .Some(let resolved) => return resolved
            .None => $abort("Range out of range")

    /// Writes `start..end`, as the Range<isize, isize> with the same boundaries is written.
    public func format(self: ref/Self, writer: uniq/Utf8Writer) -> Result<(), BufferFull>
        try writer.write(self.start)
        try writer.write("..")
        return writer.write(self.end)

    /// Returns an iterator over the positions `start` through `end - 1`; it keeps no borrow of the interval.
    public func iterate(self: ref/Self during source) -> RangeIterator<isize>
        return RangeIterator<isize>.unchecked(self.start, self.end)

    /// Returns an iterator over the positions `start` through `end - 1`; it keeps no borrow of the interval.
    public func iterateUniq(self: uniq/Self during source) -> RangeIterator<isize>
        return RangeIterator<isize>.unchecked(self.start, self.end)

    /// Returns an iterator over the positions `start` through `end - 1`.
    public func intoIterator(self: Self) -> RangeIterator<isize>
        return RangeIterator<isize>.unchecked(self.start, self.end)
