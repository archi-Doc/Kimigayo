public contract Copy
public contract Owned
public contract Callable
public contract Sealed
public contract ObjectPayload
public contract PrimitiveInteger

/// A boundary of a target of length `L` that resolves to an integer in `[0, L]` (SPEC 4.6.2).
///
/// A closed Contract: the twelve integer Types, `FromEnd<T>`, `Start` and `End` conform, and no other Type can.
public contract Position: Equatable, Utf8Format
    Self is Copy
    Self is Owned

    /// Resolves this position against `length`, or returns `None` when `length < 0` or the position lies outside
    /// `[0, length]`.
    func tryResolve(self: Self, length: isize) -> Option<isize>

/// An interval of positions that resolves against a length to a validated half-open interval (SPEC 4.6.4).
///
/// A closed Contract: `Range<S, E>`, `ClosedRange<S, E>` and `ResolvedRange` conform, and no other Type can.
public contract PositionRange: Equatable, Utf8Format
    Self is Copy
    Self is Owned

    /// Resolves this range against `length`, or returns `None` when `length < 0`, a boundary does not resolve or the
    /// resolved boundaries are reversed.
    func tryResolve(self: Self, length: isize) -> Option<ResolvedRange>

// SPEC 4.6.2, 8.4.7: the built-in integer conformance to Position. The compiler binds an integer's `tryResolve`
// requirement to this receiver function; integers gain no members.
internal group IntegerPosition
    /// Returns `self` as an isize boundary when `0 <= self <= length`, or None; no wide value is truncated first.
    public func tryResolve<I>(self: I, length: isize) -> Option<isize>
        I is PrimitiveInteger
        require self >= 0 and length >= 0 else => return .None
        require self@u128 <= length@u128 else => return .None
        return .Some(self@isize)

    specialize func tryResolve<isize>(self: isize, length: isize) -> Option<isize>
        require self >= 0 and self <= length else => return .None
        return .Some(self)

    specialize func tryResolve<i32>(self: i32, length: isize) -> Option<isize>
        let wide = self@isize
        require wide >= 0 and wide <= length else => return .None
        return .Some(wide)

    specialize func tryResolve<usize>(self: usize, length: isize) -> Option<isize>
        require length >= 0 and self <= length@usize else => return .None
        return .Some(self@isize)

public enum Option<T>
    Self is Copy when T is Copy
    Some(T)
    None

public enum Result<T, E>
    Ok(T)
    Err(E)

/// A Copy position measured from the start or, when `isFromEnd` is set, from the end of a sequence.
///
/// An Index retains no target (SPEC 4.6.2); `^n` constructs the from-end form.
public struct Index
    Self is Copy
    Self is Equatable
    public let offset: isize
    public let isFromEnd: bool

    /// Creates a position `offset` elements from the start, or from the end when `fromEnd` is true.
    ///
    /// - abort: `offset < 0`.
    public init(offset: isize, fromEnd: bool = false)
        require offset >= 0 else => $abort("Negative Index offset")
        self.offset = offset
        self.isFromEnd = fromEnd

    /// Creates a from-start position without checking its sign; only the forms below and range syntax use it.
    init(! unchecked: isize)
        self.offset = unchecked
        self.isFromEnd = false

    /// Forms a from-start position from an integer boundary of range syntax (SPEC 4.6.2).
    ///
    /// An offset that is negative or not representable as isize becomes `-1`, so IndexRange construction checks
    /// the boundaries in order after both are evaluated (SPEC 4.6.4). `limit` is the target's isize maximum.
    internal func unchecked<I>(offset: I, limit: isize) -> Index
        I is PrimitiveInteger
        match Index.tryPosition(offset, limit)
            .Some(let position) => return Index.init(unchecked: position)
            .None => return Index.init(unchecked: -1)

    /// Returns `value` as an isize when `0 <= value <= limit`, or None; shared by Index formation and range resolution.
    internal func tryPosition<I>(value: I, limit: isize) -> Option<isize>
        I is PrimitiveInteger
        require value >= 0 and limit >= 0 else => return .None
        require value@u128 <= limit@u128 else => return .None
        return .Some(value@isize)

    specialize func tryPosition<isize>(value: isize, limit: isize) -> Option<isize>
        require value >= 0 and value <= limit else => return .None
        return .Some(value)

    specialize func tryPosition<i32>(value: i32, limit: isize) -> Option<isize>
        let wide = value@isize
        require wide >= 0 and wide <= limit else => return .None
        return .Some(wide)

    specialize func tryPosition<usize>(value: usize, limit: isize) -> Option<isize>
        require limit >= 0 and value <= limit@usize else => return .None
        return .Some(value@isize)

    /// Compares both the offset and the direction; `^0` and `0` are different positions.
    public func equals(self: ref/Self, other: ref/Self) -> bool
        return self.offset == other.offset and self.isFromEnd == other.isFromEnd

    /// Resolves this position against `length` to an absolute boundary in `[0, length]`.
    ///
    /// A boundary may equal `length` (SPEC 4.6.4); `^0` resolves to the length itself.
    ///
    /// - abort: The position lies outside `[0, length]`.
    public func resolve(self, length: isize) -> isize
        match self.tryResolve(length)
            .Some(let position) => return position
            .None => $abort("Index out of range")

    /// Resolves this position against `length`, returning `None` instead of Aborting when it is out of range.
    public func tryResolve(self, length: isize) -> Option<isize>
        require length >= 0 and self.offset >= 0 and self.offset <= length else => return .None
        if self.isFromEnd => return .Some(length - self.offset)
        return .Some(self.offset)

/// Unresolved start and end positions with an end-inclusion flag (SPEC 4.6.3.3).
///
/// Range syntax constructs an IndexRange through the internal Type functions below, its normal forms: an omitted
/// start is `0` and an omitted end is `^0`. They check the integer boundaries in boundary order after both
/// boundaries are evaluated (SPEC 4.6.4). An IndexRange is a Copy value, retains no target and is not iterable;
/// resolve it against a length to obtain a ResolvedRange.
public struct IndexRange
    Self is Copy
    Self is Equatable
    public let start: Index
    public let end: Index
    public let isInclusive: bool

    /// Checks both boundaries in order after range syntax evaluated them (SPEC 4.6.4).
    ///
    /// - abort: A boundary offset is negative or not representable as isize.
    init(start: Index, end: Index, inclusive: bool)
        require start.offset >= 0 else => $abort("Invalid range start")
        require end.offset >= 0 else => $abort("Invalid range end")
        self.start = start
        self.end = end
        self.isInclusive = inclusive

    /// Creates the half-open range `start..end`.
    internal func between(start: Index, end: Index) -> IndexRange => IndexRange.init(start, end, false)

    /// Creates the range `start..`, which ends at `^0`.
    internal func from(start: Index) -> IndexRange => IndexRange.init(start, Index.init(0, fromEnd: true), false)

    /// Creates the range `..end`, which starts at `0`.
    internal func to(end: Index) -> IndexRange => IndexRange.init(Index.init(0), end, false)

    /// Creates the range `..`, which covers a whole sequence.
    internal func all() -> IndexRange => IndexRange.init(Index.init(0), Index.init(0, fromEnd: true), false)

    /// Creates the inclusive range `start..=end`.
    internal func through(start: Index, end: Index) -> IndexRange => IndexRange.init(start, end, true)

    /// Creates the inclusive range `..=end`, which starts at `0`.
    internal func upTo(end: Index) -> IndexRange => IndexRange.init(Index.init(0), end, true)

    /// Compares the unresolved boundaries and the inclusion flag; `0..2` and `0..=1` are different values.
    public func equals(self: ref/Self, other: ref/Self) -> bool
        return self.start == other.start and self.end == other.end and self.isInclusive == other.isInclusive

    /// Resolves both boundaries against `length` into a validated half-open interval.
    ///
    /// - abort: A boundary lies outside `[0, length]`, an inclusive end equals `length`, or the resolved start
    ///   exceeds the resolved end.
    public func resolve(self, length: isize) -> ResolvedRange
        match self.tryResolve(length)
            .Some(let resolved) => return resolved
            .None => $abort("Range out of range")

    /// Resolves both boundaries against `length`, returning `None` instead of Aborting.
    ///
    /// Both boundaries must resolve within `[0, length]`; an inclusive end must lie below the length and is
    /// normalized to the half-open form (SPEC 4.6.4).
    public func tryResolve(self, length: isize) -> Option<ResolvedRange>
        var first: isize = 0
        var last: isize = 0
        match self.start.tryResolve(length)
            .Some(let position) => first = position
            .None => return .None
        match self.end.tryResolve(length)
            .Some(let position) => last = position
            .None => return .None
        if self.isInclusive
            require last < length else => return .None
            last = last + 1
        require first <= last else => return .None
        return .Some(ResolvedRange.init(start: first, end: last))

/// An interval of integers of `T` (SPEC 4.6.3.2).
///
/// Range syntax with two integer boundaries constructs it through the internal Type functions below. Construction
/// checks no order; iteration, resolution and slicing check the boundaries when they use the value.
public struct Range<T>
    T is PrimitiveInteger
    Self is Copy
    Self is Equatable
    Self is Iterable
    associate Iterable.IteratorType(source) is RangeIterator<T>
    Self is UniqIterable
    associate UniqIterable.IteratorType(source) is RangeIterator<T>
    Self is IntoIterable
    associate IntoIterable.IteratorType is RangeIterator<T>
    public let start: T
    public let end: T
    public let isInclusive: bool

    init(start: T, end: T, inclusive: bool)
        self.start = start
        self.end = end
        self.isInclusive = inclusive

    /// Creates the half-open range `start..end` for range syntax.
    internal func between(start: T, end: T) -> Range<T> => Range<T>.init(start, end, false)

    /// Creates the inclusive range `start..=end` for range syntax.
    internal func through(start: T, end: T) -> Range<T> => Range<T>.init(start, end, true)

    /// Compares both boundaries and the inclusion flag; `0..3` and `0..=2` are different values.
    public func equals(self: ref/Self, other: ref/Self) -> bool
        return self.start == other.start and self.end == other.end and self.isInclusive == other.isInclusive

    /// Resolves the integers as positions against `length` into a validated half-open interval (SPEC 4.6.4).
    ///
    /// - abort: `length` is negative, the range is reversed, or a boundary lies outside the target.
    public func resolve(self, length: isize) -> ResolvedRange
        match self.tryResolve(length)
            .Some(let resolved) => return resolved
            .None => $abort("Range out of range")

    /// Resolves the integers as positions against `length`, returning `None` instead of Aborting.
    ///
    /// A half-open range needs `0 <= start <= end <= length` and an inclusive one `0 <= start <= end < length`.
    public func tryResolve(self, length: isize) -> Option<ResolvedRange>
        require length >= 0 else => return .None
        var limit = length
        if self.isInclusive => limit = length - 1
        match Index.tryPosition(self.end, limit)
            .Some(let last)
                match Index.tryPosition(self.start, last)
                    .Some(let first)
                        if self.isInclusive => return .Some(ResolvedRange.init(start: first, end: last + 1))
                        return .Some(ResolvedRange.init(start: first, end: last))
                    .None => return .None
            .None => return .None

    /// Starts a shared enumeration from `start` upward; a reversed range Aborts (SPEC 4.6.3.5).
    public func iterate(self: ref/Self during source) -> RangeIterator<T>
        return RangeIterator<T>.starting(self.start, self.end, self.isInclusive)

    /// Starts an enumeration through an exclusive borrow; the range itself does not change.
    public func iterateUniq(self: uniq/Self during source) -> RangeIterator<T>
        return RangeIterator<T>.starting(self.start, self.end, self.isInclusive)

    /// Starts an enumeration of the consumed range value.
    public func intoIterator(self: Self) -> RangeIterator<T>
        return RangeIterator<T>.starting(self.start, self.end, self.isInclusive)

/// The standard integer range iterator (SPEC 4.6.3.5).
///
/// It yields the values below `end` in unit steps, then `end` once when the range included it, and never adds past
/// its last value, so it also ends at the maximum of `T`.
public struct RangeIterator<T>
    T is PrimitiveInteger
    Self is Iterator
    associate Iterator.Item is T
    var current: T
    let end: T
    var includesEnd: bool

    init(current: T, end: T, includesEnd: bool)
        self.current = current
        self.end = end
        self.includesEnd = includesEnd

    /// Starts at `start` after checking the order of a range entry.
    ///
    /// - abort: `start > end`.
    internal func starting(start: T, end: T, inclusive: bool) -> RangeIterator<T>
        require start <= end else => $abort("Reversed range")
        return RangeIterator<T>.init(start, end, inclusive)

    /// Starts at `start` of a validated half-open interval, which is never reversed.
    internal func unchecked(start: T, end: T) -> RangeIterator<T> => RangeIterator<T>.init(start, end, false)

    /// Returns the next value, or None after the last one.
    public func next(self: uniq/Self) -> Option<T>
        let value = self.current
        if value < self.end
            self.current = value + 1
            return .Some(value)
        if self.includesEnd
            self.includesEnd = false
            return .Some(value)
        return .None

/// A validated absolute half-open interval `[start, end)` with `0 <= start <= end` (SPEC 4.6.3.4).
///
/// Only `indices`, `resolve` and `tryResolve` produce it. A `for` loop over it runs the same positions as its
/// entries without an iterator value; selection with a ResolvedRange still checks `end` against the target's length.
public struct ResolvedRange
    Self is Copy
    Self is Equatable
    Self is PositionRange
    Self is Iterable
    associate Iterable.IteratorType(source) is RangeIterator<isize>
    Self is UniqIterable
    associate UniqIterable.IteratorType(source) is RangeIterator<isize>
    Self is IntoIterable
    associate IntoIterable.IteratorType is RangeIterator<isize>
    public let start: isize
    public let end: isize

    /// The number of positions in the interval, `end - start`.
    public computed length: isize
        get() -> isize
            return self.end - self.start

    /// Whether the interval contains no position.
    public computed isEmpty: bool
        get() -> bool
            return self.start == self.end

    /// Creates the interval `[start, end)` that `resolve` or `tryResolve` validated: `0 <= start <= end`.
    internal init(! start: isize, end: isize)
        self.start = start
        self.end = end

    /// Compares both bounds.
    public func equals(self: ref/Self, other: ref/Self) -> bool
        return self.start == other.start and self.end == other.end

    /// Returns this interval when its end does not exceed `length`, or None; its start needs no check (SPEC 4.6.4).
    public func tryResolve(self: Self, length: isize) -> Option<ResolvedRange>
        require self.end <= length else => return .None
        return .Some(self)

    /// Returns this interval when its end does not exceed `length`.
    ///
    /// - abort: The end exceeds `length`.
    public func resolve(self: Self, length: isize) -> ResolvedRange
        match self.tryResolve(length)
            .Some(let resolved) => return resolved
            .None => $abort("Range out of range")

    /// Writes `start..end`, as the Range<isize, isize> with the same boundaries is written.
    public func format(self: ref/Self, writer: uniq/Utf8Writer) -> Result<(), BufferFull>
        try writer.write(self.start)
        try writer.write("..")
        return writer.write(self.end)

    /// Returns an iterator over the positions `start` through `end - 1`; it keeps no borrow of the interval.
    public func iterate(self: ref/Self during source) -> RangeIterator<isize>
        return RangeIterator<isize>.unchecked(self.start, self.end)

    /// Returns an iterator over the positions `start` through `end - 1`; it keeps no borrow of the interval.
    public func iterateUniq(self: uniq/Self during source) -> RangeIterator<isize>
        return RangeIterator<isize>.unchecked(self.start, self.end)

    /// Returns an iterator over the positions `start` through `end - 1`.
    public func intoIterator(self: Self) -> RangeIterator<isize>
        return RangeIterator<isize>.unchecked(self.start, self.end)
