// UTF-8 formatting declarations (SPEC 22.9, 22.10). Text.writer (the erased adapter), Text.toString and Text.tryFormat
// are compiler implementations (Text.kimi); the buffers, windows and the other Text operations are bodies here, each
// raw Field's storage where its Origin states (SPEC 5.7).
public struct BufferFull
    Self is Copy
    public init() => ()

public contract BufferWriter
    func reserve(self: uniq/Self, minimum: isize) -> Result<WriteWindow, BufferFull>
        effect confined

public contract Utf8Format
    func format(self: ref/Self, writer: uniq/Utf8Writer) -> Result<(), BufferFull>

public struct WriteWindow {source}
    Self is not ObjectPayload
    let state: raw/u8 during source
    let start: isize
    public var written: isize
        private set
    public var remaining: isize
        private set
    let loan: Loan<uniq/u8 during source>

    /// A window of `remaining` bytes after the `start` committed bytes of the buffer at `state`. The caller's obligations,
    /// which the signature cannot state: `state` addresses a `Text.FixedBuffer` or a `Text.HeapBuffer` in what `source`
    /// covers, with write authority, whose capacity holds `start + remaining` bytes (SPEC 5.2.1, 22.9.4).
    internal init(state: raw/u8 during source, start: isize, remaining: isize)
        self.state = state
        self.start = start
        self.written = 0
        self.remaining = remaining
        self.loan = Loan<uniq/u8 during source>.init()

    /// Writes `byte` after the written bytes; `BufferFull`, changing nothing, when no capacity remains (SPEC 22.9.4).
    public func push(self: uniq/Self, byte: u8) -> Result<(), BufferFull>
        if self.remaining == 0 => return .Err(BufferFull.init())
        unsafe => *self.next() = byte
        self.written += 1
        self.remaining -= 1
        return .Ok(())

    /// Writes `bytes` after the written bytes; `BufferFull`, changing nothing, unless all of them fit (SPEC 22.9.4).
    public func append(self: uniq/Self, bytes: Slice<u8>) -> Result<(), BufferFull>
        let length = bytes.length
        if length > self.remaining => return .Err(BufferFull.init())
        if length != 0
            // The source is readable bytes, never this window's unwritten capacity, so the two ranges do not overlap.
            unsafe => Storage.transferBytes(self.next(), (*(bytes@raw@raw/Storage.SliceRepr<u8>)).data, length)
        self.written += length
        self.remaining -= length
        return .Ok(())

    /// The window with capacity `min(capacity, maximum)` (SPEC 22.9.4).
    ///
    /// - abort: `maximum` is below `written`.
    public func limit(self: owner/Self, maximum: isize) -> Self{r}
        origin r.source == self.source
        if maximum < self.written => Storage.argumentOutOfRange()
        var window = self@move
        if maximum - window.written < window.remaining => window.remaining = maximum - window.written
        return window@move

    /// Commits the written prefix and returns its length (SPEC 22.9.4).
    public func commit(self: owner/Self) -> isize
        unsafe => (*(self.state@raw/Storage.BufferRepr)).length = self.start + self.written
        return self.written

    /// Commits the written prefix as an adapter commit: the validated length follows when the buffer was fully
    /// validated, so output written only through adapters needs no later scan (SPEC 22.9.3).
    internal func commitUtf8(self: owner/Self)
        unsafe
            let buffer = self.state@raw/Storage.BufferRepr
            let complete = (*buffer).length == (*buffer).validated
            (*buffer).length = self.start + self.written
            if complete => (*buffer).validated = (*buffer).length

    // The first unwritten byte: the buffer's data past `start + written`.
    func next(self: ref/Self) -> raw/u8
        unsafe => return (*(self.state@raw/Storage.BufferRepr)).data + self.start + self.written

public struct Utf8Writer {target}
    Self is not ObjectPayload
    // `destination` and `dispatch` are the adapter's first two words, which the kept runtime's `__kimi_erased_reserve`
    // reads (`RuntimeLayoutsAreFixed` pins them).
    let destination: raw/u8 during target
    // The selected `reserve` implementation's code, or null: nothing reads or writes through it.
    let dispatch: raw/u8 during static
    // The destination's writer kind, `LegacyRuntimeHelpers.WriterKind`'s closed numbering until R8-W2: 0 a
    // `Text.FixedBuffer`, 1 a `Text.HeapBuffer`, 2 a user Writer, reserved through `dispatch`.
    let kind: isize
    var failed: bool
    // An owning interpolation's growth hint: its later literal bytes and values (SPEC 22.10.5); 0 elsewhere.
    let hint: isize
    // A deferred string literal's bytes, which are static storage (SPEC 3.1.2).
    let pending: raw/u8 during static
    var pendingLength: isize
    let logicalLength: isize
    let loan: Loan<uniq/u8 during target>

    /// The recorded failure without formatting; otherwise `value`'s `format` once, the first failure it returns or a nested write
    /// recorded being recorded and returned (SPEC 22.10.1).
    ///
    /// - abort: a built-in `format`'s reservation exceeds the maximum object size or cannot allocate, at the caller (SPEC 22.5.1).
    public func write<T>(self: uniq/Self, value: ref/T) -> Result<(), BufferFull>
        T is Utf8Format
        if self.failed => return .Err(BufferFull.init())
        var healthy = false
        match value.format(self)@move
            .Ok(_) => healthy = not self.failed
            .Err(_) => ()
        if healthy => return .Ok(())
        self.failed = true
        return .Err(BufferFull.init())

    /// The recorded failure (SPEC 22.10.1).
    public func status(self: ref/Self) -> Result<(), BufferFull>
        if self.failed => return .Err(BufferFull.init())
        return .Ok(())

    /// Writes `text` with one exact reservation, none when it is empty, and records a failed reservation
    /// (SPEC 22.10.1). It has no failure test of its own: only the adapter `write` has that guard.
    internal func writeUtf8(self: uniq/Self, text: Text.Utf8Slice) -> Result<(), BufferFull>
        let bytes = text.bytes()
        if bytes.length == 0 => return .Ok(())
        var window = try self.reserve(bytes.length)
        try (window@uniq).append(bytes)
        (window@move).commitUtf8()
        return .Ok(())

    /// The adapter's reservation of `amount` bytes (SPEC 22.9.4, 22.10.1): `BufferFull` when a failure is recorded;
    /// else the destination's window for `amount` and the deferred literal, which it writes first, or a recorded
    /// `BufferFull`. Pending may sit on an adapter of any kind; the shared tail prepends it; only the kind-1 arm reads
    /// the hint, which a buffer that must grow adds unless the sum exceeds the maximum object size. The caller's
    /// obligation, which the signature cannot state: it commits or drops the window before the next reservation of
    /// this adapter, since the window's Origin is the destination's, not this borrow's.
    ///
    /// - abort: `amount` and the deferred literal exceed the maximum object size.
    internal func reserve(self: uniq/Self, amount: isize) -> Result<WriteWindow during target, BufferFull>
        if self.failed => return .Err(BufferFull.init())
        let largest: isize = 9223372036854775807
        if amount > largest - self.pendingLength => Storage.allocationSizeExceeded()
        var minimum = amount + self.pendingLength
        unsafe
            if self.kind == 0
                let fixed = self.destination@raw/(Text.FixedBuffer during target)
                return self.settled(((*fixed)@uniq).reserve(minimum))
            if self.kind == 1
                let heap = self.destination@raw/Text.HeapBuffer
                let length = (*heap).length
                if minimum > (*heap).capacity - length and minimum <= largest - length
                    if self.hint <= largest - length - minimum => minimum += self.hint
                return self.settled(((*heap)@uniq).reserve(minimum))
        if self.kind == 2
            let reserved = Storage.erasedReserve(self, minimum)
            return self.settled(reserved@move)
        $abort("Utf8Writer: writer kind outside 0, 1 and 2")

    // Every kind's shared tail (SPEC 22.10.1): a failure recorded; else the deferred literal written first.
    func settled(self: uniq/Self, reserved: Result<WriteWindow during target, BufferFull>)
        -> Result<WriteWindow during target, BufferFull>
        match reserved@move
            .Ok(let window)
                var settled = window@move
                let pending = self.pendingLength
                if pending != 0
                    // Cannot fail: every kind reserved `amount + pendingLength`, so the deferred literal fits.
                    unsafe => try (settled@uniq).append(Raw.slice(self.pending, pending))
                    self.pendingLength = 0
                return .Ok(settled@move)
            .Err(_)
                self.failed = true
                return .Err(BufferFull.init())

public group Text
    public struct InvalidUtf8
        Self is Copy
        public init() => ()

    public struct FixedBuffer {source}
        Self is BufferWriter
        Self is not ObjectPayload
        let data: raw/u8 during source
        public let capacity: isize
        public var length: isize
            private set
        var validated: isize
        let loan: Loan<uniq/u8 during source>

        /// An empty buffer of capacity `capacity` over the bytes at `data`. The caller's obligations, which the
        /// signature cannot state: `data` addresses `capacity` initialized bytes in what `source` covers, with write
        /// authority (SPEC 5.2.1, 22.9.2).
        internal init(data: raw/u8 during source, capacity: isize)
            self.data = data
            self.capacity = capacity
            self.length = 0
            self.validated = 0
            self.loan = Loan<uniq/u8 during source>.init()

        /// The committed bytes.
        public func bytes(self: ref/Self) -> Slice<u8>
            unsafe => return Raw.slice(self.data, self.length)

        /// Validates the unvalidated suffix and views the committed bytes; records nothing (SPEC 22.9.3).
        public func text(self: ref/Self) -> Result<Text.Utf8Slice, Text.InvalidUtf8>
            unsafe
                if not Text.validUtf8(self.data + self.validated, self.length - self.validated) => return .Err(Text.InvalidUtf8.init())
                return .Ok(Text.Utf8Slice.init(Raw.slice(self.data, self.length)))

        /// Records the committed bytes as validated, only on complete success (SPEC 22.9.3).
        public func validate(self: uniq/Self) -> Result<(), Text.InvalidUtf8>
            unsafe
                if not Text.validUtf8(self.data + self.validated, self.length - self.validated) => return .Err(Text.InvalidUtf8.init())
            self.validated = self.length
            return .Ok(())

        /// Sets both lengths to zero and keeps the capacity (SPEC 22.9.3).
        public func clear(self: uniq/Self)
            self.length = 0
            self.validated = 0

        /// A window over the unused capacity, `BufferFull` exactly when it is below `minimum` (SPEC 22.9.4).
        ///
        /// - abort: `minimum` is negative.
        public func reserve(self: uniq/Self, minimum: isize) -> Result<WriteWindow, BufferFull>
            if minimum < 0 => Storage.argumentOutOfRange()
            let remaining = self.capacity - self.length
            if minimum > remaining => return .Err(BufferFull.init())
            return .Ok(WriteWindow.init(self@follow@raw@raw/u8, self.length, remaining))

        /// Validates the unvalidated suffix and views the committed bytes under the array's exclusive Loan (SPEC 22.9.3).
        public func intoText(self: owner/Self) -> Result<Text.Utf8Slice during self.source, Text.InvalidUtf8>
            unsafe
                if not Text.validUtf8(self.data + self.validated, self.length - self.validated) => return .Err(Text.InvalidUtf8.init())
                return .Ok(Text.Utf8Slice.init(Raw.slice(self.data, self.length)))

    public struct HeapBuffer
        Self is BufferWriter
        var data: raw/u8 during self
        public var capacity: isize
            private set
        public var length: isize
            private set
        var validated: isize

        /// An empty buffer without an allocation (SPEC 22.9.2).
        internal init()
            self.data = null
            self.capacity = 0
            self.length = 0
            self.validated = 0

        drop
            unsafe => Raw.release(self.data)

        /// The committed bytes.
        public func bytes(self: ref/Self) -> Slice<u8>
            unsafe => return Raw.slice(self.data, self.length)

        /// Validates the unvalidated suffix and views the committed bytes; records nothing (SPEC 22.9.3).
        public func text(self: ref/Self) -> Result<Text.Utf8Slice, Text.InvalidUtf8>
            unsafe
                if not Text.validUtf8(self.data + self.validated, self.length - self.validated) => return .Err(Text.InvalidUtf8.init())
                return .Ok(Text.Utf8Slice.init(Raw.slice(self.data, self.length)))

        /// Records the committed bytes as validated, only on complete success (SPEC 22.9.3).
        public func validate(self: uniq/Self) -> Result<(), Text.InvalidUtf8>
            unsafe
                if not Text.validUtf8(self.data + self.validated, self.length - self.validated) => return .Err(Text.InvalidUtf8.init())
            self.validated = self.length
            return .Ok(())

        /// Sets both lengths to zero and keeps the capacity (SPEC 22.9.3).
        public func clear(self: uniq/Self)
            self.length = 0
            self.validated = 0

        /// A window over at least `minimum` unused bytes; never `BufferFull` (SPEC 22.9.4). Growth reaches
        /// `max(length + minimum, 2 * capacity)`, or `length + minimum` when the double exceeds the maximum object size, and
        /// copies the committed bytes.
        ///
        /// - abort: `minimum` is negative, or `length + minimum` exceeds the maximum object size.
        public func reserve(self: uniq/Self, minimum: isize) -> Result<WriteWindow, BufferFull>
            if minimum < 0 => Storage.argumentOutOfRange()
            let length = self.length
            let capacity = self.capacity
            if minimum > capacity - length
                let largest: isize = 9223372036854775807
                if minimum > largest - length => Storage.allocationSizeExceeded()
                var target = length + minimum
                // `capacity <= largest / 2` bounds the product.
                if capacity <= largest / 2
                    if capacity * 2 > target => target = capacity * 2
                let memory = Raw.allocate<u8>(target)
                unsafe
                    if length != 0 => Storage.transferBytes(memory, self.data, length)
                    Raw.release(self.data)
                    // A claim: the new allocation is storage the buffer owns, as its old one was (SPEC 5.7).
                    self.data = memory@(raw/u8 during self)
                self.capacity = target
            return .Ok(WriteWindow.init(self@follow@raw@raw/u8, length, self.capacity - length))

        /// Validates the unvalidated suffix and transfers the allocation to the string without copying; on failure it releases
        /// the allocation (SPEC 22.9.3). An allocated empty buffer keeps its pointer and the Heap release kind.
        public func intoString(self: owner/Self) -> Result<string, Text.InvalidUtf8>
            // Held so that the compiler does not destroy the buffer whose allocation this call releases or transfers (SPEC 5.2.3).
            var held = Storage.InlineStorage<Text.HeapBuffer>.init(self@move)
            let data = held.value.data
            let length = held.value.length
            let validated = held.value.validated
            unsafe
                if not Text.validUtf8(data + validated, length - validated)
                    Raw.release(data)
                    return .Err(Text.InvalidUtf8.init())
            var kind: u8 = 0
            if data != null => kind = 1
            var text = Storage.InlineStorage<Storage.StringRepr>.init(Storage.StringRepr.init(data, length, kind))
            unsafe => return .Ok((*(text@raw@raw/string))@move)

    public struct Utf8Slice {source}
        Self is Copy
        let value: Slice<u8> during source

        /// Views `value`, which the caller has validated as UTF-8 (SPEC 22.9.3).
        internal init(value: Slice<u8> during source) => self.value = value
        public computed length: isize
            get() -> isize => self.value.length
        public func bytes(self: Self) -> Slice<u8> during self.source
            return self.value

    /// A buffer over the initialized array: length zero, capacity `N` (SPEC 22.9.2).
    public func fixed<length N>(destination: uniq/[N of u8]) -> FixedBuffer
        return Text.FixedBuffer.init(destination@follow@raw@raw/u8, destination.length)

    /// A buffer of length zero and capacity `capacity`; zero allocates nothing (SPEC 22.9.2).
    ///
    /// - abort: `capacity` is negative, or the allocation fails.
    public func heap(capacity: isize) -> HeapBuffer
        if capacity < 0 => Storage.argumentOutOfRange()
        var buffer = Text.HeapBuffer.init()
        // An empty buffer grows to exactly `capacity` (SPEC 22.9.4), its one allocation.
        if capacity != 0 => _ = (buffer@uniq).reserve(capacity)
        return buffer@move

    /// Views the string's bytes, which are valid UTF-8 (SPEC 3.1.2, 22.9.2).
    public func utf8(text: ref/string) -> Utf8Slice
        let repr = text@follow@raw@raw/Storage.StringRepr
        unsafe => return Text.Utf8Slice.init(Raw.slice((*repr).data, (*repr).length))

    /// Validates `bytes` once and views them (SPEC 22.9.2, 22.9.3).
    public func validateUtf8(bytes: Slice<u8>) -> Result<Utf8Slice during bytes.source, InvalidUtf8>
        let repr = bytes@raw@raw/Storage.SliceRepr<u8>
        unsafe
            if not Text.validUtf8((*repr).data, bytes.length) => return .Err(Text.InvalidUtf8.init())
        return .Ok(Text.Utf8Slice.init(bytes))

    /// Whether the `length` bytes at `data` are exactly UTF-8 encodings of Unicode scalar values (SPEC 22.9.3): a
    /// truncated sequence, an overlong encoding, a surrogate or a value above U+10FFFF is not; NUL is ASCII. A bound
    /// precedes each read, and the index only steps by one under it, so no step can overflow.
    ///
    /// - safety: `length >= 0`, and the `length` bytes at `data` lie within its provenance and are readable.
    internal unsafe func validUtf8(data: raw/u8, length: isize) -> bool
        unsafe
            var index: isize = 0
            while index < length
                let lead = *(data + index)
                index += 1
                if lead >= 128
                    if lead < 194 or lead > 244 => return false
                    var rest: isize = 3
                    var mask: u8 = 7
                    var minimum: u32 = 65536
                    if lead < 240
                        rest = 2
                        mask = 15
                        minimum = 2048
                    if lead < 224
                        rest = 1
                        mask = 31
                        minimum = 128
                    var scalar = (lead & mask)@u32
                    while rest > 0
                        if index >= length => return false
                        let byte = *(data + index)
                        if (byte & 192) != 128 => return false
                        scalar = (scalar << 6) | (byte & 63)@u32
                        index += 1
                        rest -= 1
                    if scalar < minimum or scalar > 1114111 => return false
                    if scalar >= 55296 and scalar < 57344 => return false
            return true
