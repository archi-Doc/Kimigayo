// UTF-8 formatting declarations (SPEC 22.9, 22.10). Text.writer, the erased adapter, is a compiler implementation
// (Text.kimi); the buffers, windows, the other Text operations and Console.writeLine of a view are bodies here, each
// raw Field's storage where its Origin states (SPEC 5.7).
public struct BufferFull
    Self is Copy
    public init() => ()

public contract BufferWriter
    func reserve(self: uniq/Self, minimum: isize) -> Result<WriteWindow, BufferFull>
        effect confined

public contract Utf8Format
    func format(self: ref/Self, writer: uniq/Utf8Writer) -> Result<(), BufferFull>

public struct WriteWindow {source}
    Self is not ObjectPayload
    let state: raw/u8 during source
    let start: isize
    public var written: isize
        private set
    public var remaining: isize
        private set
    let loan: Loan<uniq/u8 during source>

    /// A window of `remaining` bytes after the `start` committed bytes of the buffer at `state`. The caller's obligations,
    /// which the signature cannot state: `state` addresses a `Text.FixedBuffer` or a `Text.HeapBuffer` in what `source`
    /// covers, with write authority, whose capacity holds `start + remaining` bytes (SPEC 5.2.1, 22.9.4).
    internal init(state: raw/u8 during source, start: isize, remaining: isize)
        self.state = state
        self.start = start
        self.written = 0
        self.remaining = remaining
        self.loan = Loan<uniq/u8 during source>.init()

    /// Writes `byte` after the written bytes; `BufferFull`, changing nothing, when no capacity remains (SPEC 22.9.4).
    public func push(self: uniq/Self, byte: u8) -> Result<(), BufferFull>
        if self.remaining == 0 => return .Err(BufferFull.init())
        unsafe => *self.next() = byte
        self.advance(1)
        return .Ok(())

    /// Writes `bytes` after the written bytes; `BufferFull`, changing nothing, unless all of them fit (SPEC 22.9.4).
    public func append(self: uniq/Self, bytes: Slice<u8>) -> Result<(), BufferFull>
        let length = bytes.length
        if length > self.remaining => return .Err(BufferFull.init())
        if length != 0
            // The source is readable bytes, never this window's unwritten capacity, so the two ranges do not overlap.
            unsafe => Storage.transferBytes(self.next(), (*(bytes@raw@raw/Storage.SliceRepr<u8>)).data, length)
        self.advance(length)
        return .Ok(())

    /// The window with capacity `min(capacity, maximum)` (SPEC 22.9.4).
    ///
    /// - abort: `maximum` is below `written`.
    public func limit(self: owner/Self, maximum: isize) -> Self{r}
        origin r.source == self.source
        if maximum < self.written => Storage.argumentOutOfRange()
        var window = self@move
        // `0 <= written <= maximum` bounds the difference.
        let room = (maximum@Wrapping<isize> - window.written@Wrapping<isize>)@isize
        if room < window.remaining => window.remaining = room
        return window@move

    /// Commits the written prefix and returns its length (SPEC 22.9.4).
    public func commit(self: owner/Self) -> isize
        unsafe => (*(self.state@raw/Storage.BufferRepr)).length = self.end()
        return self.written

    /// Commits the written prefix as an adapter commit: the validated length follows when the buffer was fully
    /// validated, so output written only through adapters needs no later scan (SPEC 22.9.3).
    internal func commitUtf8(self: owner/Self)
        unsafe
            let buffer = self.state@raw/Storage.BufferRepr
            let complete = (*buffer).length == (*buffer).validated
            (*buffer).length = self.end()
            if complete => (*buffer).validated = (*buffer).length

    // Records `count` more written bytes, `0 <= count <= remaining`. The window keeps `0 <= written`, `0 <= remaining`
    // and `start + written + remaining <= capacity`, so neither step overflows.
    func advance(self: uniq/Self, count: isize)
        self.written = (self.written@Wrapping<isize> + count@Wrapping<isize>)@isize
        self.remaining = (self.remaining@Wrapping<isize> - count@Wrapping<isize>)@isize

    // The buffer's length after the written bytes; the capacity bounds the sum.
    func end(self: ref/Self) -> isize
        return (self.start@Wrapping<isize> + self.written@Wrapping<isize>)@isize

    // The first unwritten byte: the buffer's data past `start + written`.
    func next(self: ref/Self) -> raw/u8
        unsafe => return (*(self.state@raw/Storage.BufferRepr)).data + self.end()

public struct Utf8Writer {target}
    Self is not ObjectPayload
    // `destination` and `dispatch` are the adapter's first two words, which the kept runtime's `__kimi_erased_reserve`
    // reads (`RuntimeLayoutsAreFixed` pins them).
    let destination: raw/u8 during target
    // The selected `reserve` implementation's code, or null: nothing reads or writes through it.
    let dispatch: raw/u8 during static
    // The destination's writer kind, `LegacyRuntimeHelpers.WriterKind`'s closed numbering until R8-W2: 0 a
    // `Text.FixedBuffer`, 1 a `Text.HeapBuffer`, 2 a user Writer, reserved through `dispatch`.
    let kind: isize
    var failed: bool
    // An owning interpolation's growth hint: its later literal bytes and values (SPEC 22.10.5); 0 elsewhere.
    let hint: isize
    // A deferred string literal's bytes, which are static storage (SPEC 3.1.2).
    let pending: raw/u8 during static
    var pendingLength: isize
    let logicalLength: isize
    let loan: Loan<uniq/u8 during target>

    /// The recorded failure without formatting; otherwise `value`'s `format` once, the first failure it returns or a
    /// nested write recorded being recorded and returned (SPEC 22.10.1).
    ///
    /// - abort: a built-in `format`'s reservation exceeds the maximum object size or cannot allocate, at the caller
    ///   (SPEC 22.5.1).
    public func write<T>(self: uniq/Self, value: ref/T) -> Result<(), BufferFull>
        T is Utf8Format
        if self.failed => return .Err(BufferFull.init())
        var healthy = false
        match value.format(self)@move
            .Ok(_) => healthy = not self.failed
            .Err(_) => ()
        if healthy => return .Ok(())
        self.failed = true
        return .Err(BufferFull.init())

    /// The recorded failure (SPEC 22.10.1).
    public func status(self: ref/Self) -> Result<(), BufferFull>
        if self.failed => return .Err(BufferFull.init())
        return .Ok(())

    /// Writes `text` with one exact reservation, none when it is empty, and records a failed reservation
    /// (SPEC 22.10.1). It has no failure test of its own: only the adapter `write` has that guard.
    internal func writeUtf8(self: uniq/Self, text: Text.Utf8Slice) -> Result<(), BufferFull>
        let bytes = text.bytes()
        if bytes.length == 0 => return .Ok(())
        var window = try self.reserve(bytes.length)
        try (window@uniq).append(bytes)
        (window@move).commitUtf8()
        return .Ok(())

    /// The adapter's reservation of `amount` bytes (SPEC 22.9.4, 22.10.1): `BufferFull` when a failure is recorded;
    /// else the destination's window for `amount` and the deferred literal, which it writes first, or a recorded
    /// `BufferFull`. Pending may sit on an adapter of any kind; the shared tail prepends it; only the kind-1 arm reads
    /// the hint, which a buffer that must grow adds unless the sum exceeds the maximum object size. The caller's
    /// obligation, which the signature cannot state: it commits or drops the window before the next reservation of
    /// this adapter, since the window's Origin is the destination's, not this borrow's.
    ///
    /// - abort: `amount` and the deferred literal exceed the maximum object size.
    internal func reserve(self: uniq/Self, amount: isize) -> Result<WriteWindow during target, BufferFull>
        if self.failed => return .Err(BufferFull.init())
        let largest: isize = 9223372036854775807
        // The adapter keeps `0 <= pendingLength`, which bounds the difference; the guard `amount <= available`
        // bounds the sum.
        let available = (largest@Wrapping<isize> - self.pendingLength@Wrapping<isize>)@isize
        if amount > available => Storage.allocationSizeExceeded()
        var minimum = (amount@Wrapping<isize> + self.pendingLength@Wrapping<isize>)@isize
        unsafe
            if self.kind == 0
                let fixed = self.destination@raw/(Text.FixedBuffer during target)
                return self.settled(((*fixed)@uniq).reserve(minimum))
            if self.kind == 1
                let heap = self.destination@raw/Text.HeapBuffer
                let length = (*heap).length
                // The buffer keeps `0 <= length <= capacity`, which bounds both differences.
                let unused = ((*heap).capacity@Wrapping<isize> - length@Wrapping<isize>)@isize
                let room = (largest@Wrapping<isize> - length@Wrapping<isize>)@isize
                if minimum > unused and minimum <= room
                    // The guard `unused < minimum <= room` bounds the difference, and `hint <= spare` the sum.
                    let spare = (room@Wrapping<isize> - minimum@Wrapping<isize>)@isize
                    if self.hint <= spare => minimum = (minimum@Wrapping<isize> + self.hint@Wrapping<isize>)@isize
                return self.settled(((*heap)@uniq).reserve(minimum))
        if self.kind == 2
            let reserved = Storage.erasedReserve(self, minimum)
            return self.settled(reserved@move)
        $abort("Utf8Writer: writer kind outside 0, 1 and 2")

    // Every kind's shared tail (SPEC 22.10.1): a failure recorded; else the deferred literal written first.
    func settled(self: uniq/Self, reserved: Result<WriteWindow during target, BufferFull>)
        -> Result<WriteWindow during target, BufferFull>
        match reserved@move
            .Ok(let window)
                var settled = window@move
                let pending = self.pendingLength
                if pending != 0
                    // Cannot fail: every kind reserved `amount + pendingLength`, so the deferred literal fits.
                    unsafe => try (settled@uniq).append(Raw.slice(self.pending, pending))
                    self.pendingLength = 0
                return .Ok(settled@move)
            .Err(_)
                self.failed = true
                return .Err(BufferFull.init())

public group Text
    public struct InvalidUtf8
        Self is Copy
        public init() => ()

    public struct FixedBuffer {source}
        Self is BufferWriter
        Self is not ObjectPayload
        let data: raw/u8 during source
        public let capacity: isize
        public var length: isize
            private set
        var validated: isize
        let loan: Loan<uniq/u8 during source>

        /// An empty buffer of capacity `capacity` over the bytes at `data`. The caller's obligations, which the
        /// signature cannot state: `data` addresses `capacity` initialized bytes in what `source` covers, with write
        /// authority (SPEC 5.2.1, 22.9.2).
        internal init(data: raw/u8 during source, capacity: isize)
            self.data = data
            self.capacity = capacity
            self.length = 0
            self.validated = 0
            self.loan = Loan<uniq/u8 during source>.init()

        /// The committed bytes.
        public func bytes(self: ref/Self) -> Slice<u8>
            unsafe => return Raw.slice(self.data, self.length)

        /// Validates the unvalidated suffix and views the committed bytes; records nothing (SPEC 22.9.3).
        public func text(self: ref/Self) -> Result<Text.Utf8Slice, Text.InvalidUtf8>
            unsafe
                if not Text.validSuffix(self.data, self.validated, self.length) => return .Err(Text.InvalidUtf8.init())
                return .Ok(Text.Utf8Slice.init(Raw.slice(self.data, self.length)))

        /// Records the committed bytes as validated, only on complete success (SPEC 22.9.3).
        public func validate(self: uniq/Self) -> Result<(), Text.InvalidUtf8>
            unsafe
                if not Text.validSuffix(self.data, self.validated, self.length) => return .Err(Text.InvalidUtf8.init())
            self.validated = self.length
            return .Ok(())

        /// Sets both lengths to zero and keeps the capacity (SPEC 22.9.3).
        public func clear(self: uniq/Self)
            self.length = 0
            self.validated = 0

        /// A window over the unused capacity, `BufferFull` exactly when it is below `minimum` (SPEC 22.9.4).
        ///
        /// - abort: `minimum` is negative.
        public func reserve(self: uniq/Self, minimum: isize) -> Result<WriteWindow, BufferFull>
            if minimum < 0 => Storage.argumentOutOfRange()
            // The buffer keeps `0 <= length <= capacity`, which bounds the difference.
            let remaining = (self.capacity@Wrapping<isize> - self.length@Wrapping<isize>)@isize
            if minimum > remaining => return .Err(BufferFull.init())
            return .Ok(WriteWindow.init(self@follow@raw@raw/u8, self.length, remaining))

        /// Validates the unvalidated suffix and views the committed bytes under the array's exclusive Loan (SPEC 22.9.3).
        public func intoText(self: owner/Self) -> Result<Text.Utf8Slice during self.source, Text.InvalidUtf8>
            unsafe
                if not Text.validSuffix(self.data, self.validated, self.length) => return .Err(Text.InvalidUtf8.init())
                return .Ok(Text.Utf8Slice.init(Raw.slice(self.data, self.length)))

    public struct HeapBuffer
        Self is BufferWriter
        var data: raw/u8 during self
        public var capacity: isize
            private set
        public var length: isize
            private set
        var validated: isize

        /// An empty buffer without an allocation (SPEC 22.9.2).
        internal init()
            self.data = null
            self.capacity = 0
            self.length = 0
            self.validated = 0

        drop
            unsafe => Raw.release(self.data)

        /// The committed bytes.
        public func bytes(self: ref/Self) -> Slice<u8>
            unsafe => return Raw.slice(self.data, self.length)

        /// Validates the unvalidated suffix and views the committed bytes; records nothing (SPEC 22.9.3).
        public func text(self: ref/Self) -> Result<Text.Utf8Slice, Text.InvalidUtf8>
            unsafe
                if not Text.validSuffix(self.data, self.validated, self.length) => return .Err(Text.InvalidUtf8.init())
                return .Ok(Text.Utf8Slice.init(Raw.slice(self.data, self.length)))

        /// Records the committed bytes as validated, only on complete success (SPEC 22.9.3).
        public func validate(self: uniq/Self) -> Result<(), Text.InvalidUtf8>
            unsafe
                if not Text.validSuffix(self.data, self.validated, self.length) => return .Err(Text.InvalidUtf8.init())
            self.validated = self.length
            return .Ok(())

        /// Sets both lengths to zero and keeps the capacity (SPEC 22.9.3).
        public func clear(self: uniq/Self)
            self.length = 0
            self.validated = 0

        /// A window over at least `minimum` unused bytes; never `BufferFull` (SPEC 22.9.4). Growth reaches
        /// `max(length + minimum, 2 * capacity)`, or `length + minimum` when the double exceeds the maximum object size, and
        /// copies the committed bytes.
        ///
        /// - abort: `minimum` is negative, or `length + minimum` exceeds the maximum object size.
        public func reserve(self: uniq/Self, minimum: isize) -> Result<WriteWindow, BufferFull>
            if minimum < 0 => Storage.argumentOutOfRange()
            let length = self.length
            let capacity = self.capacity
            // The buffer keeps `0 <= length <= capacity`, which bounds the differences, and the guards
            // `0 <= minimum <= room` the sum.
            if minimum > (capacity@Wrapping<isize> - length@Wrapping<isize>)@isize
                let largest: isize = 9223372036854775807
                let room = (largest@Wrapping<isize> - length@Wrapping<isize>)@isize
                if minimum > room => Storage.allocationSizeExceeded()
                var target = (length@Wrapping<isize> + minimum@Wrapping<isize>)@isize
                // `0 <= capacity <= largest / 2` bounds the product.
                if capacity <= largest / 2
                    let doubled = (capacity@Wrapping<isize> * 2@Wrapping<isize>)@isize
                    if doubled > target => target = doubled
                let memory = Raw.allocate<u8>(target)
                unsafe
                    if length != 0 => Storage.transferBytes(memory, self.data, length)
                    Raw.release(self.data)
                    // A claim: the new allocation is storage the buffer owns, as its old one was (SPEC 5.7).
                    self.data = memory@(raw/u8 during self)
                self.capacity = target
            let remaining = (self.capacity@Wrapping<isize> - length@Wrapping<isize>)@isize
            return .Ok(WriteWindow.init(self@follow@raw@raw/u8, length, remaining))

        /// Validates the unvalidated suffix and transfers the allocation to the string without copying; on failure it releases
        /// the allocation (SPEC 22.9.3). An allocated empty buffer keeps its pointer and the Heap release kind.
        public func intoString(self: owner/Self) -> Result<string, Text.InvalidUtf8>
            // Held so that the compiler does not destroy the buffer whose allocation this call releases or transfers (SPEC 5.2.3).
            var held = Storage.InlineStorage<Text.HeapBuffer>.init(self@move)
            let data = held.value.data
            let length = held.value.length
            let validated = held.value.validated
            unsafe
                if not Text.validSuffix(data, validated, length)
                    Raw.release(data)
                    return .Err(Text.InvalidUtf8.init())
            var kind: u8 = 0
            if data != null => kind = 1
            var text = Storage.InlineStorage<Storage.StringRepr>.init(Storage.StringRepr.init(data, length, kind))
            unsafe => return .Ok((*(text@raw@raw/string))@move)

    public struct Utf8Slice {source}
        Self is Copy
        Self is Utf8Format
        let value: Slice<u8> during source

        /// Views `value`, bytes the caller guarantees are valid UTF-8 (SPEC 22.9.3); nothing checks them.
        internal init(value: Slice<u8> during source) => self.value = value
        public computed length: isize
            get() -> isize => self.value.length
        public func bytes(self: Self) -> Slice<u8> during self.source
            return self.value

        /// Writes the view's bytes once through the writer's leaf (SPEC 22.10.2): one exact reservation, none when
        /// empty. Its catalog row's CallerLocation passes the user's location to the leaf (SPEC 22.5.1, until G1).
        public func format(self: ref/Self, writer: uniq/Utf8Writer) -> Result<(), BufferFull>
            return writer.writeUtf8(self@follow)

    /// A buffer over the initialized array: length zero, capacity `N` (SPEC 22.9.2).
    public func fixed<length N>(destination: uniq/[N of u8]) -> FixedBuffer
        return Text.FixedBuffer.init(destination@follow@raw@raw/u8, destination.length)

    /// A buffer of length zero and capacity `capacity`; zero allocates nothing (SPEC 22.9.2).
    ///
    /// - abort: `capacity` is negative, or the allocation fails.
    public func heap(capacity: isize) -> HeapBuffer
        if capacity < 0 => Storage.argumentOutOfRange()
        var buffer = Text.HeapBuffer.init()
        // An empty buffer grows to exactly `capacity` (SPEC 22.9.4), its one allocation.
        if capacity != 0 => _ = (buffer@uniq).reserve(capacity)
        return buffer@move

    /// Views the string's bytes, which are valid UTF-8 (SPEC 3.1.2, 22.9.2).
    public func utf8(text: ref/string) -> Utf8Slice
        let repr = text@follow@raw@raw/Storage.StringRepr
        unsafe => return Text.Utf8Slice.init(Raw.slice((*repr).data, (*repr).length))

    /// Formats `value` into a new string (SPEC 22.9.2): the owning interpolation of the one value (SPEC 22.10.3),
    /// whose adapter calls `format` once and whose buffer SPEC 22.10.5 bounds.
    ///
    /// - abort: the write returns `BufferFull` (`KIMI_E_FORMAT`), or the allocation fails.
    public func toString<T>(value: ref/T) -> string
        T is Utf8Format
        return "\(value)"

    /// Formats `value` once into the array, without a pre-pass or retry (SPEC 22.9.2); on `BufferFull` the array may
    /// hold partial bytes.
    ///
    /// - return: The formatted text, a view of the array that keeps `destination`'s exclusive loan while it is used.
    public func tryFormat<T, length N>(
        value: ref/T, destination: uniq/[N of u8]
    ) -> Result<Utf8Slice during destination, BufferFull>
        T is Utf8Format
        var buffer = Text.fixed(destination)
        var writer = Text.writer(buffer@uniq)
        try (writer@uniq).write(value)
        match (buffer@move).intoText()
            .Ok(let text) => return .Ok(text)
            // An adapter commits only valid UTF-8 and records it validated (SPEC 22.9.3), so nothing is left to scan.
            .Err(_) => $abort("Formatted bytes are not valid UTF-8")

    /// Validates `bytes` once and views them (SPEC 22.9.2, 22.9.3).
    public func validateUtf8(bytes: Slice<u8>) -> Result<Utf8Slice during bytes.source, InvalidUtf8>
        let repr = bytes@raw@raw/Storage.SliceRepr<u8>
        unsafe
            if not Text.validUtf8((*repr).data, bytes.length) => return .Err(Text.InvalidUtf8.init())
        return .Ok(Text.Utf8Slice.init(bytes))

    /// Whether a buffer's unvalidated suffix, the bytes from `validated` to `length` at `data`, is UTF-8
    /// (`validUtf8`). The buffer keeps `0 <= validated <= length`, which bounds the difference.
    ///
    /// - safety: `0 <= validated <= length`, and the `length` bytes at `data` lie within its provenance and are
    ///   readable.
    internal unsafe func validSuffix(data: raw/u8, validated: isize, length: isize) -> bool
        unsafe => return Text.validUtf8(data + validated, (length@Wrapping<isize> - validated@Wrapping<isize>)@isize)

    /// Whether the `length` bytes at `data` are exactly UTF-8 encodings of Unicode scalar values (SPEC 22.9.3): a
    /// truncated sequence, an overlong encoding, a surrogate or a value above U+10FFFF is not; NUL is ASCII. A bound
    /// precedes each read: the index steps by one only under `index < length`, and `rest` down only under `rest > 0`,
    /// so no step can overflow.
    ///
    /// - safety: `length >= 0`, and the `length` bytes at `data` lie within its provenance and are readable.
    internal unsafe func validUtf8(data: raw/u8, length: isize) -> bool
        unsafe
            var index: isize = 0
            while index < length
                let lead = *(data + index)
                index = (index@Wrapping<isize> + 1@Wrapping<isize>)@isize
                if lead >= 128
                    if lead < 194 or lead > 244 => return false
                    var rest: isize = 3
                    var mask: u8 = 7
                    var minimum: u32 = 65536
                    if lead < 240
                        rest = 2
                        mask = 15
                        minimum = 2048
                    if lead < 224
                        rest = 1
                        mask = 31
                        minimum = 128
                    var scalar = (lead & mask)@u32
                    while rest > 0
                        if index >= length => return false
                        let byte = *(data + index)
                        if (byte & 192) != 128 => return false
                        scalar = (scalar << 6) | (byte & 63)@u32
                        index = (index@Wrapping<isize> + 1@Wrapping<isize>)@isize
                        rest = (rest@Wrapping<isize> - 1@Wrapping<isize>)@isize
                    if scalar < minimum or scalar > 1114111 => return false
                    if scalar >= 55296 and scalar < 57344 => return false
            return true

// SPEC 22.7: the view overload of Console.writeLine; the string overload is a compiler function until W2.
public group Console
    /// Writes the view's bytes and one LF to standard output (SPEC 22.7).
    ///
    /// - abort: the host does not accept the bytes (`KIMI_E_STDOUT`); the output may be partial.
    public func writeLine(text: Text.Utf8Slice)
        let bytes = text.bytes()
        var feed: u8 = 10
        unsafe
            Console.writeStdout((*(bytes@raw@raw/Storage.SliceRepr<u8>)).data, bytes.length)
            Console.writeStdout(feed@raw, 1)

// SPEC 22.10.2, 22.1: the bodies of bool's, char's, Unit's, f32's, f64's, Wrapping<T>'s and the integers' built-in
// conformances to Utf8Format, which the witness table's BoolFormat, CharFormat, UnitFormat, F32Format, F64Format,
// WrappingFormat and IntegerFormat rows select (Binding.WitnessGroup); string's is StringWitness's (Core.kimi), the view's
// its own member (above).
// Each writes its text once through the writer's leaf, writeUtf8, or Wrapping<T>'s through a write of its integer; its
// catalog row's CallerLocation passes the user's location on (SPEC 22.5.1, until G1).
internal group BoolFormat
    func format(self: ref/bool, writer: uniq/Utf8Writer) -> Result<(), BufferFull>
        if self@follow => return writer.writeUtf8(Text.utf8("true"))
        return writer.writeUtf8(Text.utf8("false"))

internal group CharFormat
    /// Writes the scalar's UTF-8 encoding: one to four bytes, encoded into a local array.
    func format(self: ref/char, writer: uniq/Utf8Writer) -> Result<(), BufferFull>
        var scalar: u32 = 0
        unsafe
            // IMPL 21.1: a char is its scalar value's u32, read through a punned access (SPEC 5.2); a char holds a
            // Unicode scalar value (SPEC 3.1.2), so the bytes are valid UTF-8.
            scalar = *(self@follow@raw@raw/u32)
        var bytes: [4 of u8] = [0, 0, 0, 0]
        var count: isize = 4
        if scalar < 128
            bytes[0] = scalar@u8
            count = 1
        else if scalar < 2048
            bytes[0] = (192 | (scalar >> 6))@u8
            bytes[1] = (128 | (scalar & 63))@u8
            count = 2
        else if scalar < 65536
            bytes[0] = (224 | (scalar >> 12))@u8
            bytes[1] = (128 | ((scalar >> 6) & 63))@u8
            bytes[2] = (128 | (scalar & 63))@u8
            count = 3
        else
            bytes[0] = (240 | (scalar >> 18))@u8
            bytes[1] = (128 | ((scalar >> 12) & 63))@u8
            bytes[2] = (128 | ((scalar >> 6) & 63))@u8
            bytes[3] = (128 | (scalar & 63))@u8
        return writer.writeUtf8(Text.Utf8Slice.init(bytes.slice(..count)))

internal group UnitFormat
    func format(self: ref/(), writer: uniq/Utf8Writer) -> Result<(), BufferFull> => writer.writeUtf8(Text.utf8("()"))

internal group F32Format
    /// Writes the shortest round-trip text of the binary32 value, formatted from its IEEE 754 encoding (SPEC 13.5.4)
    /// into a local array.
    func format(self: ref/f32, writer: uniq/Utf8Writer) -> Result<(), BufferFull>
        var bytes = [24 of 0@u8]
        let count = Storage.formatFloat((self@follow@bits<u32>)@u64, narrow: true, destination: bytes@uniq)
        return writer.writeUtf8(Text.Utf8Slice.init(bytes.slice(..count)))

internal group F64Format
    /// Writes the shortest round-trip text of the binary64 value, formatted from its IEEE 754 encoding (SPEC 13.5.4)
    /// into a local array.
    func format(self: ref/f64, writer: uniq/Utf8Writer) -> Result<(), BufferFull>
        var bytes = [24 of 0@u8]
        let count = Storage.formatFloat(self@follow@bits<u64>, narrow: false, destination: bytes@uniq)
        return writer.writeUtf8(Text.Utf8Slice.init(bytes.slice(..count)))

internal group WrappingFormat
    /// Writes the wrapping integer as its argument (SPEC 3.1.1): its bits read as `I` (SPEC 13.5.4), written as that
    /// integer, as FromEnd writes its offset.
    func format<I>(self: ref/Wrapping<I>, writer: uniq/Utf8Writer) -> Result<(), BufferFull>
        I is PrimitiveInteger
        let value = self@follow@I
        return writer.write(value)

internal group IntegerFormat
    /// Writes the integer in ASCII decimal, `-` only before a negative value (SPEC 22.10.2): its digits produced into a
    /// local array from the end, then written once at their exact length (SPEC 22.10.5). The comparison and conversions
    /// on `I` are built-in operators (SPEC 8.7.4), no requirement calls, so the body's effects are the same at every
    /// instance. i128 and u128 run the specializations below, which this declaration's effects include (SPEC 15.6.4).
    func format<I>(self: ref/I, writer: uniq/Utf8Writer) -> Result<(), BufferFull>
        I is PrimitiveInteger
        let value = self@follow
        // A negative value of at most 64 bits has `-(value + 1) <= 2^63 - 1`, so its magnitude fits u64 without overflow.
        var magnitude: u64 = 0
        if value < 0
            magnitude = (-(value@i64 + 1))@u64 + 1
        else
            magnitude = value@u64
        // u64's maximum has 20 digits, i64's minimum 19 and its `-`.
        var digits = [20 of 0@u8]
        var index: isize = 20
        loop
            index -= 1
            digits[index] = (magnitude % 10)@u8 + 48
            magnitude /= 10
            if magnitude == 0 => exit
        if value < 0
            index -= 1
            digits[index] = 45
        // ASCII digits and `-` are valid UTF-8 (Utf8Slice.init's contract).
        return writer.writeUtf8(Text.Utf8Slice.init(digits.slice(index..)))

    // SPEC 22.10.2: a 128-bit value's digits come from Storage.formatInteger128 (interim by RQ16 (a): the backend
    // generates no 128-bit division, IMPL 21.3.3), its sign from the body; i128's minimum has 39 digits and its `-`.
    specialize func format<i128>(self: ref/i128, writer: uniq/Utf8Writer) -> Result<(), BufferFull>
        let value = self@follow
        // `-(value + 1)` fits i128 for every negative value, so the magnitude is computed without overflow.
        var magnitude: u128 = 0
        if value < 0
            magnitude = (-(value + 1))@u128 + 1
        else
            magnitude = value@u128
        var digits = [40 of 0@u8]
        var index = 40 - Storage.formatInteger128(magnitude, destination: digits@uniq)
        if value < 0
            index -= 1
            digits[index] = 45
        // ASCII digits and `-` are valid UTF-8 (Utf8Slice.init's contract).
        return writer.writeUtf8(Text.Utf8Slice.init(digits.slice(index..)))

    specialize func format<u128>(self: ref/u128, writer: uniq/Utf8Writer) -> Result<(), BufferFull>
        var digits = [40 of 0@u8]
        let index = 40 - Storage.formatInteger128(self@follow, destination: digits@uniq)
        return writer.writeUtf8(Text.Utf8Slice.init(digits.slice(index..)))
