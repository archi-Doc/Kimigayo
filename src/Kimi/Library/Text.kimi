// Compiler-implemented operations loaded into Kimi.Text.
public func writer<W>(destination: uniq/W) -> Utf8Writer
    W is BufferWriter
public func toString<T>(value: ref/T) -> string
    T is Utf8Format
public func tryFormat<T, length N>(value: ref/T, destination: uniq/[N of u8]) -> Result<Utf8Slice during destination, BufferFull>
    T is Utf8Format
