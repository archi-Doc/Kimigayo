// Private ordered-storage algorithms. Typed search/destruction are shared with ordinary collection operations;
// the compiler supplies placement and located primitives. This source owns capacity decisions and slot links.
group DictionaryStorage
    // Private physical records shared with the backend; not a public collection ABI.
    #Layout("C")
    internal struct Handle
        // The slot storage the Dictionary owns (SPEC 5.7): reads through a `raw/Handle` keep that pointer's Origin.
        public var buffer: raw/u8 during self
        public var used: isize
        public var capacity: isize
        public var length: isize
        public var head: isize
        public var tail: isize
        public var free: isize

    // Slot invariant (SPEC 5.2): a live slot holds its placed Links, key and value; a free slot below `used` holds only
    // its Links; the slots from `used` up to the capacity hold no value. Growth and compaction relocate whole slots;
    // a release needs no destruction of Links, which declare no `drop` and whose Fields are Copy (SPEC 5.6, 16.3.2).
    #Layout("C")
    struct Links
        public var previous: isize
        public var next: isize

        internal init(! previous: isize, next: isize)
            self.previous = previous
            self.next = next

    // The slot rule (IMPL 21.1.1; the slot is implementation storage, IMPL 21.1.3): the Links' 16 bytes at the slot's
    // start, the key at 16, the value at the key's end aligned for it, the stride the value's end aligned for the slot,
    // whose alignment is the largest of the Links' 8 and theirs. `slotStride`, `keyAt` and `valueAt` state it, the one
    // statement every body that addresses a slot reads. They read each Type's own stride and alignment and lay out no
    // aggregate of them, so a `K` or `V` over a generation limit is that limit's record (IMPL 21.3.2), and the slot's
    // size is no layout obligation of the program (SPEC 8.15.3). Premises: every alignment is a power of two at most 16
    // (IMPL 21.1.3), so 16 is aligned for every key, and every size is a multiple of its alignment.

    /// The slot stride: the Links, a `K` and a `V`, rounded up to the slot's alignment.
    internal func slotStride<K, V>() -> isize
        let key = alignmentOf<K>()
        let value = alignmentOf<V>()
        var alignment: isize = 8
        if key > alignment => alignment = key
        if value > alignment => alignment = value
        let end = 16 + Storage.stride<K>() + Storage.stride<V>()
        return (end + alignment - 1) / alignment * alignment

    // The alignment of `T`: the stride of a byte and no `T`, which this implementation aligns as `T` (IMPL 21.1.1). Its
    // one stored part is the byte, so its size stays within every limit; a `T` over a limit is that limit's record.
    func alignmentOf<T>() -> isize => Storage.stride<(u8, [0 of T])>()

    /// Returns the address of the key in the slot that starts at `slot`, with the provenance and authority of `slot`.
    ///
    /// - safety: `slot` starts a slot in the slot storage of a `Dictionary<K, V>`.
    internal unsafe func keyAt<K, V>(slot: raw/u8) -> raw/K => (slot + 16)@raw/K

    /// Returns the address of the value in the slot that starts at `slot`, with the provenance and authority of `slot`.
    ///
    /// - safety: `slot` starts a slot in the slot storage of a `Dictionary<K, V>`.
    internal unsafe func valueAt<K, V>(slot: raw/u8) -> raw/V
        let alignment = alignmentOf<V>()
        return (slot + (16 + Storage.stride<K>() + alignment - 1) / alignment * alignment)@raw/V

    /// Reads a Dictionary's `capacity` (SPEC 4.9.5).
    internal func capacity<K, V>(value: ref/Dictionary<K, V> during a) -> isize
        K is Equatable
        unsafe => return (*(value@follow@raw@raw/Handle)).capacity

    // The bodies below read a Dictionary's Handle through the path their borrow gives (SPEC 5.2.1): a Dictionary's one
    // component is its `Handle` (IMPL 21.1.3), so `value@follow@raw@raw/Handle` addresses it with that borrow's
    // authority.
    internal func clearEntries<K, V>(value: uniq/Dictionary<K, V>)
        K is Equatable
        unsafe
            let handle = value@follow@raw@raw/Handle
            let stride = slotStride<K, V>()
            let buffer = (*handle).buffer
            Storage.destroyDictionaryEntries<K, V>(buffer, stride, (*handle).tail, (*handle).length)
            // Free slots hold links too; all of them end before clearLinks lets appendSlot place links again. No step
            // of the loop can Abort, so it vanishes where ending a Links does nothing.
            var slot = buffer
            var remaining = (*handle).used
            while remaining > 0
                remaining -= 1
                _ = (*(slot@raw/Links))@move
                slot += stride
            clearLinks(handle)

    internal func removeEntry<K, V>(value: uniq/Dictionary<K, V>, key: ref/K) -> Option<(K, V)>
        K is Equatable
        // The search's shared Borrow ends before the exclusive handle is taken (SPEC 5.2.1).
        let link = findEntry(value@follow@ref, key)
        require link != 0 else => return .None
        unsafe
            let handle = value@follow@raw@raw/Handle
            let stride = slotStride<K, V>()
            let slot = (*handle).buffer + (link - 1) * stride
            unlink(handle, stride, link)
            return .Some(((*keyAt<K, V>(slot))@move, (*valueAt<K, V>(slot))@move))

    /// Replaces the value of the live entry at `link` and returns the old one, which is secured before the new one
    /// is placed.
    ///
    /// - safety: `link` is the link of a live entry of `value`.
    internal unsafe func replaceValue<K, V>(value: uniq/Dictionary<K, V>, link: isize, replacement: V) -> V
        K is Equatable
        unsafe
            let slot = (*(value@follow@raw@raw/Handle)).buffer + (link - 1) * slotStride<K, V>()
            let previous = (*valueAt<K, V>(slot))@move
            Raw.initialize(valueAt<K, V>(slot), replacement@move)
            return previous@move

    // The capacity operations carry the standard operation's caller location to each failure they detect (SPEC 22.5.1).
    internal func reserveEntries<K, V>(value: uniq/Dictionary<K, V>, additional: isize)
        K is Equatable
        unsafe
            _ = reserve(value@follow@raw@raw/Handle, slotStride<K, V>(), additional)

    internal func shrinkEntries<K, V>(value: uniq/Dictionary<K, V>)
        K is Equatable
        unsafe
            shrinkToFit(value@follow@raw@raw/Handle, slotStride<K, V>())

    unsafe func reserve(handle: raw/Handle, stride: isize, additional: isize) -> isize
        unsafe
            if additional < 0
                Storage.argumentOutOfRange()
            let maximumSize: isize = 9223372036854775807
            let length = (*handle).length
            if additional > maximumSize - length
                Storage.countOverflow()
            let minimum = length + additional
            grow(handle, stride, minimum)
            return minimum

    unsafe func grow(handle: raw/Handle, stride: isize, minimum: isize)
        unsafe
            let capacity = (*handle).capacity
            if capacity >= minimum
                return
            // Every entry has links, even when K and V have zero size: stride is positive.
            let maximumSize: isize = 9223372036854775807
            let maximum = maximumSize / stride
            if minimum > maximum
                Storage.allocationSizeExceeded()
            // Optional geometric rounding must never reject a representable minimum.
            var target = maximum
            if capacity <= maximum / 2
                target = capacity * 2
            if target < 4
                target = 4
            if target < minimum
                target = minimum
            if target > maximum
                target = maximum
            // The allocator aligns every block to 16 bytes (SPEC 21.4.3), which covers the entry layout.
            let memory = Raw.allocate<u8>(target * stride)
            let buffer = (*handle).buffer
            let used = (*handle).used
            if used != 0
                Storage.transferBytes(memory, buffer, used * stride)
            Raw.release(buffer)
            (*handle).buffer = memory
            (*handle).capacity = target

    unsafe func append(handle: raw/Handle, stride: isize) -> raw/u8
        unsafe
            let needed = reserve(handle, stride, 1)
            return appendSlot(handle, stride, needed)

    /// Appends one slot, growing the storage first, and places `key` and `value` in it (SPEC 5.2, 4.9.6); growth
    /// failure Aborts at the standard operation's caller location.
    ///
    /// - safety: `dictionary` stores no key equal to `key`, as the ordinary source decides.
    internal unsafe func placeEntry<K, V>(dictionary: uniq/Dictionary<K, V>, key: K, value: V)
        K is Equatable
        unsafe
            let slot = append(dictionary@follow@raw@raw/Handle, slotStride<K, V>())
            Raw.initialize(keyAt<K, V>(slot), key@move)
            Raw.initialize(valueAt<K, V>(slot), value@move)

    unsafe func shrinkToFit(handle: raw/Handle, stride: isize)
        unsafe
            let length = (*handle).length
            if (*handle).capacity <= length
                return
            if length == 0
                Raw.release((*handle).buffer)
                initialize(handle)
                return
            // Existing capacity guarantees that length * stride is representable; failure keeps the storage.
            let memory = Storage.tryAllocateBytes(length * stride)
            if memory == null
                return
            let old = compact(handle, memory, stride)
            Raw.release(old)

    // The caller allocates memory before calling; failure leaves the old handle
    // intact. Transfer does not acquire or destroy entries or call user code.
    unsafe func compact(handle: raw/Handle, memory: raw/u8, stride: isize) -> raw/u8
        unsafe
            let buffer = (*handle).buffer
            let length = (*handle).length
            var link = (*handle).head
            var position: isize = 0
            while link != 0
                let slot = buffer + (link - 1) * stride
                let next = (*(slot@raw/Links)).next
                let destination = memory + position * stride
                Storage.transferBytes(destination, slot, stride)
                let links = destination@raw/Links
                (*links).previous = position
                position += 1
                if position == length
                    (*links).next = 0
                else
                    (*links).next = position + 1
                link = next
            (*handle).buffer = memory
            (*handle).used = length
            (*handle).capacity = length
            if length == 0
                (*handle).head = 0
            else
                (*handle).head = 1
            (*handle).tail = length
            (*handle).free = 0
            return buffer

    internal func findEntry<K, V>(value: ref/Dictionary<K, V>, key: ref/K) -> isize
        K is Equatable
        var state = Storage.borrowStorage(value)
        return Storage.findDictionaryLink(state@uniq, key)

    // Links are slot index + 1; zero denotes no slot. The caller has already
    // secured capacity for needed entries before appendSlot changes any links.
    unsafe func appendSlot(handle: raw/Handle, stride: isize, needed: isize) -> raw/u8
        unsafe
            let buffer = (*handle).buffer
            let free = (*handle).free
            var index: isize = 0
            if free == 0
                index = (*handle).used
                (*handle).used = index + 1
            else
                index = free - 1
                let recycled = (buffer + index * stride)@raw/Links
                (*handle).free = (*recycled).next
            let link = index + 1
            let slot = buffer + index * stride
            let links = slot@raw/Links
            let tail = (*handle).tail
            // A fresh slot holds no value, so its links are placed; a free slot's links from unlink are replaced.
            let appended = Links.init(previous: tail, next: 0)
            if free == 0
                Raw.initialize(links, appended@move)
            else
                *links = appended@move
            if tail == 0
                (*handle).head = link
            else
                let previous = (buffer + (tail - 1) * stride)@raw/Links
                (*previous).next = link
            (*handle).tail = link
            (*handle).length = needed
            return slot

    unsafe func clearLinks(handle: raw/Handle)
        unsafe
            (*handle).used = 0
            (*handle).length = 0
            (*handle).head = 0
            (*handle).tail = 0
            (*handle).free = 0

    unsafe func initialize(handle: raw/Handle)
        unsafe
            (*handle).buffer = null
            (*handle).capacity = 0
            clearLinks(handle)

    unsafe func unlink(handle: raw/Handle, stride: isize, link: isize)
        unsafe
            let buffer = (*handle).buffer
            let slot = (buffer + (link - 1) * stride)@raw/Links
            let previous = (*slot).previous
            let next = (*slot).next
            if previous == 0
                (*handle).head = next
            else
                let left = (buffer + (previous - 1) * stride)@raw/Links
                (*left).next = next
            if next == 0
                (*handle).tail = previous
            else
                let right = (buffer + (next - 1) * stride)@raw/Links
                (*right).previous = previous
            (*slot).next = (*handle).free
            (*handle).free = link
            (*handle).length = (*handle).length - 1
