/// An exclusive view of completed contiguous elements. Moving or dropping the view never moves or destroys an element.
#Lang("UniqSlice")
public struct UniqSlice<T> {source}
    Self is UniqIndexable<isize>
    associate Element is T

    internal let storage: raw/T during source
    internal let count: isize
    internal let loan: Loan<uniq/T during source>

    /// The number of elements in the view.
    public computed length: isize
        get() -> isize => self.count
    public computed isEmpty: bool
        get() -> bool => self.count == 0
    public computed indices: ResolvedRange
        get() -> ResolvedRange => (0..self.count).resolve(self.count)

    /// Views the remainder's `count` elements from its `storage`, its first untaken element, so no element's offset is
    /// read (SPEC 8.15.3).
    internal init(state: Storage.UniqRemainder<T> during source)
        self.storage = state.storage
        self.count = state.count
        self.loan = state.loan@move

    /// Lends this view's elements for shared access, retaining the borrow of this handle.
    public func slice(self: ref/Self) -> Slice<T> during self
        unsafe => return Raw.slice(self.storage, self.count)

    #CallerLocation
    public func slice<R>(self: ref/Self, range: R) -> Slice<T> during self
        R is PositionRange
        return self.slice()[range]

    /// Reborrows this view exclusively; even an empty result retains its parent Loan.
    public func sliceUniq(self: uniq/Self) -> UniqSlice<T> during self
        return UniqSlice<T>.init(Storage.borrowStorageUniq(self))

    #CallerLocation
    public func sliceUniq<R>(self: uniq/Self, range: R) -> UniqSlice<T> during self
        R is PositionRange
        return Storage.sliceUniq(Storage.borrowStorageUniq(self), range)

    #CallerLocation
    public func index(self: ref/Self, key: ref/isize) -> ref/T during self
        require key >= 0 and key < self.count else => Storage.indexBounds()
        unsafe
            let element = self.storage[key]@ref
            return element

    #CallerLocation
    public func indexUniq(self: uniq/Self, key: ref/isize) -> uniq/T during self
        require key >= 0 and key < self.count else => Storage.indexBounds()
        unsafe
            let element = self.storage[key]@uniq
            return element@move

    // Subscripts normalize Position keys once through these internal receiver functions.
    #CallerLocation
    internal func indexPosition<P>(self: ref/Self, key: P) -> ref/T during self
        P is Position
        return self.index(PositionSyntax.resolved(key, self.count))

    #CallerLocation
    internal func indexPositionUniq<P>(self: uniq/Self, key: P) -> uniq/T during self
        P is Position
        return self.indexUniq(PositionSyntax.resolved(key, self.count))
