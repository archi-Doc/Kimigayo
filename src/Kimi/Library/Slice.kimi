public struct Slice<T> {source}
    Self is Iterable
    associate Iterable.IteratorType(handle) is SliceIterator<T> during source
    Self is UniqIterable
    associate UniqIterable.IteratorType(handle) is SliceIterator<T> during source
    Self is IntoIterable
    associate IntoIterable.IteratorType is SliceIterator<T> during source

    /// Starts an enumeration of the elements in index order. The iterator copies the handle, so its items keep
    /// `source` and not the borrow of the handle (SPEC 14.6.2).
    public func iterate(self: ref/Self during handle) -> SliceIterator<T> during source
        return SliceIterator<T>.init(self@follow)

    /// Starts the same shared enumeration: exclusive access to a Slice lends only its handle, and the elements stay
    /// shared (SPEC 4.6.7).
    public func iterateUniq(self: uniq/Self during handle) -> SliceIterator<T> during source
        return SliceIterator<T>.init(self@follow)

    /// Starts the same shared enumeration from a Slice value.
    public func intoIterator(self: Self) -> SliceIterator<T> during source
        return SliceIterator<T>.init(self)

    /// Returns a shared reference to the element `index` resolves to, or `None` when it resolves to no element.
    ///
    /// The result retains `source` and is a reference whatever T's Copy capability (SPEC 4.6.6). A position that
    /// resolves to the length is a boundary, not an element, and yields `None`. Only this operation's own bounds
    /// failure becomes `None`.
    public func tryGet<P>(self: Self, index: P) -> Option<ref/T during source>
        P is Position
        match index.tryResolve(self.length)
            .Some(let position)
                require position < self.length else => return .None
                return .Some(self[position]@ref/T)
            .None => return .None

    /// Returns the sub-Slice `range` selects, or `None` when `range` does not resolve against this Slice's length.
    public func trySlice<R>(self: Self, range: R) -> Option<Slice<T> during source>
        R is PositionRange
        match range.tryResolve(self.length)
            .Some(let resolved) => return .Some(self[resolved])
            .None => return .None

    /// Splits this Slice at the boundary `index` resolves to, `p`, into the views `[0, p)` and `[p, length)`.
    ///
    /// Both results retain `source`; neither copies an element.
    ///
    /// - abort: `index` does not resolve within `[0, self.length]`.
    public func splitAt<P>(self: Self, index: P) -> (Slice<T> during source, Slice<T> during source)
        P is Position
        let position = PositionSyntax.resolved(index, self.length)
        return (self[..position], self[position..])

    /// Splits this Slice at the boundary `index` resolves to, returning `None` when it does not resolve.
    public func trySplitAt<P>(self: Self, index: P) -> Option<(Slice<T> during source, Slice<T> during source)>
        P is Position
        match index.tryResolve(self.length)
            .Some(let position) => return .Some((self[..position], self[position..]))
            .None => return .None

    /// Returns whether some element equals `value`, visiting elements in increasing index order.
    public func contains(self: Self, value: ref/T) -> bool
        T is Equatable
        for element in self
            if element == value => return true
        return false

    /// Returns the first index whose element equals `value`, or `None` when no element does.
    public func firstIndex(self: Self, of => value: ref/T) -> Option<isize>
        T is Equatable
        for index in self.indices
            if self[index]@ref/T == value => return .Some(index)
        return .None

public struct SliceIterator<T> {source}
    Self is Iterator
    associate Iterator.Item is ref/T during source
    let values: Slice<T> during source
    var position: isize = 0
    public init(values: Slice<T> during source)
        self.values = values
    public func next(self: uniq/Self) -> Option<ref/T during source>
        require self.position < self.values.length else => return .None
        let index = self.position
        self.position = self.position + 1
        return .Some(self.values[index]@ref/T)
