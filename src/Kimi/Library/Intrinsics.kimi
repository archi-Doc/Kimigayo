/// Object creation, cloning and the whole-value updates (SPEC 13.6.2, 15.7). The compiler implements the operations
/// `IntrinsicOperations.kimi` declares. `replace`, `exchange` and `swap` take, destroy and place through raw Places of their
/// targets: each target is the complete, Initialized referent of a live exclusive borrow, readable and writable while its
/// Loan lives, and `swap`'s two targets are disjoint (SPEC 15.7.2), so every take and placement meets the raw access
/// conditions and the placement rule (SPEC 5.2, 5.2.1, 5.2.3). Callers are checked against SPEC 15.7, never these bodies.
public group Intrinsics
    /// Destroys the target's value in place, then moves `value` into it (SPEC 15.7.1). The destruction is `destroyValues`',
    /// which acts on the target's Place itself.
    public func replace<T>(target: uniq/T ! with => value: T) -> ()
        let place = target@follow@raw
        unsafe
            Storage.destroyValues<T>(place@raw/u8, 1)
            Raw.initialize(place, value@move)

    /// Moves `value` into the target and returns the old value (SPEC 15.7.1).
    public func exchange<T>(target: uniq/T ! with => value: T) -> T
        let place = target@follow@raw
        unsafe
            let old = (*place)@move
            Raw.initialize(place, value@move)
            return old@move

    /// Exchanges the two targets' values (SPEC 15.7.1).
    public func swap<T>(first: uniq/T, second: uniq/T) -> ()
        let one = first@follow@raw
        let other = second@follow@raw
        unsafe
            let held = (*one)@move
            Raw.initialize(one, (*other)@move)
            Raw.initialize(other, held@move)
