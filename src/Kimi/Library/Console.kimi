// Signatures implemented by the compiler; loaded into Kimi.Console.
public func writeLine(text: ref/string)
/// Writes the `length` bytes at `data` to standard output; Aborts with `KIMI_E_STDOUT` when the host does not accept
/// them (SPEC 22.7), and may leave partial output.
///
/// - safety: `length >= 0`, and the `length` bytes at `data` lie within its provenance and are readable.
internal unsafe func writeStdout(data: raw/u8, length: isize)
