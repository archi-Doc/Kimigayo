// Signatures implemented by the compiler; loaded into Kimi.Storage (SPEC 22.2). Their comments state their operation
// contracts (SPEC 5.2).
// Fails with the caller location carried by the standard operation's private ABI.
internal func missingDictionaryKey() -> Never
internal func indexBounds() -> Never
internal func argumentOutOfRange() -> Never
internal func countOverflow() -> Never
internal func allocationSizeExceeded() -> Never
// The nullable form of Alloc (SPEC 21.4.3): null wherever Alloc would Abort. A nonnull result is the start of an
// unreleased allocation of `bytes` bytes that holds no value; that allocation is its provenance, and it is readable and
// writable (SPEC 5.2.1). `Raw.release` accepts it as the start of an `allocate` result, never as a zero-byte result
// even when `bytes` is 0, so it is released at most once.
internal func tryAllocateBytes(bytes: isize) -> raw/u8
/// Copies `count` bytes from `source` into the storage at `destination` and runs no user code; it may relocate the
/// values in the source range (SPEC 5.2), whatever the initialization state of the bytes.
///
/// - safety: `count >= 0`, the two ranges do not overlap and each lies within its pointer's provenance, `source` is
///   readable and `destination` writable for its range.
internal unsafe func transferBytes(destination: raw/u8, source: raw/u8, count: isize)
/// Destroys the `count` values of `T` at `storage` from the last to the first, leaving their Places holding no value.
/// For a `T` whose destruction runs no code it is nothing, so it costs nothing at any optimization level (SPEC 4.9.8).
/// `storage` states no `T`, so a `T` as deep as storage allows stays within it.
///
/// - safety: `count >= 0`, and each of the `count` strided elements from `storage` is a distinct Place holding a
///   complete value of `T`.
internal unsafe func destroyValues<T>(storage: raw/u8, count: isize)
/// A user Writer's reservation through the adapter's dispatch word (the ErasedReserve intrinsic): its
/// `reserve(minimum)`, then `BufferFull` for a window with `written != 0` or `remaining < minimum`, which it drops
/// (SPEC 22.9.4). It records nothing and reads no writer kind. The caller's obligation, which the signature cannot
/// state: `writer` is a user Writer's adapter, and its caller commits or drops the window before the next reservation.
internal func erasedReserve(writer: uniq/Utf8Writer, minimum: isize) -> Result<WriteWindow during writer.target, BufferFull>
/// The code of `W`'s `reserve` implementation (the ReserveDispatch intrinsic): the word a user Writer's adapter holds
/// as its `dispatch`, which `erasedReserve` calls through. Nothing reads or writes through it, and it is no function
/// value, which is a pair of words (IMPL 21.1.3).
internal func reserveDispatch<W>() -> raw/u8 during static
    W is BufferWriter
/// Writes the shortest round-trip text of a float (the FormatFloat intrinsic; SPEC 22.10.2) at the start of
/// `destination` and returns its length: fixed notation for `-4 <= e < 16`, else scientific; `NaN`, `Infinity`,
/// `-Infinity`, `0` and `-0`. `bits` is an f64's IEEE 754 encoding, or with `narrow` an f32's in its low 32 bits, of
/// which only those are read. It writes exactly the returned 1 to 24 bytes (at most 17 with `narrow`) and no other
/// byte; the text is ASCII, so valid UTF-8. It allocates nothing and never Aborts.
internal func formatFloat(bits: u64 ! narrow: bool, destination: uniq/[24 of u8]) -> isize
/// Writes the ASCII decimal digits of `value` (the FormatInteger128 intrinsic; SPEC 22.10.2) at the end of
/// `destination` and returns their count, 1 to 39: no sign, no leading zero, `0` for zero. It writes exactly
/// those bytes and no other; the text is ASCII, so valid UTF-8. It allocates nothing and never Aborts. Interim by
/// RQ16 (a): the backend generates no 128-bit division (IMPL 21.3.3).
internal func formatInteger128(value: u128 ! destination: uniq/[40 of u8]) -> isize
/// Returns the stride of `T` (IMPL 21.1.3), the byte distance between adjacent elements.
internal func stride<T>() -> isize
