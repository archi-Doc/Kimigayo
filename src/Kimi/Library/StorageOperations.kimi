// Signatures implemented by the compiler; loaded into Kimi.Storage (SPEC 22.2). Their comments state their operation
// contracts (SPEC 5.2).
// Fails with the caller location carried by the standard operation's private ABI.
internal func missingDictionaryKey() -> Never
internal func indexBounds() -> Never
internal func argumentOutOfRange() -> Never
internal func countOverflow() -> Never
internal func allocationSizeExceeded() -> Never
// The nullable form of Alloc (SPEC 21.4.3): null wherever Alloc would Abort. A nonnull result is the start of an
// unreleased allocation of `bytes` bytes that holds no value; that allocation is its provenance, and it is readable and
// writable (SPEC 5.2.1). `Raw.release` accepts it as the start of an `allocate` result, never as a zero-byte result
// even when `bytes` is 0, so it is released at most once.
internal func tryAllocateBytes(bytes: isize) -> raw/u8
/// Copies `count` bytes from `source` into the storage at `destination` and runs no user code; it may relocate the
/// values in the source range (SPEC 5.2), whatever the initialization state of the bytes.
///
/// - safety: `count >= 0`, the two ranges do not overlap and each lies within its pointer's provenance, `source` is
///   readable and `destination` writable for its range.
internal unsafe func transferBytes(destination: raw/u8, source: raw/u8, count: isize)
/// Destroys the `count` values of `T` at `storage` from the last to the first, leaving their Places holding no value.
/// For a `T` whose destruction runs no code it is nothing, so it costs nothing at any optimization level (SPEC 4.9.8).
/// `storage` states no `T`, so a `T` as deep as storage allows stays within it.
///
/// - safety: `count >= 0`, and each of the `count` strided elements from `storage` is a distinct Place holding a
///   complete value of `T`.
internal unsafe func destroyValues<T>(storage: raw/u8, count: isize)
/// Returns the stride of `T` (IMPL 21.1.3), the byte distance between adjacent elements.
internal func stride<T>() -> isize
