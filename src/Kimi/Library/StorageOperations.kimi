// Signatures implemented by the compiler; loaded into Kimi.Storage (SPEC 22.2). Their comments state their operation
// contracts (SPEC 5.2).
// For a Dictionary, the remainder's `storage` is the value of the Handle's `buffer` (see dictionaryStorage), `stride`
// is the slot stride, and `link` and `count` are the first live link and the live count. ownStorage also gives the
// last live link as `tail` and transfers the storage, the entries and their destruction responsibility.
internal func borrowStorage<K, V>(value: ref/Dictionary<K, V> during a) -> DictionaryRefRemainder<K, V> during a
    K is Equatable
internal func borrowStorageUniq<K, V>(value: uniq/Dictionary<K, V> during a) -> DictionaryUniqRemainder<K, V> during a
    K is Equatable
internal func ownStorage<K, V>(value: Dictionary<K, V>) -> DictionaryOwnedRemainder<K, V>
    K is Equatable
/// Returns the address of the key in the slot that starts at `slot`, with the provenance and authority of `slot`.
///
/// - safety: `slot` starts a slot in the slot storage of a `Dictionary<K, V>`.
internal unsafe func keyAt<K, V>(slot: raw/u8) -> raw/K
/// Returns the address of the value in the slot that starts at `slot`, with the provenance and authority of `slot`.
///
/// - safety: `slot` starts a slot in the slot storage of a `Dictionary<K, V>`.
internal unsafe func valueAt<K, V>(slot: raw/u8) -> raw/V
/// Returns the address of the Dictionary that `value` borrows, with the provenance, authority and excepted Loan
/// (SPEC 5.2.1 conditions 1, 3 and 4) that `@raw` of the argument's referent has in the caller, and the slot stride;
/// no entry is acquired.
///
/// A Dictionary's one inline component is a `DictionaryStorage.Handle` Place at its address, Initialized from the start
/// of its construction until its destruction, so the Handle's Fields, `buffer` included, are ordinary Places. They hold
/// no valid value (SPEC 5.2.1 condition 2) until the construction calls `DictionaryStorage.initialize`, which writes
/// them through a pointer with the provenance and authority that `@raw` gives for the Dictionary under construction.
///
/// - safety: Writes through the result keep the Handle consistent with its slot storage and the slot invariant that
///   DictionaryStorage.Links states.
internal unsafe func dictionaryStorage<K, V>(value: uniq/Dictionary<K, V>) -> (raw/Dictionary<K, V> during value, isize)
    K is Equatable
// Fails with the caller location carried by the standard operation's private ABI.
internal func missingDictionaryKey() -> Never
internal func indexBounds() -> Never
internal func argumentOutOfRange() -> Never
internal func countOverflow() -> Never
internal func allocationSizeExceeded() -> Never
// The nullable form of Alloc (SPEC 21.4.3): null wherever Alloc would Abort. A nonnull result is the start of an
// unreleased allocation of `bytes` bytes that holds no value; that allocation is its provenance, and it is readable and
// writable (SPEC 5.2.1). `Raw.release` accepts it as the start of an `allocate` result, never as a zero-byte result
// even when `bytes` is 0, so it is released at most once.
internal func tryAllocateBytes(bytes: isize) -> raw/u8
/// Copies `count` bytes from `source` into the raw storage at `destination` and runs no user code; it may relocate the
/// values in the source range (SPEC 5.2), whatever the initialization state of the bytes.
///
/// - safety: `count >= 0`, the two ranges do not overlap and each lies within its pointer's provenance, `source` is
///   readable and `destination` writable for its range.
internal unsafe func transferBytes(destination: raw/u8, source: raw/u8, count: isize)
/// Destroys the `count` values of `T` at `storage` from the last to the first, leaving their Places holding no value.
/// For a `T` whose destruction runs no code it is nothing, so it costs nothing at any optimization level (SPEC 4.9.8).
/// `storage` states no `T`, so a `T` as deep as storage allows stays within it.
///
/// - safety: `count >= 0`, and each of the `count` strided elements from `storage` is a distinct Place holding a
///   complete value of `T`.
internal unsafe func destroyValues<T>(storage: raw/u8, count: isize)
/// Returns the stride of `T` (IMPL 21.1.3), the byte distance between adjacent elements.
internal func stride<T>() -> isize
/// Appends one slot, growing the storage first, and places `key` and `value` in it (SPEC 5.2); growth failure Aborts at
/// the standard operation's caller location.
///
/// - safety: `handle` is the address that `dictionaryStorage<K, V>` returned, and the Dictionary stores no key equal to
///   `key`, as the ordinary source decides.
internal unsafe func placeEntry<K, V>(handle: raw/Dictionary<K, V>, key: K, value: V)
    K is Equatable
